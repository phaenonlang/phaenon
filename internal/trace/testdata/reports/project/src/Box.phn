namespace App;

final class Box
{
    /** @var list<int> */
    private array $log = [];

    __construct(private int $n) {}

    get(): int => $this->n;

    record(int $x): void => $this->log[] = $x;

    label(string $paddingCharacters): string => $this->n |> abs(...) |> strval(...) |> str_pad(?, 40, $paddingCharacters, STR_PAD_LEFT) |> strtoupper(...) |> trim(...) |> ucfirst(...) |> htmlspecialchars(...);

    refuse(): never => throw new \LogicException('refused');

    unused(): int {
        if ($this->n > 0) {
            return 1;
        }
        return 0;
    }
}
