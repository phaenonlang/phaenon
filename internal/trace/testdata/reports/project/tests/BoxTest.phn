namespace App\Tests;

use App\Box;
use PHPUnit\Framework\TestCase;

final class BoxTest extends TestCase
{
    testGet(): void
    {
        self::assertSame(3, new Box(3)->get());
    }

    testRecordAndLabel(): void
    {
        $box = new Box(-7);
        $box->record(1);
        self::assertSame('7', ltrim(new Box(-7)->label('-'), '-'));
    }

    testPlain(): void
    {
        self::assertSame(4, new \App\Plain()->twice(2));
    }

    testRefuses(): void
    {
        new Box(1)->refuse();
    }

    testLabelFails(): void
    {
        self::assertSame('wrong', new Box(2)->label('*'));
    }
}
