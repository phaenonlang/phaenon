// A side-effecting call to a method of the class's own hierarchy — on $this,
// or static: self::, static::, parent::, the class's name — forgets what was
// narrowed about $this and the class's static members, as PHPStan does; a call
// to another class, a method returning a value, and a private property of a
// class other than the called method's keep it.
namespace App;

final class Other
{
    public static function touch(): void
    {
    }
}

class Base
{
    protected static ?string $shared = null;

    public function __construct()
    {
    }

    public static function reset(): void
    {
    }
}

final class Registry extends Base
{
    private static ?string $name = null;

    public ?string $label = null;

    public function __construct()
    {
        $this->label = 'a';
        parent::__construct();
        echo \strlen($this->label); // want P2103
    }

    public static function afterOwnStatic(): string
    {
        self::$name = 'a';
        self::flush();
        return self::$name; // want P2202
    }

    public static function inLoop(): void
    {
        self::$name = 'a';
        foreach ([1, 2] as $_) {
            echo \strlen(self::$name); // want P2103
            self::flush();
        }
    }

    public static function afterOtherClass(): string
    {
        self::$name = 'a';
        Other::touch();
        return self::$name;
    }

    public static function afterValueMethod(): string
    {
        self::$name = 'a';
        $n = self::count();
        return self::$name;
    }

    public static function spelledByName(): string
    {
        Registry::$name = 'a';
        static::flush();
        return Registry::$name; // want P2202
    }

    public static function parentCallKeepsPrivate(): string
    {
        self::$name = 'a';
        parent::reset();
        return self::$name;
    }

    public static function parentCallDropsInherited(): string
    {
        self::$shared = 'a';
        parent::reset();
        return self::$shared; // want P2202
    }

    public function afterOwnInstance(): string
    {
        self::$name = 'a';
        $this->touchOwn();
        return self::$name; // want P2202
    }

    public function propertyAfterStatic(): string
    {
        $this->label = 'a';
        self::flush();
        return $this->label; // want P2202
    }

    public function touchOwn(): void
    {
    }

    public static function flush(): void
    {
    }

    public static function count(): int
    {
        return 1;
    }
}

// An object given to a function or a method that returns void, is tagged
// @phpstan-impure, or that PHPStan lists with side effects
// (get_object_vars()), may come back changed: what was narrowed or written
// of its properties, and of the paths under them, is forgotten, as PHPStan
// forgets it. The object's own type stays, and a readonly property keeps
// what was known of it. A callee that returns a value, a constructor, a
// closure held in a variable and an object inside an array forget nothing.
// `$this` given forgets its members and the class's static ones.
final class Ticket
{
    public ?string $ref = null;
    public string $state = '';
    public ?Ticket $parent = null;

    public function __construct(public readonly ?string $code = null)
    {
    }
}

final class TicketBox
{
    public function __construct(public Ticket $t)
    {
    }
}

function logTicket(object $t): void
{
}

function describeTicket(Ticket $t): string
{
    return '';
}

/** @phpstan-impure */
function closeTicket(Ticket $t): bool
{
    $t->state = 'closed';
    return true;
}

/** @param list<object> $ts */
function logTickets(array $ts): void
{
}

function takesRef(string $ref): void
{
}

function forgotten(Ticket $t): void
{
    if ($t->ref !== null) {
        logTicket($t);
        takesRef($t->ref); // want P2103 "string|null given"
    }
    if ($t->ref !== null) {
        closeTicket($t);
        takesRef($t->ref); // want P2103 "string|null given"
    }
}

function written(Ticket $t): int
{
    $t->state = 'open';
    logTicket($t);
    if ($t->state === 'closed') {
        return 1;
    }
    return 0;
}

function kept(Ticket $t, \Closure $f): void
{
    if ($t->ref !== null) {
        $v = describeTicket($t);
        $box = new TicketBox($t);
        $f($t);
        logTickets([$t]);
        takesRef($t->ref);
        echo $v, \count([$box]);
    }
}

// PHPStan reads the tag as @phpstan-impure and as @impure, not in Psalm's
// spelling: a callee tagged @psalm-impure forgets nothing.
/** @psalm-impure */
function psalmSaysImpure(Ticket $t): bool
{
    return $t->ref === null;
}

/** @impure */
function plainlyImpure(Ticket $t): bool
{
    $t->state = 'open';
    return true;
}

function spellings(Ticket $t): void
{
    if ($t->ref !== null) {
        $a = psalmSaysImpure($t);
        takesRef($t->ref);
        $b = plainlyImpure($t);
        takesRef($t->ref); // want P2103 "string|null given"
        echo $a, $b;
    }
}

function nested(Ticket $t): void
{
    if ($t->parent !== null && $t->parent->ref !== null && $t->ref !== null) {
        logTicket($t->parent);
        takesRef($t->ref);
        takesRef($t->parent->ref); // want P2103 "string|null given"
    }
}

function readonlyKept(Ticket $t): void
{
    if ($t->code !== null) {
        logTicket($t);
        takesRef($t->code);
    }
}

final class Desk
{
    public ?string $last = null;

    public function serve(): void
    {
        if ($this->last !== null) {
            logTicket($this);
            takesRef($this->last); // want P2103 "string|null given"
        }
    }
}

// The result of a call with side effects is not remembered: a method
// tagged @phpstan-impure, or one of PHP's own that PHPStan lists with side
// effects, may give another value each time, and what a test learnt of
// one call says nothing of the next, as PHPStan has it. An untagged
// method's result is remembered, and so is a call made with ?->, which
// PHPStan narrows through its plain twin.
final class Lexer
{
    private int $at = 0;

    /** @phpstan-impure */
    public function next(): int|string
    {
        $this->at++;
        return $this->at % 2 === 0 ? $this->at : 'word';
    }

    public function peek(): int|string
    {
        return $this->at % 2 === 0 ? $this->at : 'word';
    }
}

function takesNumber(int $i): void
{
}

function impureResults(Lexer $lexer, Lexer $other): string
{
    if (is_int($lexer->next())) {
        takesNumber($lexer->next()); // want P2103 "int|string given"
    }
    $token = $lexer->next();
    if (is_int($token)) {
        return 'number';
    }
    if (is_int($lexer->peek())) {
        takesNumber($lexer->peek());
    }
    if (!is_string($other->next())) {
        return 'number';
    }
    takesRef($other->next()); // want P2103 "int|string given"
    return $token;
}

function fileChars(\SplFileObject $file): void
{
    if (is_string($file->fgetc())) {
        takesRef($file->fgetc()); // want P2103 "false|string given"
    }
}

// A method without a docblock reads the one it inherits, its interface's
// @phpstan-impure included. On a union, the side effects are certain only
// where every class's method has them: one pure method of a member makes
// them possible, and PHPStan remembers the result, as the checker does.
interface Feed
{
    /** @phpstan-impure */
    public function next(): int|string;
}

final class ListFeed implements Feed
{
    private int $at = 0;

    public function next(): int|string
    {
        $this->at++;
        return $this->at % 2 === 0 ? $this->at : 'word';
    }
}

final class FixedFeed
{
    private int $at = 0;

    public function next(): int|string
    {
        return $this->at % 2 === 0 ? $this->at : 'word';
    }
}

function inheritedImpure(ListFeed $feed): void
{
    if (is_int($feed->next())) {
        takesNumber($feed->next()); // want P2103 "int|string given"
    }
}

function impureOnOneMember(ListFeed|FixedFeed $feed): void
{
    if (is_int($feed->next())) {
        takesNumber($feed->next());
    }
}

// A docblock of the method's own that says nothing of purity, a
// {@inheritDoc} or a @return alone, leaves it to the method it implements
// or overrides; a @phpstan-pure of its own decides.
final class DocumentedFeed implements Feed
{
    private int $at = 0;

    /** {@inheritDoc} */
    public function next(): int|string
    {
        $this->at++;
        return $this->at % 2 === 0 ? $this->at : 'word';
    }
}

class ImpureSource
{
    /** @phpstan-impure */
    public function take(): int|string
    {
        return 1;
    }
}

final class ReturnDocSource extends ImpureSource
{
    private int $taken = 0;

    /** @return int|string the next item */
    public function take(): int|string
    {
        $this->taken++;
        return $this->taken % 2 === 0 ? $this->taken : 'word';
    }
}

final class PureSource extends ImpureSource
{
    /** @phpstan-pure */
    public function take(): int|string
    {
        return 'word';
    }
}

function inheritDocImpure(DocumentedFeed $feed): void
{
    if (is_int($feed->next())) {
        takesNumber($feed->next()); // want P2103 "int|string given"
    }
}

function returnDocImpure(ReturnDocSource $source): void
{
    if (is_int($source->take())) {
        takesNumber($source->take()); // want P2103 "int|string given"
    }
}

function ownPure(PureSource $source): void
{
    if (is_int($source->take())) {
        takesNumber($source->take());
    }
}

// The docblock merged with is one declaration's, the parent's where it has
// one and else the first interface's: where that says nothing of purity,
// an impure method further on is not reached, and the result is
// remembered.
interface ImpureTake
{
    /** @phpstan-impure */
    public function take(): int|string;
}

interface PlainTake
{
    /** @return int|string the next item */
    public function take(): int|string;
}

abstract class DocumentedTake
{
    /** @return int|string the next item */
    abstract public function take(): int|string;
}

final class MergedWithParent extends DocumentedTake implements ImpureTake
{
    public function take(): int|string
    {
        return 'word';
    }
}

final class MergedWithFirstInterface implements PlainTake, ImpureTake
{
    public function take(): int|string
    {
        return 'word';
    }
}

function mergedWithParent(MergedWithParent $source): void
{
    if (is_int($source->take())) {
        takesNumber($source->take());
    }
}

function mergedWithFirstInterface(MergedWithFirstInterface $source): void
{
    if (is_int($source->take())) {
        takesNumber($source->take());
    }
}
