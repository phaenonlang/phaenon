namespace Shp;

// A shape gets syntax with a name: `array{…}` in the right-hand side of a
// `type` declaration (design/collections.md §6). The type is the
// lattice's shape, the one a docblock's shape and an array literal are,
// with the rules a docblock shape has.

final class Customer
{
    public string $name = '';
}

type Row = array{id: int, name?: string};
type Order = array{id: int, lines: list<array{sku: string, qty: int}>, buyer: ?Customer};
type Page<T> = array{items: list<T>, total: int, next?: string};
type Open = array{id: int, ...};
type Keys = array{class: string, 'a-b': int, '$set'?: bool, 0: int, -1: string, '7': float};
type None = array{};

function row(Row $row): string
{
    $id = $row['id'] + 1;
    // An optional key may be absent: reading it is a read of what may not
    // be there, as with a docblock's shape.
    $name = $row['name'] ?? 'nobody';
    return $name . $id;
}

function build(int $id): Row
{
    return ['id' => $id];
}

function named(int $id): Row
{
    return ['id' => $id, 'name' => 'a'];
}

function wrongValue(): Row
{
    return ['id' => 'one']; // want P2202
}

function missingKey(): Row
{
    return ['name' => 'a']; // want P2202
}

// A literal with a key the shape does not name is accepted where the shape
// is expected, as it is for a docblock's shape (design/checker.md §10
// keeps the stricter rule an open question).
function excess(): Row
{
    return ['id' => 1, 'age' => 30];
}

// `name?: string` and `name: ?string` differ: an absent key against a
// present null.
type Nullable = array{name: ?string};

function absent(): Nullable
{
    return []; // want P2202
}

function present(): Nullable
{
    return ['name' => null];
}

// A sealed shape names its keys: another one does not exist. An unsealed
// one admits keys it does not name, which read as mixed.
function sealed(Row $row): mixed
{
    return $row['age']; // want P2313
}

function unsealed(Open $open): mixed
{
    return $open['age'];
}

function nested(Order $order): int
{
    $qty = 0;
    foreach ($order['lines'] as $line) {
        $qty += $line['qty'];
    }
    return $qty + ($order['buyer'] === null ? 0 : strlen($order['buyer']->name));
}

function page(Page<Row> $page): int
{
    $first = $page['items'][0]['id'] ?? 0;
    return $first + $page['total'];
}

function generic<T>(Page<T> $page): ?T
{
    return $page['items'][0] ?? null;
}

// The keys are the docblock grammar's: a name, reserved words included, a
// quoted string for what is no name, an integer. A quoted decimal integer
// is that integer's key.
function keys(Keys $k): string
{
    $n = $k['a-b'] + $k[0] + (int) $k[7];
    return $k['class'] . $k[-1] . $n;
}

function none(): None
{
    return [];
}

// An alias names a type and makes no new one: the shape a docblock spells
// is the same type, and two aliases with one right-hand side are
// interchangeable.
type Line = array{id: int, name?: string};

/**
 * @param array{id: int, name?: string} $row
 */
function structural(array $row, Line $line): Row
{
    return $row['id'] > 0 ? $row : $line;
}

/**
 * A docblock's shape may hold a named one.
 *
 * @return array{total: int, rows: list<Row>}
 */
function totals(Row $row): array
{
    return ['total' => 1, 'rows' => [$row]];
}

// A key is written once, in whichever spelling.
type Twice = array{id: int, id: string}; // want P2511 "shape key id is written twice"
type Quoted = array{id: int, 'id'?: int}; // want P2511
type Numbered = array{1: int, '1': int}; // want P2511 "'1' is written twice"

// Only a string PHP itself stores as an integer key is one: '7' is the key
// 7, while '07', '-0' and '+1' stay strings, in the syntax and in a
// docblock's shape alike, as PHPStan reads them.
type Padded = array{1: int, '01': string, 0: int, '-0': string, '+1': string};

/**
 * @param array{'01': string, '7': int} $doc
 */
function padded(Padded $p, array $doc): string
{
    $n = $p[1] + $p[0] + $doc[7];
    $s = $p['01'] . $p['-0'] . $p['+1'] . $doc['01'];
    return $s . $n . $doc[1]; // want P2313
}

// The types of the entries are judged as any type is.
type Lost = array{who: Missing}; // want P2001
type Wide = array{ids: list<int, int>}; // want P3001

// A shape is a type and no class, like the alias that names it.
function value(): object
{
    return new Row(); // want P2001 "Row is a type alias"
}

function takesInt(int $n): void {}

function takesText(string $s): void {}

function takesRow(Row $row): void {}

function takesPair((int, string) $pair): void {}

// A shape unpacked into an array literal keeps its entries: PHP numbers
// the integer keys anew and keeps the string ones, a later key replacing
// an earlier one, and an entry that may be absent leaves what was there.
// shapes-held.phn has the cases of this file that are about what a shape
// accepts in the docblock spelling, which the parity run holds to PHPStan.
type Named = array{id: int, name: string};
type NameAsInt = array{name?: int};

function unpacked((int, string) $pair, Named $named, Row $row, NameAsInt $wrong, list<int> $ints): void
{
    takesPair([...$pair]);
    takesPair([1, ...['a']]);
    takesPair(['a', ...$pair]); // want P2103
    takesInt([...$pair, 2][2]);
    takesText([...$pair, 2][1]);
    takesText([...$pair, 2][0]); // want P2103
    takesRow([...$named]);
    takesRow([...$row]);
    takesRow([...$row, 'name' => 'a']);
    takesRow([...$named, 'id' => 'x']); // want P2103
    takesRow(['id' => 'x', ...$named]);
    takesRow(['id' => 1, 'name' => 'a', ...$wrong]); // want P2103
    takesRow(['id' => 1, ...$wrong]); // want P2103
    // A general array unpacks into a general array.
    takesPair([...$ints]); // want P2103
}

// A general array is no shape that requires a key: the array might not
// have it. It passes where every entry its keys can reach is optional and
// takes its values, the one case where it may well be the shape.
type A = array{a: int};
type OptionalA = array{a?: int};
type OptionalAB = array{a?: int, b?: string};
type OpenOptionalA = array{a?: int, ...};
type First = array{0: int};

function takesA(A $a): void {}

function takesOptionalA(OptionalA $a): void {}

function takesOptionalAB(OptionalAB $ab): void {}

function takesOpenOptionalA(OpenOptionalA $open): void {}

function takesOpen(Open $open): void {}

function takesNone(None $none): void {}

function takesFirst(First $first): void {}

function takesRows(list<A> $rows): void {}

/**
 * @param non-empty-array<string, int> $some
 * @param non-empty-list<int> $someList
 */
function general(
    map<string, mixed> $bag,
    map<string, int> $ints,
    map<string, string> $strings,
    map<int, int> $byNumber,
    map<string, int|string> $mixed,
    map<string, int> $some,
    list<int> $list,
    list<int> $someList,
    list<int|string> $pairs,
    array<mixed> $anything,
    list<map<string, int>> $rows,
    A|map<string, int> $either,
): A {
    takesRow($bag); // want P2103
    takesA($ints); // want P2103
    takesA($strings); // want P2103
    takesA($byNumber); // want P2103
    takesA($some); // want P2103
    takesA($anything); // want P2103
    takesA($either); // want P2103
    takesOpen($ints); // want P2103
    // Every entry optional: the array may be the shape, and its values fit.
    takesOptionalA($ints);
    takesOpenOptionalA($ints);
    takesOptionalA($byNumber);
    takesOptionalA($strings); // want P2103
    takesOptionalA($mixed); // want P2103
    takesOptionalA($bag); // want P2103
    takesOpenOptionalA($bag); // want P2103
    takesOptionalAB($ints); // want P2103
    takesNone($ints);
    takesOptionalA([]);
    takesRow([]); // want P2103
    // A list that is not empty has its first offset, and no other.
    takesFirst($list); // want P2103
    takesFirst($someList);
    takesPair($pairs); // want P2103
    takesRows($rows); // want P2103
    takesRows([['a' => 1]]);

    return $ints; // want P2202
}

final class GeneralHolder
{
    public A $a = ['a' => 0];

    set(map<string, int> $ints): void
    {
        $this->a = ['a' => 1];
        $this->a = $ints; // want P2201
    }
}

// An unsealed shape may hold, under a key it does not name, a value of any
// type: it is no shape that gives that key a type, and it has no key for
// certain but the ones it names.
type OpenNamed = array{id: int, name: string, ...};
type OpenRow = array{id: int, name?: string, ...};
type OpenWrongName = array{id: int, name?: int, ...};
type OpenA = array{a: int, ...};
type OpenB = array{b: int, ...};
type AB = array{a: int, b?: int};
type LooseRow = array{id: int, name?: mixed};
type Sealed = array{id: int};
type More = array{id: int, age: int};

function takesAB(AB $ab): void {}

function takesLooseRow(LooseRow $row): void {}

function takesOpenRow(OpenRow $open): void {}

function takesNumbers(iterable<string, int> $numbers): void {}

function takesNumberMap(map<string, int> $numbers): void {}

function opened(
    Open $open,
    OpenNamed $named,
    OpenRow $optional,
    OpenWrongName $wrongName,
    OpenA $a,
    OpenB $b,
    Sealed $sealed,
    More $more,
): Row {
    takesRow($open); // want P2103
    // Named, the key has its type; the keys beyond the shape's are passed
    // over, as a sealed shape's are.
    takesRow($named);
    takesRow($optional);
    takesRow($wrongName); // want P2103
    takesA($open); // want P2103
    takesA($a);
    takesOptionalA($a);
    takesOptionalA($b); // want P2103
    takesAB($a); // want P2103
    takesLooseRow($open);
    // An unsealed shape takes what it does not name.
    takesOpen($open);
    takesOpen($named);
    takesOpen($sealed);
    takesOpen($more);
    takesOpen($a); // want P2103
    takesOpenOptionalA($a);
    takesOpenOptionalA($b); // want P2103
    takesOpenRow($open); // want P2103
    takesOpenRow($optional);
    takesOpenRow($sealed);
    takesOpenRow($more);
    takesOpenRow($wrongName); // want P2103
    // Against an iterable what the shape does not name is iterated too;
    // against an array PHPStan compares the named entries alone.
    takesNumbers($a); // want P2103
    takesNumbers(['a' => 1]);
    takesNumberMap($a);

    return $open; // want P2202
}

final class OpenHolder
{
    public Row $row = ['id' => 0];

    set(Open $open, OpenNamed $named): void
    {
        $this->row = $named;
        $this->row = $open; // want P2201
    }
}
