// deprecations: on
namespace IgnoreComments;
// A phaenon-ignore comment naming codes (P2103, P2202, a reason in
// parentheses) silences those codes on its line, or on the next one when it
// stands alone, and no other code; one that silences nothing it names is
// P4015, as PHPStan reports its own (ignore.unmatchedIdentifier). The -line
// and -next-line forms silence every finding, and are P4015 where there is
// none (ignore.unmatchedLine). A phpstan-ignore comment silences every
// finding of its line, its identifiers not compared, and is never reported.

function wantsInt(int $i): void {}

function silenced(): void {
    wantsInt('a'); // @phaenon-ignore P2103
    // @phaenon-ignore P2103 (a reason in parentheses)
    wantsInt('b');
    /** @phaenon-ignore P2103 */
    wantsInt('c');
    wantsInt('d'); // @phaenon-ignore P2202, P2103 // want P4015 "no P2202 is reported on line 19"
    wantsInt('e'); // @phaenon-ignore-line
    // @phaenon-ignore-next-line
    wantsInt('f');
    wantsInt('g'); // @phpstan-ignore argument.type
    wantsInt('h'); // @phpstan-ignore return.type
}

function unmatched(): void {
    wantsInt('i'); // @phaenon-ignore P2202 // want P2103, P4015 "no P2202 is reported on line 28"
    wantsInt(1); // @phaenon-ignore P2103 // want P4015 "no P2103 is reported on line 29"
    wantsInt('j'); // @phaenon-ignore P2103, P2202 // want P4015 "no P2202"
    wantsInt(2); // @phaenon-ignore-line // want P4015 "@phaenon-ignore-line: no finding a comment silences is reported on line 31"
    // @phaenon-ignore-next-line // want P4015 "no finding a comment silences is reported on line 33"
    wantsInt(3);
    wantsInt('k'); // @phaenon-ignore // want P2103, P4015 "names no code, and silences nothing: name the codes it is for, here `@phaenon-ignore P2103`"
    wantsInt('l'); // @phaenon-ignore argument.type // want P2103, P4015 "names no code"
    wantsInt('m'); // @phaenon-ignore P2103 because the fixture says so
    wantsInt('n'); // @phaenon-ignore P2202, argument.type // want P2103, P4015 "no P2202 is reported on line 37"
}

/**
 * Says how to write `@phaenon-ignore P2103` in prose, which is no tag.
 */
function prose(): void {
    wantsInt(5);
    wantsInt(4); // @phpstan-ignore argument.type
}

function covered(): void {
    // @phaenon-ignore-next-line
    wantsInt('o'); // @phaenon-ignore P2103
    // @phaenon-ignore P2103
    wantsInt('p'); // @phaenon-ignore P2103
    wantsInt('q'); // @phaenon-ignore P2103: the fixture says so
    wantsInt('r'); // @phaenon-ignore P2103.
    wantsInt('s'); /* @phaenon-ignore P2103; */
}

// A code that punctuation ends is the code, whatever the punctuation. P4015
// is silenced by no comment, or naming it would hide a stale suppression:
// a comment that names it is told so, and held to its other codes as ever.
// The line a comment covers is the one the finding is reported on: an
// argument's, in a call written over several lines, not the line the call
// starts on.
function named(): void {
    wantsInt('t'); // @phaenon-ignore P2103!
    wantsInt(6); /* @phaenon-ignore P2103 */ // @phaenon-ignore P4015 // want P4015 "no P2103 is reported", P4015 "no comment silences P4015, or one that silences nothing could hide itself: remove the comment"
    wantsInt(7); // @phaenon-ignore P2103, P4015 // want P4015 "no P2103 is reported", P4015 "remove the comment"
    wantsInt('w'); // @phaenon-ignore P2103, P4015 // want P4015 "take P4015 out of the comment"
    wantsInt(8); // @phaenon-ignore-line P4015 // want P4015 "no finding a comment silences is reported"
    wantsInt(
        'u' // @phaenon-ignore P2103
    );
    // @phaenon-ignore P2103 // want P4015 "no P2103 is reported on line 74"
    wantsInt(
        'v' // want P2103
    );
}

// With the deprecations reported, a comment is held to their codes as to
// any other.
function deprecations(): string {
    $a = \DATE_RFC7231; // @phaenon-ignore P4006
    $b = 'x'; // @phaenon-ignore P4006 // want P4015 "no P4006 is reported"
    return $a . $b;
}

// A code of the run, about the project file, composer.json, the vendor
// directory or the local php, is no finding of a line: phn prints it on
// the file it is about or, where it has none, on the first line of the
// first file checked, beside whatever that line holds, and no comment
// silences it. A comment that names one is told so, and held to its other
// codes as ever. A comment that silences every finding of its line
// silences neither these nor P4015, and where nothing else is reported on
// its line, it silences nothing.
function ofTheRun(): void {
    wantsInt('x'); // @phaenon-ignore P2103, P4005 // want P4015 "P4005 is no finding of a line, and no comment silences it: take P4005 out of the comment"
    wantsInt(9); // @phaenon-ignore P4007, P4008, P4009, P4010, P4012, P4016 // want P4015 "P4007 is no finding", P4015 "P4008 is no finding", P4015 "P4009 is no finding", P4015 "P4010 is no finding", P4015 "P4012 is no finding", P4015 "P4016 is no finding"
    /* @phaenon-ignore P2103 */ wantsInt(10); // @phaenon-ignore-line // want P4015 "no P2103 is reported on line 98", P4015 "no finding a comment silences is reported on line 98"
}

// The advice P4015 gives is one that, followed, leaves no P4015: a comment
// whose codes no comment silences, or silence nothing, is to be removed,
// and so is one that names no code where nothing is reported; one that
// names no code where findings are is to name theirs.
function advice(): void {
    wantsInt(11); // @phaenon-ignore P4005 // want P4015 "P4005 is no finding of a line, and no comment silences it: remove the comment"
    wantsInt(12); // @phaenon-ignore P4005, P2103 // want P4015 "P4005 is no finding of a line, and no comment silences it: remove the comment", P4015 "no P2103 is reported"
    wantsInt(13); // @phaenon-ignore // want P4015 "names no code, and silences nothing: no finding a comment silences is reported on line 108, so remove it"
    wantsInt('y'); /* @phaenon-ignore P2202 */ // @phaenon-ignore // want P2103, P4015 "no P2202 is reported", P4015 "name the codes it is for, here `@phaenon-ignore P2103`"
}

// Phaenon's syntax (P1000–P1007) is no finding a comment accepts: what
// Phaenon removed or forbids, and what the target cannot run, is reported
// whatever comment stands on its line. A comment that names such a code
// is told so; one that silences every finding of its line silences the
// others there, and where there are none, it silences nothing. PHP's
// deprecations (P1101) are silenced as any finding is.
function syntax(string $s): void {
    $a = (integer) $s; // @phpstan-ignore cast.int // want P1001
    $b = (integer) $s; // @phaenon-ignore-line // want P1001, P4015 "no finding a comment silences is reported on line 120"
    $c = (integer) $s; // @phaenon-ignore P1001 // want P1001, P4015 "P1001 says the code is not Phaenon as written, and no comment silences it: remove the comment"
    wantsInt((integer) $s . 'z'); // @phaenon-ignore P1001, P2103 // want P1001, P4015 "P1001 says the code is not Phaenon as written, and no comment silences it: take P1001 out of the comment"
    wantsInt((integer) $s . 'z'); // @phaenon-ignore // want P1001, P2103, P4015 "names no code, and silences nothing: name the codes it is for, here `@phaenon-ignore P2103`"
    // @phaenon-ignore-next-line
    wantsInt((integer) $s . 'w'); // want P1001
}

// Code PHP refuses, when it compiles the file or when it declares and
// links its classes, is no finding a comment accepts either: the compiled
// file would not load. Such a finding is reported whatever comment stands
// on its line. A comment that names its code there is told so, where it
// silences no other finding of that code; one that silences every finding
// of its line silences the others, and where there are none, it silences
// nothing. A finding of the same code about code PHP runs is silenced as
// before: a void a docblock alone declares, a docblock's return type, a
// default a docblock's type refuses and PHP's does not.
function returnsUnderVoid(): void
{
    return 1; // @phpstan-ignore return.void // want P2204
}

function returnsUnderVoidNamed(): void
{
    return 2; // @phaenon-ignore P2204 // want P2204, P4015 "P2204 on line 144 is about code PHP refuses to compile or load, and no comment silences it: remove the comment"
}

function returnsUnderVoidLine(): void
{
    return 3; // @phaenon-ignore-line // want P2204, P4015 "no finding a comment silences is reported on line 149"
}

function returnsUnderVoidNext(): void
{
    // @phaenon-ignore-next-line // want P4015 "no finding a comment silences is reported on line 155"
    return 4; // want P2204
}

function returnsUnderVoidMixed(): void
{
    return wantsInt('a'); // @phaenon-ignore P2204, P2103 // want P2204, P4015 "take P2204 out of the comment"
}

function returnsUnderVoidUnnamed(): void
{
    return wantsInt('b'); // @phaenon-ignore // want P2204, P2103, P4015 "names no code, and silences nothing: name the codes it is for, here `@phaenon-ignore P2103`"
}

/**
 * @return void
 */
function returnsUnderDocblockVoid()
{
    return 5; // @phaenon-ignore P2204
}

class Sized
{
    public function size(): int
    {
        return 0;
    }

    /**
     * @return list<int>
     */
    public function items(): array
    {
        return [];
    }
}

final class Hidden extends Sized
{
    protected function size(): int // @phpstan-ignore method.visibility // want P2502
    {
        return 1;
    }
}

final class HiddenNamed extends Sized
{
    protected function size(): int // @phaenon-ignore P2502 // want P2502, P4015 "is about code PHP refuses"
    {
        return 2;
    }
}

// An anonymous class is linked when its `new` runs: what PHP refuses there
// fails that code alone, and a comment silences it.
function hiddenLater(): Sized
{
    return new class extends Sized {
        protected function size(): int // @phpstan-ignore method.visibility
        {
            return 3;
        }
    };
}

final class Documented extends Sized
{
    /**
     * @return list<string>
     */
    public function items(): array // @phaenon-ignore P2502
    {
        return [];
    }
}

final class Defaults
{
    public int $count = 'x'; // @phpstan-ignore property.defaultValue // want P2201

    /**
     * @var positive-int
     */
    public int $positive = 0; // @phaenon-ignore P2201
}

#[\NoDiscard] // @phpstan-ignore attribute.target // want P2533
final class Kept
{
}

// The same of the other codes PHP refuses in some places and runs in
// others: `parent` in a method of a class without one, and in a closure,
// which PHP binds when it creates it; `self` in a function, and in a
// closure there; a parameter's default PHP's type refuses, and one a
// docblock's alone does; `$this` written anew, and passed by reference; a
// yield in top-level code or in a hook whose type admits no Generator, and
// in a hook whose type does, a method to PHP that the yield makes a
// generator; a set hook's parameter, and what a get hook returns.
function fills(mixed &$out): void
{
}

final class Orphan
{
    public function up(): string
    {
        return parent::class; // @phpstan-ignore class.noParent // want P2011
    }

    public function later(): \Closure
    {
        return fn (): string => parent::class; // @phpstan-ignore class.noParent
    }
}

function selfless(): string
{
    return self::class; // @phpstan-ignore outOfClass.self // want P2012
}

function selflessLater(): \Closure
{
    return fn (): string => self::class; // @phpstan-ignore outOfClass.self
}

function defaults(int $n = 'x'): int // @phpstan-ignore parameter.defaultValue // want P2208
{
    return $n;
}

/**
 * @param positive-int $n
 */
function positive(int $n = 0): int // @phpstan-ignore parameter.defaultValue
{
    return $n;
}

final class Rebinds
{
    public function again(): void
    {
        $this = new self(); // @phpstan-ignore assign.this // want P2311
    }

    public function passes(): void
    {
        fills($this); // @phpstan-ignore assign.this
    }
}

final class Yields
{
    public \Generator $values {
        get { // want P2203
            yield 1; // @phpstan-ignore generator.outside
        }
    }
}

final class YieldsAnInt
{
    public int $count {
        get { // want P2203
            yield 1; // @phpstan-ignore generator.outside // want P2315
        }
    }
}

final class Hooked
{
    public int $count = 0 {
        set(string $value) { // @phpstan-ignore propertySetHook.parameterType // want P2512
            $this->count = (int) $value;
        }
    }

    public int $total {
        get => 'x'; // @phpstan-ignore return.type
    }
}

readonly class Frozen
{
    public static int $shared; // @phpstan-ignore property.readOnlyStatic // want P2513
}

class Twice
{
}

class Twice // @phpstan-ignore class.duplicate // want P2511
{
}

enum Suit
{
    case Hearts;
    case Hearts; // @phaenon-ignore P2511 // want P2511, P4015 "is about code PHP refuses"
}

// An erased type parameter used as a value compiles to PHP that does
// something else than it reads, and no comment silences it either. A
// comment that names P3003 where none is reported is told only that.
function made<T>(): mixed
{
    return new T(); // @phaenon-ignore P3003 // want P3003, P4015 "P3003 on line 362 is about code that compiles to PHP doing something else than it reads, and no comment silences it: remove the comment"
}

function noneMade(): void
{
    wantsInt(14); // @phaenon-ignore P3003 // want P4015 "no P3003 is reported on line 367"
}

// So does an override whose native type does not fit the one it
// overrides: the compiled method takes the type that fits (the
// override-erasure rule), another than the body was checked with.
// `(): iterable` compiles to `(): array`, which refuses the generator the
// body is; `(string $x)` to `(int|string $x)`, which hands the body an
// int; `(): float` under `Ranged<int>` to `(): int|string`, which no float
// leaves. No comment silences such a finding, static or not, in a class
// declared when its code runs as in one linked on load. One about a type
// that compiles as written is a comment's to accept: a docblock's, or a
// native type the erased declaration admits though its type argument does
// not.
interface Ranged<T of int|string>
{
    get(): T;
}

interface Held<T>
{
    get(): T;

    set(T $v): void;
}

class Listed
{
    /**
     * @return list<int>
     */
    all(): array
    {
        return [];
    }

    one(int $x): int
    {
        return $x;
    }

    static make(int $x): int
    {
        return $x;
    }
}

final class Floats implements Ranged<int>
{
    get(): float // @phaenon-ignore P2502 // want P2502, P4015 "P2502 on line 416 is about code that compiles to PHP doing something else than it reads, and no comment silences it: remove the comment"
    {
        return 1.5;
    }
}

class Generated extends Listed
{
    /**
     * @return iterable<int>
     */
    all(): iterable // @phaenon-ignore P2502 // want P2502, P4015 "something else than it reads"
    {
        yield 1;
    }

    // @phaenon-ignore-next-line // want P4015 "no finding a comment silences is reported on line 433"
    one(string $x): string // want P2502, P2502
    {
        return $x;
    }

    static make(string $x): int // @phpstan-ignore method.childParameterType // want P2502
    {
        return 1;
    }
}

final class HeldApart implements Held<int>
{
    get(): string // @phaenon-ignore P2502
    {
        return 'a';
    }

    set(string $v): void // @phaenon-ignore P2502 // want P2502, P4015 "something else than it reads"
    {
    }
}

final class ListedStrings extends Listed
{
    /**
     * @return list<string>
     */
    all(): array // @phaenon-ignore P2502
    {
        return [];
    }
}

if (PHP_VERSION_ID > 80000) {
    class GeneratedLate extends Listed
    {
        one(string $x): int // @phaenon-ignore P2502 // want P2502, P4015 "something else than it reads"
        {
            return 1;
        }
    }
}

// static in a constant expression is refused when PHP compiles the file,
// in every place the checker reports it.
class Late
{
    public const ONE = 1;
    public const SAME = static::ONE; // @phaenon-ignore P2532 // want P2532, P4015 "is about code PHP refuses"
}

// Top-level code, after every declaration: a statement before a class
// may end the file's run before PHP declares the class.
$yielded = yield 1; // @phpstan-ignore generator.outside // want P2315
