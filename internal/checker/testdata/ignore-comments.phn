// deprecations: on
namespace IgnoreComments;
// A phaenon-ignore comment naming codes (P2103, P2202, a reason in
// parentheses) silences those codes on its line, or on the next one when it
// stands alone, and no other code; one that silences nothing it names is
// P4015, as PHPStan reports its own (ignore.unmatchedIdentifier). The -line
// and -next-line forms silence every finding, and are P4015 where there is
// none (ignore.unmatchedLine). A phpstan-ignore comment silences every
// finding of its line, its identifiers not compared, and is never reported.

function wantsInt(int $i): void {}

function silenced(): void {
    wantsInt('a'); // @phaenon-ignore P2103
    // @phaenon-ignore P2103 (a reason in parentheses)
    wantsInt('b');
    /** @phaenon-ignore P2103 */
    wantsInt('c');
    wantsInt('d'); // @phaenon-ignore P2202, P2103 // want P4015 "no P2202 is reported on line 19"
    wantsInt('e'); // @phaenon-ignore-line
    // @phaenon-ignore-next-line
    wantsInt('f');
    wantsInt('g'); // @phpstan-ignore argument.type
    wantsInt('h'); // @phpstan-ignore return.type
}

function unmatched(): void {
    wantsInt('i'); // @phaenon-ignore P2202 // want P2103, P4015 "no P2202 is reported on line 28"
    wantsInt(1); // @phaenon-ignore P2103 // want P4015 "no P2103 is reported on line 29"
    wantsInt('j'); // @phaenon-ignore P2103, P2202 // want P4015 "no P2202"
    wantsInt(2); // @phaenon-ignore-line // want P4015 "@phaenon-ignore-line: no finding a comment silences is reported on line 31"
    // @phaenon-ignore-next-line // want P4015 "no finding a comment silences is reported on line 33"
    wantsInt(3);
    wantsInt('k'); // @phaenon-ignore // want P2103, P4015 "names no code, and silences nothing: name the codes it is for, here `@phaenon-ignore P2103`"
    wantsInt('l'); // @phaenon-ignore argument.type // want P2103, P4015 "names no code"
    wantsInt('m'); // @phaenon-ignore P2103 because the fixture says so
    wantsInt('n'); // @phaenon-ignore P2202, argument.type // want P2103, P4015 "no P2202 is reported on line 37"
}

/**
 * Says how to write `@phaenon-ignore P2103` in prose, which is no tag.
 */
function prose(): void {
    wantsInt(5);
    wantsInt(4); // @phpstan-ignore argument.type
}

function covered(): void {
    // @phaenon-ignore-next-line
    wantsInt('o'); // @phaenon-ignore P2103
    // @phaenon-ignore P2103
    wantsInt('p'); // @phaenon-ignore P2103
    wantsInt('q'); // @phaenon-ignore P2103: the fixture says so
    wantsInt('r'); // @phaenon-ignore P2103.
    wantsInt('s'); /* @phaenon-ignore P2103; */
}

// A code that punctuation ends is the code, whatever the punctuation. P4015
// is silenced by no comment, or naming it would hide a stale suppression:
// a comment that names it is told so, and held to its other codes as ever.
// The line a comment covers is the one the finding is reported on: an
// argument's, in a call written over several lines, not the line the call
// starts on.
function named(): void {
    wantsInt('t'); // @phaenon-ignore P2103!
    wantsInt(6); /* @phaenon-ignore P2103 */ // @phaenon-ignore P4015 // want P4015 "no P2103 is reported", P4015 "no comment silences P4015, or one that silences nothing could hide itself: remove the comment"
    wantsInt(7); // @phaenon-ignore P2103, P4015 // want P4015 "no P2103 is reported", P4015 "remove the comment"
    wantsInt('w'); // @phaenon-ignore P2103, P4015 // want P4015 "take P4015 out of the comment"
    wantsInt(8); // @phaenon-ignore-line P4015 // want P4015 "no finding a comment silences is reported"
    wantsInt(
        'u' // @phaenon-ignore P2103
    );
    // @phaenon-ignore P2103 // want P4015 "no P2103 is reported on line 74"
    wantsInt(
        'v' // want P2103
    );
}

// With the deprecations reported, a comment is held to their codes as to
// any other.
function deprecations(): string {
    $a = \DATE_RFC7231; // @phaenon-ignore P4006
    $b = 'x'; // @phaenon-ignore P4006 // want P4015 "no P4006 is reported"
    return $a . $b;
}

// A code of the run, about the project file, composer.json, the vendor
// directory or the local php, is no finding of a line: phn prints it on
// the file it is about or, where it has none, on the first line of the
// first file checked, beside whatever that line holds, and no comment
// silences it. A comment that names one is told so, and held to its other
// codes as ever. A comment that silences every finding of its line
// silences neither these nor P4015, and where nothing else is reported on
// its line, it silences nothing.
function ofTheRun(): void {
    wantsInt('x'); // @phaenon-ignore P2103, P4005 // want P4015 "P4005 is no finding of a line, and no comment silences it: take P4005 out of the comment"
    wantsInt(9); // @phaenon-ignore P4007, P4008, P4009, P4010, P4012, P4016 // want P4015 "P4007 is no finding", P4015 "P4008 is no finding", P4015 "P4009 is no finding", P4015 "P4010 is no finding", P4015 "P4012 is no finding", P4015 "P4016 is no finding"
    /* @phaenon-ignore P2103 */ wantsInt(10); // @phaenon-ignore-line // want P4015 "no P2103 is reported on line 98", P4015 "no finding a comment silences is reported on line 98"
}

// The advice P4015 gives is one that, followed, leaves no P4015: a comment
// whose codes no comment silences, or silence nothing, is to be removed,
// and so is one that names no code where nothing is reported; one that
// names no code where findings are is to name theirs.
function advice(): void {
    wantsInt(11); // @phaenon-ignore P4005 // want P4015 "P4005 is no finding of a line, and no comment silences it: remove the comment"
    wantsInt(12); // @phaenon-ignore P4005, P2103 // want P4015 "P4005 is no finding of a line, and no comment silences it: remove the comment", P4015 "no P2103 is reported"
    wantsInt(13); // @phaenon-ignore // want P4015 "names no code, and silences nothing: no finding a comment silences is reported on line 108, so remove it"
    wantsInt('y'); /* @phaenon-ignore P2202 */ // @phaenon-ignore // want P2103, P4015 "no P2202 is reported", P4015 "name the codes it is for, here `@phaenon-ignore P2103`"
}

// Phaenon's syntax (P1000–P1007) is no finding a comment accepts: what
// Phaenon removed or forbids, and what the target cannot run, is reported
// whatever comment stands on its line. A comment that names such a code
// is told so; one that silences every finding of its line silences the
// others there, and where there are none, it silences nothing. PHP's
// deprecations (P1101) are silenced as any finding is.
function syntax(string $s): void {
    $a = (integer) $s; // @phpstan-ignore cast.int // want P1001
    $b = (integer) $s; // @phaenon-ignore-line // want P1001, P4015 "no finding a comment silences is reported on line 120"
    $c = (integer) $s; // @phaenon-ignore P1001 // want P1001, P4015 "P1001 says the code is not Phaenon as written, and no comment silences it: remove the comment"
    wantsInt((integer) $s . 'z'); // @phaenon-ignore P1001, P2103 // want P1001, P4015 "P1001 says the code is not Phaenon as written, and no comment silences it: take P1001 out of the comment"
    wantsInt((integer) $s . 'z'); // @phaenon-ignore // want P1001, P2103, P4015 "names no code, and silences nothing: name the codes it is for, here `@phaenon-ignore P2103`"
    // @phaenon-ignore-next-line
    wantsInt((integer) $s . 'w'); // want P1001
}
