// golden: target=8.6
// The uses of library-target85.phn compiled for PHP 8.6: nothing to report.
namespace App\Library;

use Io\Poll\Handle;
use Time\Duration;

function functions(int $n): int
{
    $limited = clamp($n, 1, 10);
    echo \gettype($limited);
    $callable = clamp(...);
    echo \gettype($callable);
    return max(1, min(10, $n));
}

function classes(): void
{
    echo \gettype(Duration::fromSeconds(5));
    echo \gettype(\SortDirection::Ascending);
}

function namesOnly(object $value): bool
{
    echo Duration::class;
    try {
        echo \get_class($value);
    } catch (\Time\TimeException $e) {
        echo $e->getMessage();
    }
    return $value instanceof Duration;
}

function declaredType(Duration $length): void
{
}

final class Watched implements Handle
{
    public function getFileDescriptor(): int
    {
        return 0;
    }
}

function methodsAndConstants(\ReflectionProperty $property, \SplFileObject $file): void
{
    echo $property->isReadable(null) ? 'r' : '-';
    echo $property->isPublic() ? 'p' : '-';
    echo ARRAY_FILTER_USE_VALUE;
    echo ARRAY_FILTER_USE_KEY;
    echo \Spoofchecker::LTR;
    echo \Spoofchecker::SINGLE_SCRIPT;
    echo $file->getFilename();
}

function parameters(\OpenSSLAsymmetricKey $key): void
{
    $signature = '';
    openssl_sign('data', $signature, $key);
    openssl_sign('data', $signature, $key, OPENSSL_ALGO_SHA256, salt_length: 32);
    openssl_sign('data', $signature, $key, OPENSSL_ALGO_SHA256, 1, 32);
}
