namespace OffsetCount;

// An offset of a list that a test of count() proves there, as PHPStan
// proves it: `$i < count($list)` with $i an int that is not negative,
// `$i < count($list) - $n` and `<=` with $n at least 1, `$k = count($list)
// - 1` of a list that cannot be empty, and the loop `for ($i = 0; $i <
// count($list); $i++)`. A write there keeps the list. Whatever changes the
// list or the index forgets it.

/** @param array{id: int, n: int} $row */
function save(array $row): void
{
}

/**
 * @param list<array{id: int, n: int}> $rows
 * @return list<array{id: int, n: int}>
 */
function everyRow(array $rows): array
{
    $s = 0;
    for ($i = 0; $i < count($rows); $i++) {
        $rows[$i]['n']++;
        $s += $rows[$i]['id'];
        save($rows[$i]);
    }
    echo $s;
    return $rows;
}

/**
 * @param list<int> $xs
 * @return list<int>
 */
function everyValue(array $xs): array
{
    for ($i = 0; count($xs) > $i; ++$i) {
        $xs[$i] = 5;
    }
    for ($j = 0; $j < sizeof($xs); $j++) {
        $xs[$j] *= 2;
    }
    return $xs;
}

/**
 * @param list<int> $xs
 * @return list<int>
 */
function bounded(array $xs, int $i): array
{
    if ($i >= 0 && $i < count($xs)) {
        $xs[$i] = 5;
    }
    return $xs;
}

/**
 * @param list<array{id: int, n: int}> $rows
 * @return array{id: int, n: int}
 */
function guarded(array $rows, int $i): array
{
    if ($i < 0 || $i >= count($rows)) {
        throw new \OutOfRangeException();
    }
    $rows[$i]['n'] = 1;
    return $rows[$i];
}

/**
 * @param list<int> $xs
 * @param int<0, max> $i
 * @return list<int>
 */
function nonNegative(array $xs, int $i): array
{
    if (count($xs) > $i) {
        $xs[$i] = 5;
    }
    return $xs;
}

/**
 * @param non-empty-list<int> $xs
 * @return list<int>
 */
function lastOne(array $xs): array
{
    $k = count($xs) - 1;
    $xs[$k] = 5;
    return $xs;
}

/**
 * @param list<int> $xs
 * @return list<int>
 */
function lastOfSome(array $xs): array
{
    if ($xs !== []) {
        $k = count($xs) - 1;
        $xs[$k] = 5;
    }
    return $xs;
}

/**
 * @param list<int> $xs
 * @return list<int>
 */
function belowTheLast(array $xs, int $i): array
{
    if ($i >= 0 && $i <= count($xs) - 1) {
        $xs[$i] = 5;
    }
    if ($i >= 0 && $i < count($xs) - 2) {
        $xs[$i] = 6;
    }
    return $xs;
}

/**
 * @param list<int> $xs
 * @return list<int>
 */
function skipped(array $xs, bool $c): array
{
    for ($i = 0; $i < count($xs); $i++) {
        if ($c) {
            $i += 5;
            continue;
        }
        $xs[$i] = 5;
    }
    return $xs;
}

final class Store
{
    /** @var list<array{id: int, n: int}> */
    private array $rows = [];

    public function bump(int $i): void
    {
        if ($i < 0 || $i >= count($this->rows)) {
            return;
        }
        $this->rows[$i]['n']++;
    }
}

// A narrowing that leaves the list's value type as it was keeps the
// offset: a second count() check, the list not empty.

/**
 * @param list<array{id: int, n: int}> $rows
 * @return list<array{id: int, n: int}>
 */
function countedTwice(array $rows, int $i): array
{
    if ($i >= 0 && $i < count($rows)) {
        if (count($rows) > 3) {
            $rows[$i]['n'] = 1;
        }
        $rows[$i]['id'] = 2;
    }
    return $rows;
}

/**
 * @param list<int> $xs
 * @param int<0, max> $i
 * @return list<int>
 */
function provedEitherWay(array $xs, int $i, bool $b): array
{
    if ($b) {
        if ($i >= count($xs)) {
            return $xs;
        }
    } else {
        if (!isset($xs[$i])) {
            return [];
        }
    }
    $xs[$i] = 3;
    return $xs;
}

// A narrowing of the list after the test, an assertion here, forgets the
// offset: what the path held is the list's value type as the test found
// it. The narrowed list says what the entry is.

/**
 * @param array<mixed> $xs
 * @phpstan-assert list<int> $xs
 */
function assertInts(array $xs): void
{
}

/** @param list<int|string> $xs */
function assertedInTheLoop(array $xs): int
{
    $s = 0;
    for ($i = 0; $i < count($xs); $i++) {
        assertInts($xs);
        $s += $xs[$i]; // an int (phpstan_test.go)
    }
    return $s;
}

/** @param list<int|string> $xs */
function assertedThenRead(array $xs): int
{
    $s = 0;
    for ($i = 0; $i < count($xs); $i++) {
        assertInts($xs);
        $v = $xs[$i];
        if (is_int($v)) {
            $s += $v;
        }
    }
    return $s;
}

/**
 * @param list<int|string> $xs
 * @param int<0, max> $i
 */
function provedOrSetThenAsserted(array $xs, int $i, bool $b): int
{
    if ($b) {
        if ($i >= count($xs)) {
            return 0;
        }
    } else {
        if (!isset($xs[$i])) {
            return 1;
        }
    }
    assertInts($xs);
    return $xs[$i]; // an int (phpstan_test.go)
}

/**
 * @param list<int|string> $xs
 * @return list<int>
 */
function assertedThenWritten(array $xs): array
{
    for ($i = 0; $i < count($xs); $i++) {
        assertInts($xs);
        $xs[$i] = 5;
    }
    return $xs; // want P2202
}

// Nothing proves the offset: the list is lost, as PHPStan loses it.

/**
 * @param list<int> $xs
 * @return list<int>
 */
function maybeNegative(array $xs, int $i): array
{
    if ($i < count($xs)) {
        $xs[$i] = 5;
    }
    return $xs; // want P2202
}

/**
 * @param list<int> $xs
 * @return list<int>
 */
function onePast(array $xs, int $i): array
{
    if ($i >= 0 && $i <= count($xs)) {
        $xs[$i] = 5;
    }
    return $xs; // want P2202
}

/**
 * @param list<int> $xs
 * @return list<int>
 */
function hoisted(array $xs): array
{
    $n = count($xs);
    for ($i = 0; $i < $n; $i++) {
        $xs[$i] = 5;
    }
    return $xs; // want P2202
}

/**
 * @param list<int> $xs
 * @return list<int>
 */
function lastOfMaybeNone(array $xs): array
{
    $k = count($xs) - 1;
    $xs[$k] = 5;
    return $xs; // want P2202
}

/**
 * @param list<int> $xs
 * @return list<int>
 */
function popped(array $xs, int $i): array
{
    if ($i >= 0 && $i < count($xs)) {
        array_pop($xs);
        $xs[$i] = 5;
    }
    return $xs; // want P2202
}

/**
 * @param list<int> $xs
 * @return list<int>
 */
function shifted(array $xs, int $i): array
{
    if ($i >= 0 && $i < count($xs)) {
        array_shift($xs);
        $xs[$i] = 5;
    }
    return $xs; // want P2202
}

/**
 * @param list<int> $xs
 * @return list<int>
 */
function spliced(array $xs, int $i): array
{
    if ($i >= 0 && $i < count($xs)) {
        array_splice($xs, 0, 1);
        $xs[$i] = 5;
    }
    return $xs; // want P2202
}

/**
 * @param list<int> $xs
 * @param list<int> $ys
 * @return list<int>
 */
function reassigned(array $xs, array $ys, int $i): array
{
    if ($i >= 0 && $i < count($xs)) {
        $xs = $ys;
        $xs[$i] = 5;
    }
    return $xs; // want P2202
}

/** @param list<int> $xs */
function shrink(array &$xs): void
{
    $xs = [];
}

/**
 * @param list<int> $xs
 * @return list<int>
 */
function shrunk(array $xs, int $i): array
{
    if ($i >= 0 && $i < count($xs)) {
        shrink($xs);
        $xs[$i] = 5;
    }
    return $xs; // want P2202
}

/**
 * @param list<int> $xs
 * @return list<int>
 */
function moved(array $xs, int $i): array
{
    if ($i >= 0 && $i < count($xs)) {
        $i++;
        $xs[$i] = 5;
    }
    return $xs; // want P2202
}

/**
 * @param list<int> $xs
 * @return list<int>
 */
function movedThroughAReference(array $xs, int $i): array
{
    $j = &$i;
    if ($i >= 0 && $i < count($xs)) {
        $j = 99;
        $xs[$i] = 5;
    }
    return $xs; // want P2202
}

/**
 * @param list<int> $xs
 * @param list<int> $ys
 * @return list<int>
 */
function sameIndexInside(array $xs, array $ys): array
{
    for ($i = 0; $i < count($xs); $i++) {
        for ($i = 0; $i < count($ys); $i++) {
            echo $ys[$i];
        }
        $xs[$i] = 5;
    }
    return $xs; // want P2202
}

/**
 * @param list<int> $xs
 * @return list<int>
 */
function poppedInTheLoop(array $xs): array
{
    for ($i = 0; $i < count($xs); $i++) {
        array_pop($xs);
        $xs[$i] = 5;
    }
    return $xs; // want P2202
}

/**
 * @param list<int> $xs
 * @return list<int>
 */
function anotherOffsetFirst(array $xs, int $i, int $j): array
{
    if ($i >= 0 && $i < count($xs)) {
        $xs[$j] = 1;
        $xs[$i] = 5;
    }
    return $xs; // want P2202
}

/**
 * @param list<array{id: int, n: int}> $rows
 * @return list<array{id: int, n: int}>
 */
function unproved(array $rows, int $i): array
{
    $rows[$i]['n'] = 1;
    return $rows; // want P2202
}
