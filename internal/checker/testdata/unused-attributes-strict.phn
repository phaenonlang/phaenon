// reflected-attributes: []
// An empty unused.reflectedAttributes in phaenon.json (design/tooling.md
// §9.2) lets no attribute exempt a private property: PHPStan's findings
// without framework extensions.

namespace UnusedAttributesStrict;

#[\Attribute(\Attribute::TARGET_PROPERTY | \Attribute::TARGET_PARAMETER)]
final class MapTo
{
    public function __construct(public string $name)
    {
    }
}

final class Source
{
    #[MapTo('id')] private int $id = 0; // want P2407 "id"

    #[MapTo('label')] private string $label; // want P2406 "label"

    public function __construct(
        #[MapTo('snake_case')] private string $snakeCase, // want P2407 "snakeCase"
    ) {
    }
}
