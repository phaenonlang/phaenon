namespace TruthinessOfADocumentedType;

// A test of truthiness is always true or always false only where the type
// PHP guarantees decides it, as PHPStan decides it with
// treatPhpDocTypesAsCertain off: an object, a literal array, a value
// assigned from a literal, an int a native comparison narrowed. A range
// or a shape a docblock alone gives, of a parameter, a property or a
// method's result, decides nothing, in an if, a ternary, `!`, an operand
// of && or ||, `?:` or a loop's condition, and the branch it would rule
// out stays reachable. A comparison narrows PHP's type as PHPStan narrows
// the native type, by the bound as typed: `$a > 0`, or `$a >= $p` with a
// documented positive-int $p, makes a documented int<0, max> over `int $a`
// an int<1, max> to PHP. Plain PHP, so that PHPStan reads this file as
// written.

/**
 * @param int<1, max> $a
 * @param non-empty-list<int> $xs
 * @param array{a: int} $shape
 */
function documented(int $a, array $xs, array $shape): int
{
    echo $a ? 1 : 2;
    if ($a) {
        echo 'a';
    }
    if (!$a) {
        echo 'b';
    }
    if ($a && $xs) {
        echo 'c';
    }
    if ($a || $shape) {
        echo 'd';
    }
    echo $a ?: 0;
    while ($xs) {
        $xs = [];
    }
    return $a;
}

final class Bag
{
    /** @var non-empty-list<int> */
    public array $items = [1];

    /** @return non-empty-list<int> */
    public function all(): array
    {
        return $this->items;
    }

    public function show(): void
    {
        if ($this->items) {
            echo 'a';
        }
        if ($this->all()) {
            echo 'b';
        }
    }
}

function native(object $o, int $i): void
{
    if ($o) { echo 'a'; } // want P2402 "condition is always true (object)"
    $list = [1];
    if ($list) { echo 'b'; } // want P2402 "always true"
    $five = 5;
    echo $five ? 'c' : 'd'; // want P2402 "always true (5)"
    $zero = 0;
    if ($zero) { echo 'e'; } // want P2402 "always false (0)", P2401
    if (!$o) { echo 'f'; } // want P2402 "always true (object)", P2401
    if ($i > 0) {
        if ($i) { echo 'g'; } // want P2402 "always true (int<1, max>)"
    }
}

/** @param int<0, max> $a */
function narrowedNatively(int $a): void
{
    if ($a > 0) {
        if ($a) { echo 'h'; } // want P2402 "always true (int<1, max>)"
    }
}

/**
 * @param int<0, max> $a
 * @param positive-int $p
 */
function narrowedByADocumentedBound(int $a, int $p): void
{
    if ($a >= $p) {
        if ($a) { echo 'i'; } // want P2402 "always true (int<1, max>)"
    }
}

/**
 * A test of truthiness narrows PHP's type as it narrows the refined one:
 * the outer test of a documented value is open, the inner one is not, as
 * PHPStan has them.
 *
 * @param positive-int $a
 * @param non-empty-list<int> $xs
 */
function repeated(int $a, array $xs): void
{
    if ($a) {
        if ($a) { echo 'a'; } // want P2402 "always true"
    }
    if (!$a) {
        return;
    }
    if ($a) { echo 'b'; } // want P2402 "always true"
    if ($xs) {
        if ($xs) { echo 'c'; } // want P2402 "always true"
    }
}

/** @param non-empty-string $mode */
function among(string $mode): bool
{
    return in_array($mode, ['a', 'b'], true) && $mode; // want P2402 "always true"
}

/**
 * The last condition of a chain, an elseif with no else after it, is not
 * reported always true, as PHPStan does not report it; what follows it is
 * unreachable all the same.
 *
 * @param non-empty-list<int> $xs
 */
function chained(array $xs): string
{
    if ($xs) {
        return 'some';
    } elseif (!$xs) {
        return 'none';
    }
    return 'x'; // want P2401
}

/**
 * A variable an inline @var declares holds what the tag says and nothing
 * PHP guarantees, whatever value it is given.
 */
function declared(): void
{
    /** @var list<string> $errors */
    $errors = [];
    if ($errors) {
        echo 'e';
    }
    /** @var int $n */
    $n = 0;
    if ($n) {
        echo 'n';
    }
    /** @var bool $flag */
    $flag = false;
    if (!$flag) {
        echo 'f';
    }
}

/**
 * A test leaves what it found of a property, as of a variable, until the
 * property is written or a call may change it: its PHP type narrowed, by
 * a test of truthiness, a comparison or ===, and, where no type spells
 * what was found (a string that is not '0', a mixed that is not falsy),
 * the finding itself, so that the same test again is decided.
 */
final class Kept
{
    /** @var non-empty-string */
    public string $name = 'x';

    /** @var non-empty-list<int> */
    public array $ids = [1];

    /** @var int<0, max> */
    public int $n = 0;

    public function reset(): void
    {
        $this->ids = [1];
    }

    public function kept(string $other): void
    {
        if ($this->name) {
            if ($this->name) { // want P2402 "always true"
                echo 'a';
            }
        }
        if (!$this->ids) {
            return;
        }
        if ($this->ids) { // want P2402 "always true"
            echo 'b';
        }
        if ($this->n > 3) {
            if ($this->n > 1) { // want P2402 "always true"
                echo 'c';
            }
        }
    }

    public function changed(string $other): void
    {
        if ($this->name) {
            $this->name = $other === '' ? 'y' : $other;
            if ($this->name) {
                echo 'a';
            }
        }
        if (!$this->ids) {
            return;
        }
        $this->reset();
        if ($this->ids) {
            echo 'b';
        }
    }
}

/**
 * A variable an inline @var declares, tested twice, is decided the second
 * time, though PHP's type of it, mixed, spells nothing of the first: until
 * it is written, an offset of it, or by reference.
 */
function twice(): void
{
    /** @var list<string> $errors */
    $errors = [];
    if ($errors) {
        if ($errors) { // want P2402 "always true"
            echo 'e';
        }
    }
    /** @var string $s */
    $s = '';
    if (!$s) {
        if (!$s) { // want P2402 "always false (''|'0')"
            echo 's';
        }
    }
    if ($errors) {
        array_pop($errors);
        if ($errors) {
            echo 'p';
        }
    }
    if ($s) {
        echo 'l';
    } elseif (!$s) {
        echo 'm';
    }
}

/** @return list<string> */
function loaded(): array
{
    return [];
}

/**
 * A write to a property, an instance's or a static one however it is
 * spelled, an offset written, appended or unset, forgets what a test kept
 * of it, and gives it the PHP type of what was written, as PHPStan's
 * native type of it has it after the write: the lazy initialisation of a
 * static decides nothing, nor a test after an offset of it is unset,
 * `self::$map = []` makes `self::$map` empty to PHP, and an offset
 * written makes an array non-empty.
 */
final class Written
{
    /** @var list<string> */
    public static array $names = [];

    /** @var array<string, string> */
    public static array $map = [];

    /** @var int<0, max> */
    public static int $count = 0;

    /** @var list<int> */
    public array $queue = [];

    /** @var array<string, string> */
    public array $local = [];

    public function names(): void
    {
        if (!self::$names) {
            self::$names = loaded();
            if (!self::$names) {
                throw new \RuntimeException('nothing loaded');
            }
        }
        if (Written::$map) {
            unset(Written::$map['a']);
            if (Written::$map) {
                echo 'some';
            }
        }
        if (static::$map) {
            unset(static::$map['a']);
            if (static::$map) {
                echo 'some';
            }
        }
        if (self::$map) {
            self::$map = [];
            if (!self::$map) { // want P2402 "always false"
                echo 'cleared';
            }
        }
    }

    /**
     * A step of a static PHP's type and the docblock's agree on, here after
     * a test, is decided by the result, as PHPStan decides it.
     */
    public function counted(): void
    {
        if (!self::$count) {
            self::$count++;
            if (self::$count) { // want P2402 "always true (1)"
                echo 'one';
            }
        }
    }

    public function written(): void
    {
        $this->queue[] = 1;
        if ($this->queue) { // want P2402 "always true"
            echo 'q';
        }
        $this->local = ['x' => 'y'];
        if ($this->local) { // want P2402 "always true (array{x: 'y'})"
            echo 'l';
        }
        $this->local['a'] = 'b';
        if ($this->local) { // want P2402 "always true"
            echo 'a';
        }
    }
}

/**
 * A test that leaves an array empty or not narrows PHP's type of it as
 * PHPStan narrows the native type, by the type the test specifies: a
 * comparison with [], loose or strict, on either side, count() compared,
 * empty() and array_key_exists(), so that a test of truthiness after it
 * is decided.
 *
 * @param list<int> $a
 */
function emptiness(array $a): void
{
    if ($a !== []) {
        echo $a ? 1 : 2; // want P2402 "always true"
    } else {
        echo $a ? 3 : 4; // want P2402 "always false"
    }
    if ([] != $a) {
        echo $a ? 1 : 2; // want P2402 "always true"
    }
    if (count($a) > 0) {
        echo $a ? 1 : 2; // want P2402 "always true"
    } else {
        echo $a ? 3 : 4; // want P2402 "always false"
    }
    if (count($a) === 0) {
        echo $a ? 1 : 2; // want P2402 "always false"
    } else {
        echo $a ? 3 : 4; // want P2402 "always true"
    }
    if (!empty($a)) {
        echo $a ? 1 : 2; // want P2402 "always true"
    }
    if (array_key_exists(0, $a)) {
        echo $a ? 1 : 2; // want P2402 "always true"
    }
}

/**
 * A PHP type that is mixed takes what count() leaves of the documented
 * type, as PHPStan computes the type count() specifies from it: a
 * list<int> an inline tag declares, found above 0, is not empty.
 * `$a !== []` leaves what is not the empty array, null and 0 among it.
 */
function mixedEmptiness(): void
{
    /** @var list<int> $a */
    $a = loaded();
    if (count($a) > 0) {
        echo $a ? 1 : 2; // want P2402 "always true"
    }
    if ($a !== []) {
        echo $a ? 1 : 2;
    } else {
        echo $a ? 3 : 4; // want P2402 "always false"
    }
}

/**
 * A test a value of the documented type cannot meet takes nothing from
 * PHP's type where it fails, as PHPStan takes nothing: `$a !== 0` of a
 * documented positive int, `$a !== []` of a shape with a key.
 *
 * @param int<1, max> $n
 * @param array{id: int} $shape
 */
function unmet(int $n, array $shape): void
{
    if ($n !== 0) {
        echo $n ? 1 : 2;
    }
    if ($shape !== []) {
        echo $shape ? 1 : 2;
    } else {
        echo $shape ? 3 : 4; // want P2402 "always false"
    }
}

/**
 * A test of truthiness found truthy decides the same test again where
 * PHPStan's narrowed native type does: a string, mixed; not a float or
 * an iterable, from which it takes neither 0.0 nor the empty array.
 *
 * @param iterable<int> $items
 */
function testedAgain(iterable $items, float $f, string $s, mixed $m): void
{
    if ($items) {
        echo $items ? 1 : 2;
    }
    if ($f) {
        echo $f ? 1 : 2;
    }
    if ($s) {
        echo $s ? 1 : 2; // want P2402 "always true"
    }
    if ($m) {
        echo $m ? 1 : 2; // want P2402 "always true"
    }
}

/**
 * Loosely unlike the empty array decides truthiness only of an array: 0,
 * 0.0, '' and '0' are unlike it too, and PHPStan decides nothing of a
 * type with null or false beside the arrays. count() found exactly 0
 * leaves a value documented as mixed an empty array or a Countable, which
 * is truthy, and count() found positive leaves it mixed, to PHPStan.
 *
 * @param string|list<string> $s
 * @param list<int>|null $v
 */
function looselyUnlike(mixed $m, string|array $s, ?array $v, string $json): void
{
    if ($m != []) {
        echo $m ? 1 : 2;
    }
    if ([] != $s) {
        echo $s ? 1 : 2;
    }
    if ($v != []) {
        echo $v ? 1 : 2;
    }
    $data = json_decode($json, true);
    if ($data != []) {
        echo $data ? 1 : 2;
    }
}

function countedMixed(mixed $m): void
{
    if (count($m) === 0) { // want P2103
        echo $m ? 1 : 2;
    }
    if (count($m) > 0) { // want P2103
        echo $m ? 1 : 2;
    }
}

function more(): bool
{
    return \rand(0, 1) === 1;
}

/**
 * What a test found of a variable an inline @var declares holds where
 * every way in holds it, as PHPStan's mixed~falsy joined with itself: after
 * an if/else, a match, a loop that does not write the value, a foreach
 * over it. A way that writes the value, or never tested it, takes it away,
 * and so does a loop whose body writes it, a value of the same type too.
 */
function joined(bool $c): void
{
    /** @var list<string> $errors */
    $errors = loaded();
    if ($errors) {
        if ($c) {
            echo 1;
        } else {
            echo 2;
        }
        echo $errors ? 'a' : 'b'; // want P2402 "always true"
        foreach ($errors as $e) {
            echo $e;
        }
        echo $errors ? 'a' : 'b'; // want P2402 "always true"
        while (more()) {
            echo 3;
        }
        echo $errors ? 'a' : 'b'; // want P2402 "always true"
        if ($c) {
            $errors = loaded();
        }
        echo $errors ? 'a' : 'b';
    }
    /** @var list<string> $ids */
    $ids = loaded();
    if (!$ids) {
        return;
    }
    foreach ($ids as $id) {
        echo $id;
    }
    if ($ids) { // want P2402 "always true"
        echo 'again';
    }
    /** @var non-empty-list<string> $names */
    $names = loaded();
    if ($names) {
        while (more()) {
            if ($names) {
                echo 'n';
            }
            /** @var non-empty-list<string> $names */
            $names = loaded();
        }
    }
    /** @var list<string> $rows */
    $rows = loaded();
    if ($c && $rows) {
        echo 'r';
    }
    echo $rows ? 'a' : 'b';
}

/**
 * A function of PHP's own that takes an array by reference leaves PHP's
 * type of it what it leaves of the one it had, as PHPStan reads its out
 * types as native: a sort keeps an array non-empty, array_push() makes it
 * so, array_pop() and array_shift() may leave none, and
 * `array_splice($xs, 0)` leaves none. Of the mixed PHP type an inline tag
 * leaves, sort() leaves a list and decides nothing, a sort that keeps the
 * keys leaves it as it was.
 */
final class Sorted
{
    /** @var list<string> */
    private static array $names = [];

    /** @var list<string> */
    private array $list = [];

    public function sorted(): void
    {
        if (self::$names) {
            \sort(self::$names);
            if (self::$names) { // want P2402 "always true"
                echo 'a';
            }
        }
        if ($this->list) {
            \usort($this->list, fn (string $a, string $b): int => $a <=> $b);
            if ($this->list) { // want P2402 "always true"
                echo 'b';
            }
            \array_pop($this->list);
            if ($this->list) {
                echo 'c';
            }
            \array_push($this->list, 'x');
            if ($this->list) { // want P2402 "always true"
                echo 'd';
            }
        }
    }

    /** @param list<string> $xs */
    public function argument(array $xs): void
    {
        $ys = loaded();
        if ($xs && $ys) {
            \rsort($xs);
            \ksort($ys);
            echo $xs ? 1 : 2; // want P2402 "always true"
            echo $ys ? 1 : 2; // want P2402 "always true"
            \array_shift($xs);
            echo $xs ? 1 : 2;
            \array_splice($xs, 0);
            echo $xs ? 1 : 2; // want P2402 "always false"
        }
        /** @var list<string> $zs */
        $zs = loaded();
        if ($zs) {
            \asort($zs);
            echo $zs ? 1 : 2; // want P2402 "always true"
            \sort($zs);
            echo $zs ? 1 : 2;
        }
    }
}

/** @return non-empty-list<string> */
function someLoaded(): array
{
    return ['x'];
}

/**
 * An offset of a property's array, an instance's or a static one, holds
 * the PHP type of the value written into it, as the property does: `[]`
 * makes it empty, a literal list non-empty, and a value a docblock alone
 * calls non-empty decides nothing.
 */
final class OffsetWritten
{
    /** @var array<string, list<string>> */
    private array $map = [];

    /** @var array<string, string> */
    private static array $labels = [];

    public function written(): void
    {
        $this->map['a'] = [];
        echo $this->map['a'] ? 1 : 2; // want P2402 "always false"
        $this->map['b'] = ['x'];
        echo $this->map['b'] ? 1 : 2; // want P2402 "always true"
        $this->map['c'] = someLoaded();
        echo $this->map['c'] ? 1 : 2;
        self::$labels['a'] = '';
        echo self::$labels['a'] ? 1 : 2; // want P2402 "always false"
        foreach ([1, 2] as $i) {
            $this->map['d'] = [];
        }
        echo $this->map['d'] ? 1 : 2; // want P2402 "always false"
    }
}

/**
 * A value of a type parameter a test narrows is decided by what the test
 * leaves of PHP's type, as PHPStan decides it by the native type it
 * narrows: isset() of an offset leaves an array non-empty, `$a > 0` takes
 * null, false and the ints up to 0 away, is_string() of a callable leaves
 * a callable-string, which is never falsy. A test that leaves PHP's type
 * nothing, or a value that may still be falsy, decides nothing.
 *
 * @template T
 */
final class Narrowed
{
    /** @param T $a */
    public function offset(mixed $a): void
    {
        if (\is_array($a) && isset($a['id'])) {
            echo $a ? 1 : 2; // want P2402 "always true (array{id: mixed, ...})"
            unset($a['id']);
            echo $a ? 1 : 2;
        }
    }

    /** @param T $a */
    public function unbounded(mixed $a): void
    {
        if (isset($a['id'])) { // want P2302
            echo $a ? 1 : 2;
        }
    }
}

/** @template T of bool */
final class Compared
{
    /** @param T $a */
    public function compared(bool $a): void
    {
        if ($a > 0) {
            echo $a ? 1 : 2; // want P2402 "always true (true)"
        }
        if ($a < 1) {
            echo $a ? 1 : 2; // want P2402 "always false (false)"
        }
        if ($a >= 0) {
            echo $a ? 1 : 2;
        }
        if ($a > -1) {
            echo $a ? 1 : 2;
        }
    }
}

/** @template T of int|null */
final class ComparedInt
{
    /** @param T $a */
    public function compared(?int $a): void
    {
        if ($a > 0) {
            echo $a ? 1 : 2; // want P2402 "always true (int<1, max>)"
        }
        if ($a > -5) {
            echo $a ? 1 : 2;
        }
    }
}

/** @template T of callable|null */
final class Called
{
    /** @param T $a */
    public function called(?callable $a): void
    {
        if (\is_string($a)) {
            echo $a ? 1 : 2; // want P2402 "always true (callable-string)"
        }
    }

    /** @param T $a */
    public function compared(?callable $a): void
    {
        if ($a > 0) {
            echo $a ? 1 : 2; // want P2402 "always true (callable)"
        }
    }
}

/** @param int<0, max>|null $n */
function comparedNullable(?int $n, ?callable $c, ?string $s): void
{
    if ($n > 0) {
        echo $n ? 1 : 2; // want P2402 "always true (int<1, max>)"
    }
    if (\is_string($c)) {
        echo $c ? 1 : 2; // want P2402 "always true (callable-string)"
    }
    if ($s > 0) {
        echo $s ? 1 : 2;
    }
}

/**
 * A way that wrote the variable meets the others with what PHP's type of
 * the value written says of its truthiness, as PHPStan's mixed~falsy
 * joined with array{'a'} is truthy: a default written where the value was
 * empty leaves the test decided. A value PHP's type certifies nothing of,
 * a call documented non-empty or a ternary of documented values, leaves it
 * open, and so does a falsy default.
 *
 * @param non-empty-list<string> $docs
 */
function defaulted(string $s, bool $c, int $k, array $docs): int
{
    /** @var list<string> $xs */
    $xs = loaded();
    if (!$xs) {
        $xs = ['a'];
    }
    if ($xs) { // want P2402 "always true"
        echo 1;
    }
    /** @var list<string> $ys */
    $ys = loaded();
    if ($ys) {
        echo 2;
    } else {
        $ys = [$s];
    }
    echo $ys ? 1 : 2; // want P2402 "always true"
    /** @var list<string> $zs */
    $zs = loaded();
    if (!$zs) {
        switch ($k) {
            case 1:
                $zs = ['one'];
                break;
            default:
                $zs = ['other'];
        }
    }
    echo $zs ? 1 : 2; // want P2402 "always true"
    /** @var list<string> $us */
    $us = loaded();
    if (!$us) {
        $us = someLoaded();
    }
    echo $us ? 1 : 2;
    /** @var list<string> $ws */
    $ws = loaded();
    if (!$ws) {
        $ws = $c ? $docs : $docs;
    }
    echo $ws ? 1 : 2;
    /** @var list<string> $vs */
    $vs = loaded();
    if ($vs) {
        $vs = [];
    }
    echo $vs ? 1 : 2; // want P2402 "always false"
    /** @var int $n */
    $n = \json_decode('0');
    if (!$n) {
        $n = 10;
    }
    return $n ? $n : 1; // want P2402 "always true"
}

/**
 * A finally block's writes, of a variable and of a property, hold after
 * the try statement, with what a test in the block found.
 */
final class Finished
{
    /** @var list<string> */
    private array $list = [];

    public function finished(): void
    {
        /** @var list<string> $xs */
        $xs = loaded();
        try {
            $xs = loaded();
        } finally {
            if (!$xs) {
                $xs = ['a'];
            }
        }
        if ($xs) { // want P2402 "always true"
            echo 1;
        }
        if ($this->list) {
            try {
                loaded();
            } finally {
                $this->list = loaded();
            }
            if ($this->list) {
                echo 2;
            }
        }
    }
}

function v(): mixed
{
    return \json_decode('[]', true);
}

/**
 * A step, a compound assignment, a destructuring, an offset written or
 * unset under a path, and a write of the whole array give a variable, a
 * property, a static property or an offset the PHP type PHPStan's native
 * type has after them, computed on the PHP types written: `.= 'x'` of an
 * empty string is a non-empty one, `unset()` of the one entry leaves an
 * empty array, an offset of an array written whole is the entry written.
 * A mixed one an inline @var leaves stays mixed: `$n++` of it, or an
 * entry appended to it, decides nothing.
 */
final class Computed
{
    /** @var array<string, string> */
    public array $labels = [];

    /** @var array<string, string> */
    public static array $names = [];

    /** @var array<string, array<int, int>> */
    public array $lists = [];

    /** @var array<string, list<string>> */
    public array $groups = [];

    public function computed(string $s): void
    {
        $this->labels['a'] = '';
        $this->labels['a'] .= 'x';
        echo $this->labels['a'] ? 1 : 2; // want P2402 "always true"
        self::$names['a'] = '';
        self::$names['a'] .= 'x';
        echo self::$names['a'] ? 1 : 2; // want P2402 "always true"
        $this->labels['b'] = '';
        $this->labels['b'] .= $s;
        echo $this->labels['b'] ? 1 : 2;
        $this->lists['a'] = [1];
        unset($this->lists['a'][0]);
        echo $this->lists['a'] ? 1 : 2; // want P2402 "always false"
        $this->labels = ['a' => 'x'];
        echo $this->labels['a'] ? 1 : 2; // want P2402 "always true"
        [$this->labels['c']] = ['y'];
        echo $this->labels['c'] ? 1 : 2; // want P2402 "always true"
        if (!isset($this->groups['k'])) {
            return;
        }
        $this->groups['k'][] = 'z';
        echo $this->groups['k'] ? 1 : 2; // want P2402 "always true"
        $this->groups['k'] += ['w'];
        echo $this->groups['k'] ? 1 : 2; // want P2402 "always true"
    }

    public function mixedStays(): void
    {
        /** @var int $n */
        $n = v();
        if ($n) {
            $n++;
            echo $n ? 1 : 2;
        }
        /** @var list<string> $xs */
        $xs = v();
        if ($xs) {
            $xs[] = 'a';
            echo $xs ? 1 : 2;
        }
        if (!$xs) {
            $xs[] = 'a';
            echo $xs ? 1 : 2; // want P2402 "always true"
        }
    }
}

/**
 * A by-reference argument of PHP's own functions, as PHPStan types it:
 * array_push() with no value adds nothing, array_walk() leaves an empty
 * array empty and writes its callback's values into the array, settype()
 * to the type PHP already gives the value leaves it as it was, where PHP
 * guarantees that type (a value of `loaded(): array`), and decides
 * nothing where PHP does not (json_decode()'s mixed, an object made an
 * array may be empty). A foreach by reference over an offset forgets
 * what a test found of it.
 */
final class Referenced
{
    /** @var array<string, string> */
    public array $labels = [];

    /** @var array<string, list<string>> */
    public array $groups = [];

    public function referenced(): void
    {
        /** @var list<string> $xs */
        $xs = v();
        if ($xs) {
            \array_push($xs);
            echo $xs ? 1 : 2; // want P2402 "always true"
        }
        if (!$xs) {
            \array_walk($xs, function (string &$v): void {
                $v = \trim($v);
            });
            echo $xs ? 1 : 2; // want P2402 "always false"
        }
        $this->labels['a'] = '';
        \array_walk($this->labels, function (string &$v): void {
            $v = 'x';
        });
        echo $this->labels['a'] ? 1 : 2; // want P2402 "always true"
        /** @var list<string> $ys */
        $ys = loaded();
        if ($ys) {
            \settype($ys, 'array');
            echo $ys ? 1 : 2; // want P2402 "always true"
        }
        /** @var list<string> $zs */
        $zs = \json_decode('[]', true);
        if ($zs) {
            \settype($zs, 'array');
            echo $zs ? 1 : 2;
        }
        if (isset($this->groups['k']) && $this->groups['k']) {
            foreach ($this->groups['k'] as &$g) {
                $g = '';
            }
            unset($g);
            echo $this->groups['k'] ? 1 : 2;
        }
    }
}

/**
 * isset() of a constant key leaves PHP's type of the array holding it an
 * array that has the key, as PHPStan's hasOffset() does: an unset() of
 * another key leaves it non-empty, one of that key may empty it.
 *
 * @template T
 */
final class Offsetted
{
    /** @var array<string, int> */
    public static array $counts = [];

    /**
     * @param T $a
     * @param array<string, int> $m
     */
    public function offsetted(mixed $a, array $m): void
    {
        if (\is_array($a) && isset($a['id'])) {
            unset($a['other']);
            echo $a ? 1 : 2; // want P2402 "always true (array{id: mixed, ...})"
            unset($a['id']);
            echo $a ? 1 : 2;
        }
        if (isset($m['id'])) {
            unset($m['other']);
            echo $m ? 1 : 2; // want P2402 "always true"
        }
        if (isset(self::$counts['a'])) {
            unset(self::$counts['b']);
            echo self::$counts ? 1 : 2; // want P2402 "always true"
        }
    }
}
