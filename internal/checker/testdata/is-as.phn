namespace App\IsAs;

// `is` and `as` test what PHP tests in O(1) (design/generics.md §11.4):
// P3011 for a type PHP has no such test for, P3012 for an operand a
// compound test would evaluate twice, the narrowing PHPStan gives the
// native test on the output.

interface Model
{
}

final class User implements Model
{
    public function __construct(public readonly int $id)
    {
    }
}

final class Admin implements Model
{
}

enum Suit
{
    case Hearts;
    case Spades;
}

class Repository<T of Model>
{
    /** @var list<T> */
    public array $items = [];

    public function first(): ?T
    {
        return $this->items[0] ?? null;
    }
}

type Key = int|string;
type Ids = list<int>;

function value(): mixed
{
    return null;
}

function takesInt(int $i): int
{
    return $i;
}

function takesString(string $s): string
{
    return $s;
}

function takesInts(list<int> $l): int
{
    return \count($l);
}

function takesList(list<mixed> $l): int
{
    return \count($l);
}

function takesArray(map<int|string, mixed> $a): int
{
    return \count($a);
}

function takesPair((int, string) $p): string
{
    return $p[1];
}

function takesModel(?Model $m): bool
{
    return $m !== null;
}

function takesUserClass(class<User> $c): string
{
    return $c;
}

function takesKey(Key $k): string
{
    return (string) $k;
}

// What PHP tests itself compiles to that test: no diagnostic.
function checkable(mixed $m, string $s, object $o): int
{
    $n = 0;
    if ($m is int || $m is float || $m is string || $m is bool || $m is null) {
        $n++;
    }
    if ($m is array || $m is object || $m is callable || $m is iterable || $m is true || $m is false) {
        $n++;
    }
    if ($m is scalar || $m is numeric || $m is number || $m is resource) {
        $n++;
    }
    if ($m is User || $m is Model || $m is Suit || $m is \Closure || $m is Closure) {
        $n++;
    }
    if ($m is ?User || $m is int|string || $o is \Countable&\Traversable) {
        $n++;
    }
    if ($m is class<User> || $s is class || $m is class<object>) {
        $n++;
    }
    if ($m is list || $m is map<mixed, mixed> || $m is map<int|string, mixed> || $m is array<mixed>) {
        $n++;
    }
    if ($m is (int, ?string) || $m is ?(int, (string, bool))) {
        $n++;
    }
    if ($m is Key) {
        $n++;
    }

    return $n;
}

// What PHP has no O(1) test for: P3011, the message naming the test that
// exists.
function uncheckable(mixed $m, ?Repository<User> $r): int
{
    $n = 0;
    if ($m is list<int>) { // want P3011 "`list<int>` cannot be tested at runtime in O(1): test `is list`"
        $n++;
    }
    if ($m is map<string, mixed>) { // want P3011 "test `is array`"
        $n++;
    }
    if ($m is array<int>) { // want P3011 "test `is array`"
        $n++;
    }
    if ($m is iterable<int>) { // want P3011 "test `is iterable`"
        $n++;
    }
    if ($m is Closure(int): string) { // want P3011 "test `is Closure`"
        $n++;
    }
    if ($m is bytes) { // want P3011 "test `is string`"
        $n++;
    }
    if ($m is (int, list<string>)) { // want P3011 "`list<string>`"
        $n++;
    }
    if ($m is ?list<User>) { // want P3011 "`list<User>`"
        $n++;
    }
    if ($m is int|map<string, int>) { // want P3011 "`map<string, int>`"
        $n++;
    }
    if ($m is Ids) { // want P3011 "`Ids` (`list<int>`)"
        $n++;
    }
    if ($m is Repository<User>) { // want P3011 "mixed does not fix them; test `is Repository`"
        $n++;
    }
    if ($m is class<Repository<User>>) { // want P3011 "test `is class`"
        $n++;
    }
    if ($m is void) { // want P3011 "no value has this type"
        $n++;
    }
    $u = $m as list<User>; // want P3011 "test `is list`"
    $v = $m as? map<string, int>; // want P3011 "test `is array`"
    if ($r is Repository<User>) {
        $n++; // the operand fixes the arguments: instanceof Repository decides
    }

    return $n + \count($u) + \count($v ?? []);
}

// The arguments a union's member fixes, and ones it does not: a Model may
// be a Repository<Admin> too.
function generic(Repository<User>|int $a, Repository<User>|Repository<Model> $b, Repository<Admin>|User $c, Repository<User>|Model $d): int
{
    $n = 0;
    if ($a is Repository<User>) {
        $n += \count($a->items);
    }
    if ($b is Repository<User>) { // want P3011 "does not fix them"
        $n++;
    }
    if ($c is Repository<Admin>) {
        $n += \count($c->items);
    }
    if ($d is Repository<User>) { // want P3011 "does not fix them"
        $n++;
    }

    return $n;
}

final class Box<T>
{
    public function __construct(private readonly T $value)
    {
    }

    public function same(mixed $other): bool
    {
        return $other is self; // no type parameter is read
    }

    public function like(mixed $other): bool
    {
        return $other is static;
    }

    public function holds(mixed $m): bool
    {
        return $m is ?T; // want P3003
    }

    public function names(mixed $m): bool
    {
        return $m is class<T>; // want P3003
    }

    public function pair(mixed $m): bool
    {
        return $m is (T, int); // want P3003
    }

    public function value(): T
    {
        return $this->value;
    }
}

final class Holder
{
    /** @var map<string, mixed> */
    public array $row = [];
    public mixed $item = null;
    public static mixed $cache = null;
    public ?Holder $next = null;

    public function read(): int
    {
        $id = $this->row['id'] as int;
        $self = self::$cache as? Holder;
        $item = $this->next->item as? User; // want P2105
        $key = $this->row[\PHP_EOL] as? int;
        $deep = $this->next?->item as? int; // want P3012 "the operand of `as?` is evaluated twice"
        $first = $this->next?->item is ?User; // want P3012

        return $id + ($self === null ? 0 : 1) + ($item?->id ?? 0) + ($key ?? 0) + ($deep ?? 0) + ($first ? 1 : 0);
    }
}

// A compound test, an `as` and an `as?` write their operand more than once:
// P3012 for an operand a second reading would run again. A single-function
// test takes any expression.
function operands(mixed $m, int $i, map<int, mixed> $a): int
{
    $n = 0;
    if (value() is int || value() is User || value() is null) {
        $n++;
    }
    if (value() is list) { // want P3012 "the operand of `is` is evaluated twice; assign it to a variable first"
        $n++;
    }
    if (value() is ?int) { // want P3012
        $n++;
    }
    $x = value() as int; // want P3012 "the operand of `as` is evaluated twice"
    $y = value() as? int; // want P3012 "`as?`"
    $z = ($m ?? $i) as int; // want P3012
    $w = $a[$i] as ?int; // want P3012
    $v = ($m = value()) as int; // want P3012
    $u = $a[0] as int;
    if ($a is list) {
        $n++; // on an array, `is list` is \array_is_list($a) alone: any operand
    }

    return $n + $x + ($y ?? 0) + $z + ($w ?? 0) + $v + $u;
}

// Narrowing: as PHPStan narrows the native test on the output.
function narrowing(mixed $m, map<int|string, int> $ints, mixed $p, mixed $c): int
{
    $n = 0;
    if ($ints is list) {
        $n += takesInts($ints); // list<int>
    }
    if ($m is list) {
        $n += takesList($m);
        $n += takesInts($m); // want P2103
    }
    if ($m is array) {
        $n += takesArray($m);
        $n += takesList($m); // want P2103
    }
    if ($p is (int, string)) {
        $n += \strlen(takesPair($p));
    }
    if ($p is ?(int, string)) {
        $n += \strlen(takesPair($p ?? [1, ''])); // want P2103 "list{mixed, mixed} given"
    }
    if ($c is class<User>) {
        $n += \strlen(takesUserClass($c));
    }
    if ($m is Repository) {
        $n += takesModel($m->first()) ? 1 : 0; // the parameter is its bound
    }
    if ($m is Key) {
        $n += \strlen(takesKey($m));
    }
    $i = $m as int;
    $n += takesInt($m); // `as` threw unless $m is an int
    $s = $p as? string;
    $n += takesInt($p); // want P2103

    return $n + $i + \strlen($s ?? '');
}

// A test the types settle is P2306, for `as` and `as?` as for `is`. An
// operand read twice is P3012 all the same: `phn build --emit-on-error`
// writes the test.
function settled(int $i, string $s, mixed $m): int
{
    $a = $i as int; // want P2306 "int is always int"
    $b = $s as? int; // want P2306 "string is never int"
    if ($m is mixed) { // want P2306
        return 0;
    }
    $c = \strlen('a') as int; // want P2306,P3012

    return $a + ($b ?? 0) + $c;
}
