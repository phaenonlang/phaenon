namespace Bodies;

use LogicException;

// Expression bodies (design/functions.md §3): `=> expr;` is the block
// `{ return expr; }`, or `{ expr; }` under void and never, and is checked
// exactly as that block would be. Constructors, destructors and generators
// keep their blocks; an abstract or interface method has no body at all.

interface Named
{
    name(): string;

    shout(): string => \strtoupper($this->name()); // want P2514
}

abstract class Base implements Named
{
    abstract id(): int => 1; // want P2504
}

final class User extends Base
{
    private int $calls = 0;

    __construct(private string $name) {}

    name(): string => $this->name;

    shout(): string => \strtoupper($this->name);

    id(): int => \strlen($this->name);

    wrong(): int => $this->name; // want P2202

    log(string $message): void => $this->record($message);

    record(string $message): void {
        $this->calls += \strlen($message);
    }

    voidValue(): int => $this->record('x'); // want P2205

    fail(string $why): never => throw new LogicException($why);

    leaks(): never => $this->record('x'); // want P2209

    nullable(): ?string => $this->calls > 0 ? $this->name : null;

    static of(string $s): self
        => new self(\trim($s));

    counter(): \Closure => fn (): int => $this->calls;

    generator(): \Generator => yield 1; // want P1004

    __destruct() => $this->record('bye'); // want P1004
}

final class Built
{
    __construct() => print 'built'; // want P1004
}

function double(int $x): int => $x * 2;

function badDouble(int $x): string => $x * 2; // want P2202

function undefined(): int => $missing; // want P2008

function main(): void => print double(2) . User::of(' a ')->name();
