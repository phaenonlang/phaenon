namespace Coll;

// Lists and maps (design/collections.md §2), tuples (§2.4) and bytes
// (strings.md §2) as PHP's functions see them, and `->`, which means what
// PHP means by it: a method call on a list, a map, a string or bytes is
// the error PHP makes it (roadmap D20).

function takesInt(int $i): void
{
}

function takesString(string $s): void
{
}

final class User
{
    public function __construct(public readonly string $name, public readonly int $age)
    {
    }
}

function lists(list<User> $users, list<int> $ns): void
{
    takesInt(count($users));
    $names = array_map(fn (User $u) => $u->name, $users);
    takesString($names[0]);
    takesInt($names[0]); // want P2103
    takesInt(array_sum($ns));
    takesString(implode(',', $names));
}

function maps(map<string, int> $counts, map<int, string> $names): void
{
    takesInt($counts['a'] ?? 0);
    takesString(array_keys($counts)[0]);
    takesInt(array_keys($names)[0]);
    $doubled = array_map(fn (int $n) => $n * 2, $counts);
    takesString($doubled['a'] ?? ''); // want P2103
}

final class Id implements \Stringable
{
    public function __construct(private readonly string $value)
    {
    }

    public function __toString(): string
    {
        return $this->value;
    }

    public function own(): int
    {
        return 1;
    }
}

function notObjects(list<User> $users, map<string, int> $counts, string $s, ?string $maybe, bytes $raw, string|User $value, Id $id): void
{
    takesInt($users->count()); // want P2105 "cannot call method count() on list<Coll\User>"
    takesString($counts->keys()[0]); // want P2105 "cannot call method keys() on array<string, int>"
    takesString($s->upper()->trim()); // want P2105 "cannot call method upper() on string"
    $maybe->length(); // want P2105 "cannot call method length() on string|null"
    takesInt($maybe?->length() ?? 0); // want P2105 "cannot call method length() on string"
    takesInt($raw->length()); // want P2105 "cannot call method length() on bytes"
    $value->upper(); // want P2105 "cannot call method upper() on string|Coll\User"
    $users->map(...); // want P2105
    takesInt($id->own());
    takesString($id->upper()); // want P2006 "unknown method Coll\Id::upper()"
}

function tuples((string, int) $pair, list<(string, int)> $pairs): (int, string)
{
    [$name, $age] = $pair;
    takesString($name);
    takesInt($age);
    takesString($pair[1]); // want P2103
    foreach ($pairs as [$n, $a]) {
        takesInt($n); // want P2103
        takesInt($a);
        takesInt($pairs); // want P2103
    }

    return [$age, $name];
}

function bytesAreNotText(bytes $raw, string $text): void
{
    takesString($raw); // want P2103
    takesString($text);
}

function keyBound(map<bool, int> $flags, map<int|string, int> $any): void // want P2518
{
}

function keyBoundParam<K of object, V>(map<K, V> $m): void // want P2518
{
}

function impliedKeyBound<K, V>(map<K, V> $m): list<K>
{
    return array_keys($m);
}
