namespace Coll;

// Method syntax on lists, maps and strings (design/collections.md §3.1,
// strings.md §4), tuples (§2.4) and bytes (strings.md §2).

function takesInt(int $i): void
{
}

function takesString(string $s): void
{
}

final class User
{
    public function __construct(public readonly string $name, public readonly int $age)
    {
    }
}

function lists(list<User> $users, list<int> $ns): void
{
    takesInt($users->count());
    takesString($users->first()?->name ?? '');
    $names = $users->map(fn (User $u) => $u->name);
    takesString($names[0]);
    takesInt($names->first()); // want P2103
    $sum = $ns->reduce(0, fn (int $acc, int $n) => $acc + $n);
    takesInt($sum);
    $byName = $users->keyBy(fn (User $u) => $u->name);
    takesInt($byName->get('x')); // want P2103
    $users->sort(fn (User $a, User $b) => $a->age <=> $b->age)->each(fn (User $u) => takesString($u->name));
    $users->frobnicate(); // want P2006
    $users->map(); // want P2101
}

function maps(map<string, int> $counts, map<int, string> $names): void
{
    takesInt($counts->get('a') ?? 0);
    takesString($counts->keys()[0]);
    takesInt($names->keys()[0]);
    $doubled = $counts->map(fn (int $n) => $n * 2);
    takesInt($doubled->values()->first() ?? 0);
    takesString($doubled->get('a')); // want P2103
    foreach ($counts->toList() as [$key, $count]) {
        takesString($key);
        takesInt($count);
    }
    takesString($counts->with('b', 2)->without('a')->isEmpty()); // want P2103
}

function strings(string $s, ?string $maybe): void
{
    takesInt($s->length());
    takesString($s->upper()->trim());
    takesInt($s->indexOf('x') ?? -1);
    takesString($s->split(',')->first() ?? '');
    takesInt($s->upper()); // want P2103
    $maybe->length(); // want P2105
    takesString($maybe?->length()); // want P2519
}

function tuples((string, int) $pair, list<(string, int)> $pairs): (int, string)
{
    [$name, $age] = $pair;
    takesString($name);
    takesInt($age);
    takesString($pair[1]); // want P2103
    foreach ($pairs as [$n, $a]) {
        takesInt($n); // want P2103
        takesInt($a);
        takesInt($pairs); // want P2103
    }

    return [$age, $name];
}

function mixedReceiver(list<int>|map<string, int> $either, string|User $value): void
{
    $either->isEmpty(); // want P2519
    $value->upper(); // want P2519
}

function bytesAreNotText(bytes $raw, string $text): void
{
    takesString($raw); // want P2103
    takesString($text);
}
