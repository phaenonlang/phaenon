// The native spellings of untyped-arrays.phn (design/collections.md §2):
// `array<V>` names the element type of a list or keyed array, `array<mixed>`
// is any array, and an `array` with no element type inside another type is
// P2516 as a bare one is.

namespace UntypedArraysNative;

final class Native
{
    private array<mixed> $any = [];

    private array<string> $names = [];

    private ?array $maybe = null; // want P2516 "$maybe"

    __construct(private list<array> $rows) {} // want P2516 "$rows"

    nested(map<string, array> $byName): int => count($byName); // want P2516 "$byName"

    tuple((int, array) $pair): int => $pair[0]; // want P2516 "$pair"

    closure(Closure(array): int $f): int => $f([]); // want P2516 "$f"

    iterTyped(iterable<int> $xs): int => count($this->any) + count($this->names) + count($this->maybe ?? []) + count($this->rows);

    result(): array<int> => [1];

    bare(): array => []; // want P2516 "bare"
}
