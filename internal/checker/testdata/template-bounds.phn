// A class template whose bound names others: the iterator a wrapper takes
// says what the wrapper yields. The constructor binds TInner alone; TKey
// and TValue take what TInner's bound says of them, as PHPStan infers
// them, and the bound holds TInner to nothing they have not said yet.
// Written as PHP with docblocks, so that PHPStan judges the same lines.
namespace App\TemplateBounds;

final class Dog
{
}

/**
 * @template-covariant TKey
 * @template-covariant TValue
 * @template TInner of \Traversable<TKey, TValue>
 * @implements \IteratorAggregate<TKey, TValue>
 */
final class Wrap implements \IteratorAggregate
{
    /** @var TInner */
    private \Traversable $inner;

    /** @param TInner $inner */
    public function __construct(\Traversable $inner)
    {
        $this->inner = $inner;
    }

    /** @return \Traversable<TKey, TValue> */
    public function getIterator(): \Traversable
    {
        return $this->inner;
    }
}

/** @param Wrap<int, Dog, \ArrayIterator<int, Dog>> $w */
function dogs(Wrap $w): void
{
}

/** @param Wrap<int, string, \ArrayIterator<int, string>> $w */
function names(Wrap $w): void
{
}

function takesDog(Dog $d): void
{
}

/**
 * @param \ArrayIterator<int, Dog> $rows
 * @param \Traversable<int, Dog> $any
 */
function wrapped(\ArrayIterator $rows, \Traversable $any): void
{
    $w = new Wrap($rows);
    dogs($w);
    names($w); // want P2103 "Wrap<int, App\TemplateBounds\Dog, ArrayIterator<int, App\TemplateBounds\Dog>> given"
    foreach ($w as $dog) {
        takesDog($dog);
    }
    foreach (new Wrap($any) as $key => $dog) {
        takesDog($dog);
        takesDog($key); // want P2103
    }
}

// A bound that names a template the arguments left open holds the
// argument to that template's own bound, in turn, and to nothing more:
// an iterator keyed by objects breaks Keyed's `I of Iterator<K, mixed>`
// with `K of int|string`, an int breaks `U of T` with `T of Countable`,
// and a map of ints breaks `D of array<string, B>` with `B of list<A>`.
// What fits those bounds passes.
/**
 * @template K of int|string
 * @template I of \Iterator<K, mixed>
 */
final class Keyed
{
    /** @param I $i */
    public function __construct(public \Iterator $i)
    {
    }
}

/**
 * @template T of \Countable
 * @template U of T
 * @param U $u
 * @return U
 */
function counted(mixed $u): mixed
{
    return $u;
}

/**
 * @template A
 * @template B of list<A>
 * @template D of array<string, B>
 */
final class Chain
{
    /** @param D $d */
    public function __construct(public array $d)
    {
    }
}

final class Tally implements \Countable
{
    public function count(): int
    {
        return 0;
    }
}

function keep(mixed $kept): void
{
}

/**
 * @param \Iterator<\stdClass, int> $objectKeys
 * @param \Iterator<string, int> $stringKeys
 */
function bounded(\Iterator $objectKeys, \Iterator $stringKeys): void
{
    keep(new Keyed($objectKeys)); // want P3002 "Iterator<stdClass, int> inferred for I of App\TemplateBounds\Keyed::__construct() is not a subtype of its bound Iterator<int|string, mixed>"
    keep(new Keyed($stringKeys));
    keep(counted(5)); // want P3002 "type argument 5 inferred for U of App\TemplateBounds\counted() is not a subtype of its bound Countable"
    keep(counted(new Tally()));
    keep(new Chain(['a' => 5])); // want P3002
    keep(new Chain(['a' => [5]]));
}
