/**
 * @param string|int|float|bool $message
 * @param-out \stdClass $held
 * @param-out mixed $kept
 */
function afterMsgSend(\SysvMessageQueue $queue, int $message_type, $message, bool $serialize, bool $blocking, mixed &$held, mixed &$kept): void
{
    $r = \msg_send($queue, $message_type, $message, $serialize, $blocking, $error_code);
    takesStd($error_code); // want P2103 "mixed given"
    $r = \msg_send($queue, $message_type, $message, $serialize, $blocking, $held); // want P2213 "writes mixed"
    $r = \msg_send($queue, $message_type, $message, $serialize, $blocking, $kept);
}

/**
 * @param-out \stdClass $held
 * @param-out mixed $kept
 */
function afterMsgReceive(\SysvMessageQueue $queue, int $desired_message_type, int $max_message_size, bool $unserialize, int $flags, mixed &$held, mixed &$kept): void
{
    $r = \msg_receive($queue, $desired_message_type, $received_message_type, $max_message_size, $message, $unserialize, $flags, $error_code);
    takesStd($received_message_type); // want P2103 "mixed given"
    takesStd($message); // want P2103 "mixed given"
    takesStd($error_code); // want P2103 "mixed given"
    $r = \msg_receive($queue, $desired_message_type, $held, $max_message_size, $message, $unserialize, $flags, $error_code); // want P2213 "writes mixed"
    $r = \msg_receive($queue, $desired_message_type, $kept, $max_message_size, $message, $unserialize, $flags, $error_code);
}

