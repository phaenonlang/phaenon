namespace ParamOutPhpWriters;

// A function of PHP's own that writes an argument it takes by reference
// leaves there what PHPStan types it as: the @param-out of its stubs or of
// its extension, mixed where it has neither (stdlib/overlay/writes.php). A
// caller reads that type afterwards, and a parameter documented @param-out
// passed there is held to its tag at the call (phpwrites.go). A parameter
// PHPStan's map says the function reads is not written, but where PHPStan
// writes it back all the same: a sort, shuffle(), array_splice(), and
// array_walk() with a closure that takes the value by reference.

function takesStd(\stdClass $o): void
{
}

// ---- each function that writes: what the caller reads; a parameter whose
// tag the write does not fit ($held) and one whose tag it does ($kept)

/**
 * @param-out \stdClass $held
 * @param-out mixed $kept
 */
function afterFtpAlloc(\FTP\Connection $ftp, int $size, mixed &$held, mixed &$kept): void
{
    $r = \ftp_alloc($ftp, $size, $response);
    takesStd($response); // want P2103 "mixed given"
    $r = \ftp_alloc($ftp, $size, $held); // want P2213 "writes mixed"
    $r = \ftp_alloc($ftp, $size, $kept);
}

/**
 * @param-out \stdClass $held
 * @param-out array<\Socket>|null $kept
 */
function afterSocketSelect(\Socket $socket, ?int $seconds, mixed &$held, mixed &$kept): void
{
    $read = [$socket];
    $write = null;
    $except = [];
    $r = \socket_select($read, $write, $except, $seconds);
    takesStd($read); // want P2103 "array<Socket> given"
    takesStd($write); // want P2103 "null given"
    takesStd($except); // want P2103 "array<Socket> given"
    $r = \socket_select($held, $write, $except, $seconds); // want P2213 "writes array<Socket>|null"
    $r = \socket_select($kept, $write, $except, $seconds);
}

