function afterPassthru(string $command, mixed &$held, mixed &$kept): void
{
    $r = \passthru($command, $result_code);
    takesStd($result_code); // want P2103 "int given"
    $r = \passthru($command, $held); // want P2213 "writes int"
    $r = \passthru($command, $kept);
}

/**
 * @param resource $stream
 * @param-out \stdClass $held
 * @param-out 0|1 $kept
 */
function afterFlock($stream, mixed &$held, mixed &$kept): void
{
    $r = \flock($stream, \LOCK_EX, $would_block);
    takesStd($would_block); // want P2103 "int<0, 1> given"
    $r = \flock($stream, \LOCK_EX, $held); // want P2213 "writes int<0, 1>"
    $r = \flock($stream, \LOCK_EX, $kept);
}

/**
 * @param resource $stream
 * @param-out \stdClass $held
 * @param-out string|int|float|null $kept
 */
function afterFscanf($stream, string $format, mixed &$held, mixed &$kept): void
{
    $r = \fscanf($stream, $format, $vars);
    takesStd($vars); // want P2103 "int|float|string|null given"
    $r = \fscanf($stream, $format, $held); // want P2213 "writes int|float|string|null"
    $r = \fscanf($stream, $format, $kept);
}

/**
 * @param-out \stdClass $held
 * @param-out int $kept
 */
function afterFsockopen(string $hostname, int $port, mixed &$held, mixed &$kept): void
{
    $r = \fsockopen($hostname, $port, $error_code, $error_message);
    takesStd($error_code); // want P2103 "int given"
    takesStd($error_message); // want P2103 "string given"
    $r = \fsockopen($hostname, $port, $held, $error_message); // want P2213 "writes int"
    $r = \fsockopen($hostname, $port, $kept, $error_message);
}

/**
 * @param-out \stdClass $held
 * @param-out mixed $kept
 */
function afterPfsockopen(string $hostname, int $port, mixed &$held, mixed &$kept): void
{
    $r = \pfsockopen($hostname, $port, $error_code, $error_message);
    takesStd($error_code); // want P2103 "mixed given"
    takesStd($error_message); // want P2103 "mixed given"
    $r = \pfsockopen($hostname, $port, $held, $error_message); // want P2213 "writes mixed"
    $r = \pfsockopen($hostname, $port, $kept, $error_message);
}

