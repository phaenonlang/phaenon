function afterSystem(string $command, mixed &$held, mixed &$kept): void
{
    $r = \system($command, $result_code);
    takesStd($result_code); // want P2103 "int given"
    $r = \system($command, $held); // want P2213 "writes int"
    $r = \system($command, $kept);
}

