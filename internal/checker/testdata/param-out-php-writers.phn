    takesStd($errors); // want P2103 "mixed given"
    $r = \Uri\WhatWg\Url::parse($uri, $baseUrl, $held); // want P2213 "writes mixed"
    $r = \Uri\WhatWg\Url::parse($uri, $baseUrl, $kept);
}

/**
 * @param-out \stdClass $held
 * @param-out mixed $kept
 */
function afterUrlConstruct(string $uri, ?\Uri\WhatWg\Url $baseUrl, mixed &$held, mixed &$kept): void
{
    $r = new \Uri\WhatWg\Url($uri, $baseUrl, $softErrors);
    takesStd($softErrors); // want P2103 "mixed given"
    $r = new \Uri\WhatWg\Url($uri, $baseUrl, $held); // want P2213 "writes mixed"
    $r = new \Uri\WhatWg\Url($uri, $baseUrl, $kept);
}

/**
 * @param-out \stdClass $held
 * @param-out mixed $kept
 */
function afterUrlResolve(\Uri\WhatWg\Url $object, string $uri, mixed &$held, mixed &$kept): void
{
    $r = $object->resolve($uri, $softErrors);
    takesStd($softErrors); // want P2103 "mixed given"
    $r = $object->resolve($uri, $held); // want P2213 "writes mixed"
    $r = $object->resolve($uri, $kept);
}

/**
 * @param-out \stdClass $held
 * @param-out null $kept
 */
function afterSodiumMemzero(string $secret, string &$held, string &$kept): void
{
    \sodium_memzero($secret);
    takesStd($secret); // want P2103 "null given"
    \sodium_memzero($held); // want P2213 "writes null"
    \sodium_memzero($kept);
}

/**
 * @param-out \stdClass $held
 * @param-out mixed $kept
 */
function afterOpensslRandomPseudoBytes(int $length, mixed &$held, mixed &$kept): void
{
    $r = \openssl_random_pseudo_bytes($length, $strong);
    takesStd($strong); // want P2103 "mixed given"
    $r = \openssl_random_pseudo_bytes($length, $held); // want P2213 "writes mixed"
    $r = \openssl_random_pseudo_bytes($length, $kept);
}

// ---- writes back through a parameter PHPStan's map says the function reads

/**
 * array_splice() leaves what PHPStan's spliceArray() makes of the array:
 * a shape spliced at constant offsets keeps its entries, the int keys
 * renumbered; any other array keeps the union of its keys and values, a
 * list where every key was an int.
 *
 * @param list<int> $list
 * @param non-empty-list<int> $nonEmpty
 * @param array<string, int> $map
 * @param array{a: int, b: string} $shape
 * @param list<string> $strings
 */
function splices(array $list, array $nonEmpty, array $map, array $shape, array $strings, int $at): void
{
    $removed = $list;
    \array_splice($removed, 0, 1);
    takesStd($removed); // want P2103 "list<int> given"
    $inserted = $list;
    \array_splice($inserted, 1, 0, ['x']);
    takesStd($inserted); // want P2103 "non-empty-list<int|'x'> given"
    $replaced = $list;
    \array_splice($replaced, $at, null, $strings);
    takesStd($replaced); // want P2103 "list<int|string> given"
    $emptied = $nonEmpty;
    \array_splice($emptied, 0);
    takesStd($emptied); // want P2103 "array{} given"
    $keyed = $map;
    \array_splice($keyed, 0, 1, [1.5]);
    takesStd($keyed); // want P2103 "non-empty-array<0|string, int|1.5> given"
    $shaped = $shape;
    \array_splice($shaped, 1, 1, [true]);
    takesStd($shaped); // want P2103 "array{a: int, 0: true} given"
    $tuple = [1, 2, 3];
    \array_splice($tuple, 1, 1);
    takesStd($tuple); // want P2103 "list{1, 3} given"
}

/**
 * @param list<int> $xs
 * @param-out list<int> $xs
 */
function splicesInAnother(array &$xs): void
{
    \array_splice($xs, 1, 0, ['x']); // want P2213 "writes non-empty-list<int|'x'>"
}

/**
 * @param list<int> $xs
 * @param-out list<int> $xs
 */
function splicesAsDocumented(array &$xs): void
{
    \array_splice($xs, 0, 1);
}

/**
 * array_walk() whose callback is a closure written at the call that takes
 * the value by reference: each value is what the closure leaves in it, at
 * its returns and its end. Any other callback writes nothing back PHPStan
 * follows, nor does array_walk_recursive().
 *
 * @param list<int> $list
 * @param array{a: int, b: string} $shape
 * @param non-empty-array<string, int> $map
 */
function walks(array $list, array $shape, array $map, bool $skip): void
{
    $strings = $list;
    \array_walk($strings, function (int &$value): void {
        $value = (string) $value;
    });
    takesStd($strings); // want P2103 "list<decimal-int-string> given"
    $flags = $shape;
    \array_walk($flags, function (&$value): void {
        $value = true;
    });
    takesStd($flags); // want P2103 "array{a: true, b: true} given"
    $some = $map;
    \array_walk($some, function (int &$value) use ($skip): void {
        if ($skip) {
            return;
        }
        $value = 'x';
    });
    takesStd($some); // want P2103 "non-empty-array<string, int|'x'> given"
    $arrow = $list;
    \array_walk($arrow, fn (int &$value) => $value = 'y');
    takesStd($arrow); // want P2103 "list<int> given"
    $nested = $list;
    \array_walk_recursive($nested, function (mixed &$value): void {
        $value = 'z';
    });
    takesStd($nested); // want P2103 "list<int> given"
}

/**
 * @param list<int> $xs
 * @param-out list<int> $xs
 */
function walksInAnother(array &$xs): void
{
    \array_walk($xs, function (int &$value): void { // want P2213 "writes list<decimal-int-string>"
        $value = (string) $value;
    });
}

/**
 * @param list<int> $xs
 * @param-out list<int> $xs
 */
function walksAsDocumented(array &$xs): void
{
    \array_walk($xs, function (int &$value): void {
        $value *= 2;
    });
}

/**
 * A sort that keeps the keys leaves a list an array of int<0, max> keys;
 * sort() keeps a non-empty array non-empty.
 *
 * @param list<int> $list
 * @param non-empty-list<int> $nonEmpty
 * @param non-empty-array<string, int> $map
 */
function sorts(array $list, array $nonEmpty, array $map): void
{
    $byValue = $list;
    \asort($byValue);
    takesStd($byValue); // want P2103 "array<int<0, max>, int> given"
    $byCallback = $nonEmpty;
    \uasort($byCallback, fn (int $a, int $b): int => $a <=> $b);
    takesStd($byCallback); // want P2103 "non-empty-array<int<0, max>, int> given"
    $byKey = $map;
    \uksort($byKey, fn (string $a, string $b): int => \strcmp($a, $b));
    takesStd($byKey); // want P2103 "non-empty-array<string, int> given"
    $sorted = $map;
    \sort($sorted);
    takesStd($sorted); // want P2103 "non-empty-list<int> given"
}

/**
 * @param list<int> $xs
 * @param-out list<int> $xs
 */
function uasortsAList(array &$xs): void
{
    \uasort($xs, fn (int $a, int $b): int => $a <=> $b); // want P2213 "writes array<int<0, max>, int>"
}

/**
 * A closure that also uses a variable by reference runs to a fixed point
 * for it; each run is a call of its own, which starts from the closure's
 * parameters, and only what it uses by reference carries over.
 *
 * @param list<string> $names
 * @param array<string, string> $env
 * @return array<string, int>
 */
function walksWithAByReferenceUse(array $names, array $env): array
{
    $keys = [];
    \array_walk($names, function (&$name, $key) use (&$keys): void {
        $keys[] = $key;
        $name = ['name' => $name];
    });
    takesStd($names); // want P2103 "list<array{name: string}> given"
    $total = 0;
    \array_walk($env, function (&$value) use (&$total): void {
        $total += \strlen($value);
        $value = \strlen($value);
    });
    return $env;
}

function countsItsCalls(): int
{
    $calls = 0;
    $length = function (string $text) use (&$calls): int {
        $calls++;
        $size = \strlen($text);
        $text = $size;
        return $text;
    };
    return $length('a') + $calls;
}

function fail(string $message): never
{
    throw new \RuntimeException($message);
}

/**
 * A statement that does not go on, a throw or a call of a never function,
 * is an exit of the closure, as a return is: the value it leaves there is
 * one the array may hold.
 *
 * @param list<string> $ids
 * @return list<int>
 */
function walksToInts(array $ids): array
{
    \array_walk($ids, function (&$id): void {
        if (!\ctype_digit($id)) {
            throw new \InvalidArgumentException($id);
        }
        $id = (int) $id;
    });
    return $ids; // want P2202 "returns list<int|string>"
}

/**
 * @param list<string> $ids
 * @return list<int>
 */
function walksToIntsOrFails(array $ids): array
{
    \array_walk($ids, function (&$id): void {
        if ($id === '') {
            fail('empty');
        }
        $id = \strlen($id);
    });
    return $ids; // want P2202 "returns list<int<0, max>|''>"
}

/**
 * array_splice() reads an offset and a length past the end as PHP does:
 * the rest is removed, the replacement goes at the end, where PHPStan
 * leaves it out.
 */
function splicesPastTheEnd(): void
{
    $rest = ['a', 'b', 'c'];
    \array_splice($rest, 1, \PHP_INT_MAX);
    takesStd($rest); // want P2103 "list{'a'} given"
    $appended = ['a', 'b', 'c'];
    \array_splice($appended, \PHP_INT_MAX, 0, ['x']);
    takesStd($appended); // want P2103 "list{'a', 'b', 'c', 'x'} given"
    $after = ['a', 'b', 'c'];
    \array_splice($after, 5, 0, ['x']);
    takesStd($after); // want P2103 "list{'a', 'b', 'c', 'x'} given"
}

/**
 * array_pop() and array_shift() keep the keys; a shape loses its last
 * entry or its first, array_shift() renumbering the int keys.
 *
 * @param array<string, int> $map
 * @param array{a: int, b: string} $shape
 * @param list{int, string} $pair
 */
function pops(array $map, array $shape, array $pair): void
{
    $popped = $map;
    \array_pop($popped);
    takesStd($popped); // want P2103 "array<string, int> given"
    $last = $shape;
    \array_pop($last);
    takesStd($last); // want P2103 "array{a: int} given"
    $first = $pair;
    \array_shift($first);
    takesStd($first); // want P2103 "list{string} given"
}

/** @param int<0, max> $count */
function takesCount(int $count): void
{
}

/**
 * preg_replace() and preg_replace_callback() count what they replaced.
 *
 * @param-out int<0, max> $count
 */
function replaces(string $subject, ?int &$count = null): string
{
    $replaced = \preg_replace('/a/', 'b', $subject, -1, $times);
    takesCount($times);
    $called = \preg_replace_callback('/a/', fn (array $m): string => 'b', $subject, -1, $count);
    return ($replaced ?? '') . ($called ?? '');
}

/**
 * @param array<int, string> $queue
 * @param non-empty-list<int> $stack
 * @param array<string, int> $counts
 * @param array{a: int, 5: string, b: bool} $mixed
 */
function popsAndShifts(array $queue, array $stack, array $counts, array $mixed): void
{
    $popped = $queue;
    \array_pop($popped);
    takesStd($popped); // want P2103 "array<int, string> given"
    $shorter = $stack;
    \array_pop($shorter);
    takesStd($shorter); // want P2103 "list<int> given"
    $rest = $counts;
    \array_shift($rest);
    takesStd($rest); // want P2103 "array<string, int> given"
    $renumbered = $mixed;
    \array_shift($renumbered);
    takesStd($renumbered); // want P2103 "array{0: string, b: bool} given"
}

/**
 * @param array<int, string> $queue
 * @param-out array<int, string> $queue
 */
function popsAsDocumented(array &$queue): ?string
{
    return \array_pop($queue);
}

/**
 * @param array<int, string> $queue
 * @param-out list<string> $queue
 */
function shiftsAMap(array &$queue): ?string
{
    return \array_shift($queue); // want P2213 "writes array<int, string>"
}

/**
 * preg_match() keys a group by its number, and by its name where it has
 * one; a verb with a name, (*MARK:x), adds the key 'MARK'. A pattern
 * written at the call with neither, under flags known there, leaves the
 * groups numbered without a gap, a list, as PHPStan, which reads the
 * pattern, has it. A double-quoted pattern may spell its name with an
 * escape PHP decodes, and keeps both keys; a single-quoted one leaves
 * \x3F to PCRE, a literal question mark.
 *
 * @param list<string> $list
 */
function takesList(array $list): void
{
}

/** @param 0|256 $flags */
function matchesGroups(string $subject, string $pattern, int $flags): void
{
    \preg_match('/^(\d+)-(\d+)$/', $subject, $numbered);
    takesStd($numbered); // want P2103 "list<string> given"
    takesList($numbered);
    \preg_match('/^(?<year>\d+)-(\d+)$/', $subject, $named);
    takesStd($named); // want P2103 "array<string> given"
    \preg_match('/a(*MARK:first)|b(*MARK:second)/', $subject, $marked);
    takesStd($marked); // want P2103 "array<string> given"
    $mark = $marked['MARK'] ?? '';
    \preg_match("/(\x3F<year>\\d{4})/", $subject, $escaped);
    takesStd($escaped); // want P2103 "array<string> given"
    \preg_match('/(\x3F<year>\d{4})/', $subject, $literal);
    takesStd($literal); // want P2103 "list<string> given"
    \preg_match($pattern, $subject, $unknown);
    takesStd($unknown); // want P2103 "array<string> given"
    \preg_match('/(\d)/', $subject, $unknownFlags, $flags);
    takesStd($unknownFlags); // want P2103 "array<string> given"
    \preg_match('/(\d)/', $subject, $offsets, 256);
    takesStd($offsets); // want P2103 "list<list{string, int}> given"
    $setOrder = \PREG_SET_ORDER;
    \preg_match_all('/(\d+)-(\d+)/', $subject, $sets, $setOrder);
    takesStd($sets); // want P2103 "list<list<string>> given"
}

function checked(int $n): int
{
    return $n;
}

/**
 * A throw statement in a try statement's body or catch blocks is no exit
 * of the closure, whether a catch takes it or not, as PHPStan has it; an
 * exit or a call of a never function there is one.
 *
 * @param list<string> $raw
 */
function walksWithACatch(array $raw): void
{
    $decoded = $raw;
    \array_walk($decoded, function (&$value): void {
        try {
            $value = \json_decode($value, flags: \JSON_THROW_ON_ERROR);
            if (!\is_string($value)) {
                throw new \UnexpectedValueException();
            }
        } catch (\JsonException|\UnexpectedValueException) {
            $value = '';
        }
    });
    takesList($decoded);
    $counted = $raw;
    \array_walk($counted, function (&$value): void {
        try {
            if ($value === '') {
                throw new \LogicException();
            }
            $value = checked(1);
        } catch (\RuntimeException) {
            $value = 1;
        }
    });
    takesStd($counted); // want P2103 "list<int> given"
    $failing = $raw;
    \array_walk($failing, function (&$value): void {
        try {
            if ($value === '') {
                fail('empty');
            }
            $value = 1;
        } catch (\LogicException) {
            $value = 2;
        }
    });
    takesStd($failing); // want P2103 "list<int<1, 2>|''> given"
}

/**
 * @param array<int, string> $m
 * @param-out array<int, string> $m
 */
function matchesNumbered(string $s, array &$m): bool
{
    return \preg_match('/^(\d+)-(\d+)$/', $s, $m) === 1;
}

/**
 * @param array<int, string> $m
 * @param-out array<int, string> $m
 */
function matchesNamed(string $s, array &$m): bool
{
    return \preg_match('/^(?<year>\d+)$/', $s, $m) === 1; // want P2213 "writes array<string>"
}

/**
 * A finally block runs on the way out of an exit in its try statement:
 * what the exit leaves is what the block writes, an enclosing block's
 * after an inner one's.
 *
 * @param list<string> $raw
 */
function walksThroughAFinally(array $raw): void
{
    $lengths = $raw;
    \array_walk($lengths, function (&$value): void {
        try {
            if ($value === '') {
                fail('empty');
            }
            $value = \strlen($value);
        } finally {
            $value = (int) $value;
        }
    });
    takesStd($lengths); // want P2103 "list<int> given"
    $nested = $raw;
    \array_walk($nested, function (&$value): void {
        try {
            try {
                if ($value === '') {
                    return;
                }
                $value = 1;
            } finally {
                $value = 2;
            }
        } finally {
            $value = 3;
        }
    });
    takesStd($nested); // want P2103 "list<3> given"
    $wrapped = $raw;
    \array_walk($wrapped, function (&$value): void {
        try {
            if ($value === '') {
                (throw new \LogicException());
            }
            $value = 4;
        } catch (\LogicException) {
            $value = 5;
        }
    });
    takesStd($wrapped); // want P2103 "list<int<4, 5>> given"
}

/**
 * PREG_UNMATCHED_AS_NULL makes a group that took no part in the match
 * null; which may not is the pattern's, so every value may be null.
 */
function matchesUnmatchedAsNull(string $subject): void
{
    \preg_match('/(a)(b)?/', $subject, $groups, \PREG_UNMATCHED_AS_NULL);
    takesStd($groups); // want P2103 "list<string|null> given"
    \preg_match('/(a)(b)?/', $subject, $offsets, \PREG_UNMATCHED_AS_NULL | \PREG_OFFSET_CAPTURE);
    takesStd($offsets); // want P2103 "list<list{string|null, int}> given"
    \preg_match_all('/(a)(b)?/', $subject, $all, \PREG_UNMATCHED_AS_NULL);
    takesStd($all); // want P2103 "list<list<string|null>> given"
    \preg_match_all('/(a)(b)?/', $subject, $sets, \PREG_UNMATCHED_AS_NULL | \PREG_SET_ORDER);
    takesStd($sets); // want P2103 "list<list<string|null>> given"
    if (\preg_match('/(a)(b)?/', $subject, $m, \PREG_UNMATCHED_AS_NULL) === 1) {
        takesString($m[2]); // want P2103 "string|null given"
    }
}

function takesString(string $s): void
{
}

// ---- parameters PHPStan's map says the function reads: no write

/**
 * The argument keeps its type, and a parameter documented @param-out
 * passed there is held where the body ends.
 */
function reads(\IntlDateFormatter $formatter, string $text): void
{
    $offset = 0;
    \datefmt_parse($formatter, $text, $offset);
    takesStd($offset); // want P2103 "0 given"
}

/**
 * @param-out positive-int $offset
 */
function parsesFrom(\IntlDateFormatter $formatter, string $text, int &$offset): void
{
    \datefmt_parse($formatter, $text, $offset); // want P2213 "ends here with $offset holding int"
}

/**
 * @param-out int $offset
 */
function parsesAsDocumented(\IntlDateFormatter $formatter, string $text, int &$offset): void
{
    \datefmt_parse($formatter, $text, $offset);
}

/**
 * @param list<string> $words
 * @param-out list<string> $words
 */
function collates(\Collator $collator, array &$words): void
{
    \collator_sort($collator, $words);
}

/**
 * A function with side effects that reads the argument, given one that may
 * be an object or a resource: PHPStan invalidates it and holds the
 * parameter to nothing, as it does after settype().
 *
 * @param-out list<string> $value
 */
function binds(\mysqli_stmt $statement, mixed &$value): void
{
    \mysqli_stmt_bind_param($statement, 's', $value);
}

/**
 * @param-out list<string> $value
 */
function bindsAString(\mysqli_stmt $statement, string &$value): void
{
    \mysqli_stmt_bind_param($statement, 's', $value); // want P2213 "ends here with $value holding string"
}
