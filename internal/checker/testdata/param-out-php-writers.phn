}

/**
 * The tag of an AEAD cipher, as PHPStan's extension types it from a cipher
 * named at the call; any other cipher leaves null.
 *
 * @param-out \stdClass $held
 * @param-out non-empty-string|null $kept
 */
function afterOpensslEncrypt(string $data, string $cipher, string $passphrase, string $iv, mixed &$held, mixed &$kept): void
{
    $r = \openssl_encrypt($data, 'aes-256-gcm', $passphrase, \OPENSSL_RAW_DATA, $iv, $gcm);
    takesStd($gcm); // want P2103 "non-empty-string given"
    $r = \openssl_encrypt($data, 'AES-128-CCM', $passphrase, \OPENSSL_RAW_DATA, $iv, $ccm);
    takesStd($ccm); // want P2103 "non-empty-string given"
    $r = \openssl_encrypt($data, 'aes-256-cbc', $passphrase, \OPENSSL_RAW_DATA, $iv, $none);
    takesStd($none); // want P2103 "null given"
    $r = \openssl_encrypt($data, $cipher, $passphrase, \OPENSSL_RAW_DATA, $iv, $tag);
    takesStd($tag); // want P2103 "non-empty-string|null given"
    $r = \openssl_encrypt($data, $cipher, $passphrase, \OPENSSL_RAW_DATA, $iv, $held); // want P2213 "writes non-empty-string|null"
    $r = \openssl_encrypt($data, $cipher, $passphrase, \OPENSSL_RAW_DATA, $iv, $kept);
}

