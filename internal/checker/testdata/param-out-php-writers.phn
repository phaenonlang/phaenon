/**
 * @param-out \stdClass $held
 * @param-out mixed $kept
 */
function afterSocketRecvfrom(\Socket $socket, int $length, int $flags, mixed &$held, mixed &$kept): void
{
    $r = \socket_recvfrom($socket, $data, $length, $flags, $address, $port);
    takesStd($data); // want P2103 "mixed given"
    takesStd($address); // want P2103 "mixed given"
    takesStd($port); // want P2103 "mixed given"
    $r = \socket_recvfrom($socket, $held, $length, $flags, $address, $port); // want P2213 "writes mixed"
    $r = \socket_recvfrom($socket, $kept, $length, $flags, $address, $port);
}

