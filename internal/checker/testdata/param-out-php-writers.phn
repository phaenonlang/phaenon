/**
 * @param-out \stdClass $held
 * @param-out callable-string $kept
 */
function afterIsCallable(mixed $value, bool $syntax_only, mixed &$held, mixed &$kept): void
{
    $r = \is_callable($value, $syntax_only, $callable_name);
    takesStd($callable_name); // want P2103 "callable-string given"
    $r = \is_callable($value, $syntax_only, $held); // want P2213 "writes callable-string"
    $r = \is_callable($value, $syntax_only, $kept);
}

/**
 * @param array<string, int> $map
 * @param non-empty-list<int> $nonEmpty
 * @param array{a: int, b: string} $shape
 * @param array<string, int> $held
 * @param array<string, int> $kept
 * @param-out \stdClass $held
 * @param-out list<int> $kept
 */
function afterShuffle(array $map, array $nonEmpty, array $shape, array &$held, array &$kept): void
{
    $r = \shuffle($map);
    takesStd($map); // want P2103 "list<int> given"
    $r = \shuffle($nonEmpty);
    takesStd($nonEmpty); // want P2103 "non-empty-list<int> given"
    $r = \shuffle($shape);
    takesStd($shape); // want P2103 "non-empty-list<int|string> given"
    $r = \shuffle($held); // want P2213 "writes list<int>"
    $r = \shuffle($kept);
}

/**
