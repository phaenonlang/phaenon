/**
 * @param-out \stdClass $held
 * @param-out mixed $kept
 */
function afterLdapParseResult(\LDAP\Connection $ldap, \LDAP\Result $result, mixed &$held, mixed &$kept): void
{
    $r = \ldap_parse_result($ldap, $result, $error_code, $matched_dn, $error_message, $referrals, $controls);
    takesStd($error_code); // want P2103 "mixed given"
    takesStd($matched_dn); // want P2103 "mixed given"
    takesStd($error_message); // want P2103 "mixed given"
    takesStd($referrals); // want P2103 "mixed given"
    takesStd($controls); // want P2103 "mixed given"
    $r = \ldap_parse_result($ldap, $result, $held, $matched_dn, $error_message, $referrals, $controls); // want P2213 "writes mixed"
    $r = \ldap_parse_result($ldap, $result, $kept, $matched_dn, $error_message, $referrals, $controls);
}

/**
 * @param list<array<string, mixed>>|null $controls
 * @param-out \stdClass $held
 * @param-out mixed $kept
 */
function afterLdapExop(\LDAP\Connection $ldap, string $request_oid, ?string $request_data, ?array $controls, mixed &$held, mixed &$kept): void
{
    $r = \ldap_exop($ldap, $request_oid, $request_data, $controls, $response_data, $response_oid);
    takesStd($response_data); // want P2103 "mixed given"
    takesStd($response_oid); // want P2103 "mixed given"
    $r = \ldap_exop($ldap, $request_oid, $request_data, $controls, $held, $response_oid); // want P2213 "writes mixed"
    $r = \ldap_exop($ldap, $request_oid, $request_data, $controls, $kept, $response_oid);
}

