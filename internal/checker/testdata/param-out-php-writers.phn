/**
 * @param-out \stdClass $held
 * @param-out array<int|string, array<mixed>|string> $kept
 */
function afterParseStr(string $string, mixed &$held, mixed &$kept): void
{
    \parse_str($string, $result);
    takesStd($result); // want P2103 "array<string|array> given"
    \parse_str('a=b', $lower);
    takesStd($lower); // want P2103 "array<lowercase-string|array> given"
    \parse_str($string, $held); // want P2213 "writes array<string|array>"
    \parse_str($string, $kept);
}

