namespace Cli;

// Checker gaps the tq-cli dogfood found (2026-11-02), one function each:
// stdlib declarations PHPStan has, flow the checker lost through closures,
// loops and narrowings PHPStan keeps.

function takesString(string $s): void
{
}

function takesInt(int $i): void
{
}

function sink(mixed $m): void
{
}

/**
 * An archive entry is a PharFileInfo (chmod() lives there); a list's
 * array_search() answers its int key or false, never a string.
 *
 * @param list<string> $command
 */
function archiveEntries(array $command, string $name): void
{
    $tar = new \PharData('/tmp/p.tar');
    $tar->addFromString('a.txt', 'x');
    $tar['a.txt']->chmod(0o644);
    $k = array_search($name, $command, true);
    takesInt($k); // want P2103
    takesString($command[$k + 1]);
}
