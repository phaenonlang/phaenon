namespace Bin;

// bytes: binary data kept apart from text (design/strings.md §2, §5, §6).
// The overlay types PHP's producers and consumers, (bytes) retypes a
// string, (string) is the unchecked way back, `as string` is the checked
// one, and text never mixes with binary silently.

function takesString(string $s): void
{
}

function takesBytes(bytes $b): void
{
}

function takesInt(int $i): void
{
}

/** @param \Closure(int): bytes $draw */
function takesDraw(\Closure $draw): void
{
}

function producers(int $n): void
{
    $key = random_bytes(32);
    random_bytes($n); // want P2103
    if ($n > 0) {
        takesBytes(random_bytes($n));
    }
    takesDraw(random_bytes(...)); // want P2103
    takesBytes($key);
    takesString($key); // want P2103
    takesBytes(hash('sha256', 'abc', true));
    takesString(hash('sha256', 'abc'));
    takesBytes(hash('sha256', 'abc')); // want P2103
    takesBytes(pack('N', 1));
    takesBytes(hash_hmac('sha256', $key, $key, true));
    takesString(bin2hex($key));
    takesString(base64_encode($key));
    takesInt(strlen($key));
    takesBytes(substr($key, 0, 4));
    takesString(substr('text', 0, 2));
    takesBytes(substr('text', 0, 2)); // want P2103
}

function text(bytes $raw, string $name): void
{
    takesString("hello $raw"); // want P2530 "`as string` checks it is UTF-8"
    takesString('x' . $raw); // want P2530 "`as string` checks bytes are UTF-8 text"
    $s = 'id-';
    $s .= $raw; // want P2530
    takesString((string) $raw);
    takesBytes((bytes) $name);
    takesBytes((bytes) 42); // want P2309
    takesInt(strlen($raw));
    takesBytes(substr($raw, 0, 16));
    takesInt(ord($raw[0]));
    takesBytes($raw . (bytes) $name);
    $raw->upper(); // want P2105 "cannot call method upper() on bytes"
    $buf = (bytes) '';
    $buf .= $raw . $name->bytes(); // want P2105 "cannot call method bytes() on string"
    takesBytes($buf);
}

final class Frame
{
    public bytes $buf;

    /** @var list<bytes> */
    public array $parts = [];

    public function __construct()
    {
        $this->buf = (bytes) '';
    }

    public function append(bytes $chunk, string $label): void
    {
        $this->buf .= $chunk;
        $this->buf .= $label; // want P2530
        $this->parts[0] .= $chunk;
        takesBytes($this->parts[0]);
    }
}

// `.` joins two values of the same kind (strings.md §2, 2026-11-02): binary
// joined to binary stays binary, binary mixed into text is the finding.
function concatenation(bytes $a, bytes $b, string $s, ?bytes $maybe): void
{
    takesBytes($a . $b);
    takesString($a . $b); // want P2103
    $buf = (bytes) '';
    $buf .= $a;
    $buf .= $b . $a;
    takesBytes($buf);
    $mixed = $a . $s; // want P2530
    $mixed2 = $s . $b; // want P2530
    $text = '';
    $text .= $a; // want P2530
    takesBytes('' . $a); // want P2530
    $interpolated = "$a"; // want P2530
    takesBytes($a . 5); // want P2530
    if ($maybe !== null) {
        takesBytes($maybe . $a);
    }
}

function inlineVar(string $text): void
{
    /** @var bytes $raw */
    $raw = random_bytes(4);
    takesBytes($raw);
    /** @var bytes $retyped */
    $retyped = strtoupper($text); // want P2212
}

// PHP's own functions are the conversions between bytes and text, typed
// for bytes by the overlay (strings.md §6).
function decoding(string $hex, string $b64, bytes $raw): void
{
    takesBytes(hex2bin($hex) ?: throw new \ValueError('not hex'));
    takesString(hex2bin($hex) ?: ''); // want P2103
    // base64 carries text as often as binary: PHP's string, which
    // (bytes) retypes; only the strict mode returns false.
    takesString(base64_decode($b64));
    takesString(base64_decode($b64, true) ?: '');
    takesString(base64_decode($b64, true)); // want P2103 "false|string given"
    takesBytes((bytes) base64_decode($b64));
    takesBytes(base64_decode($b64)); // want P2103 "string given"
    takesString(bin2hex($raw));
    takesString(base64_encode($raw));
    takesString(mb_scrub($raw, 'UTF-8'));
    takesString(mb_scrub($hex));
    takesBytes(mb_scrub($raw)); // want P2103
    takesString(strtoupper($raw)); // want P2103
    takesBool(mb_check_encoding($raw, 'UTF-8'));
    takesBool(hash_equals($raw, $raw));
    takesBool(hash_equals($hex, $raw));
    takesInt(openssl_verify($hex, $raw, $hex, \OPENSSL_ALGO_SHA256) ?: 0);
    takesInt(openssl_verify($raw, base64_decode($b64), $hex, \OPENSSL_ALGO_SHA256) ?: 0);
}

function takesBool(bool $b): void
{
}

// `as string` is the checked conversion to text: the UTF-8 test, a
// ValueError when it fails; `as?` gives null and `is string` the test
// alone. What passes is a string, what fails stays bytes.
function conversions(bytes $raw, bytes $data, ?bytes $maybe, ?bytes $absent, int|bytes $either, bytes $payload): void
{
    takesString($raw as? string ?? '');
    if ($raw is string) {
        takesString($raw);
        takesBytes($raw); // want P2103 "string given"
    } else {
        takesBytes($raw);
        takesString($raw); // want P2103 "bytes given"
    }
    takesBytes($raw); // the test changed no value: where the branches meet, the bytes are bytes
    $text = $data as string;
    takesString($text);
    takesBytes($data); // the conversion types its result: $data is the same bytes
    takesString($data); // want P2103 "bytes given"
    if ($maybe is string) {
        takesString($maybe);
    } else {
        takesString($maybe); // want P2103 "null|bytes given"
    }
    if ($absent is string|null) {
        takesString($absent ?? '');
    } else {
        takesBytes($absent);
    }
    if ($either is int|string) {
        takesString((string) $either);
    }
    takesString($payload as? string); // want P2103 "string|null given"
}

// Nor does a loop that comes round again, or a property: what a UTF-8 test
// let through as text is the same bytes after it.
function rejoined(list<bytes> $chunks, bytes $raw, Frame $frame): int
{
    $n = 0;
    foreach ($chunks as $chunk) {
        if ($raw is string) {
            $n += \strlen(takesText($raw));
        }
        $n += \strlen($chunk) + \strlen(takesText($raw as string));
    }
    takesBytes($raw);
    if ($frame->buf is string) {
        $n += \strlen(takesText($frame->buf));
    }
    takesBytes($frame->buf);
    $raw = 'now text';
    if ($n > 0) {
        $raw = (bytes) 'binary';
    }
    takesBytes($raw); // want P2103 "'now text'|bytes given"

    return $n;
}

function takesText(string $s): string
{
    return $s;
}

function nullable(?bytes $maybe): string
{
    $text = $maybe as string;
    takesBytes($maybe); // `as` threw on null: what is left is the bytes

    return $text;
}

function either(int|bytes $either): string
{
    return $either as string;
}

function converted(bytes $raw): bytes
{
    takesString(random_bytes(4) as string); // want P3012 "the operand of `as` is evaluated twice"
    takesBool(random_bytes(4) is string); // one call: the UTF-8 test reads it once

    return $raw;
}

type Blob = string|bytes;

// PHP cannot tell bytes from string at runtime: `is bytes`, and `is string`
// on a value that may be either, have no test (P3011, generics.md §11.4).
function untestable(mixed $m, string $s, bytes $b, string|bytes $either, (Blob, int) $pair): void
{
    takesBool($m is bytes); // want P3011 "`bytes` cannot be tested at runtime: PHP cannot tell bytes from string; (bytes) retypes a string"
    takesBool($s is bytes); // want P3011
    takesBool($b is bytes); // want P3011
    takesBool($m is ?bytes); // want P3011
    takesBytes($m as bytes); // want P3011
    takesBool($either is string); // want P3011 "`string` cannot be tested at runtime on string|bytes: PHP cannot tell bytes from string"
    takesString($either as string); // want P3011
    takesBool($pair is (string, int)); // want P3011 "on string|bytes"
    takesBool($either is int); // want P2306 "string|bytes is never int"
}

function equality(bytes $a, string $b, bytes $c): void
{
    if ($a === $b) { // want P2305
    }
    if ($a === $c) {
    }
    takesInt(hash_equals($a, $c)); // want P2103
}

function comparisons(bytes $a, bytes $b, array<mixed> $parts): void
{
    takesInt(strcmp($a, $b));
    takesInt(strncmp($a, 'abc', 3));
    takesString(base64_encode(json_encode($parts, JSON_THROW_ON_ERROR)));
    takesString(base64_encode(json_encode($parts, \JSON_UNESCAPED_SLASHES | \JSON_THROW_ON_ERROR)));
    takesString(base64_encode(json_encode($parts, flags: JSON_THROW_ON_ERROR)));
    takesString(base64_encode(json_encode($parts))); // want P2103
}

function compression(bytes $raw, string $text): void
{
    takesBytes(strrev($raw));
    takesString(strrev($text));
    takesBytes(gzencode($text) ?: throw new \RuntimeException('zlib'));
    takesString(gzencode($text) ?: throw new \RuntimeException('zlib')); // want P2103
    takesString(gzdecode($raw) ?: '');
    $deflate = deflate_init(\ZLIB_ENCODING_RAW) ?: throw new \RuntimeException('zlib');
    takesBytes(deflate_add($deflate, $raw, \ZLIB_FINISH) ?: throw new \RuntimeException('zlib'));
    $crc = hash_init('crc32b');
    hash_update($crc, $raw);
    hash_update($crc, $text);
    takesBytes(hash_final($crc, true));
    takesString(hash_final($crc));
    takesString(hash_final($crc, true)); // want P2103
}
