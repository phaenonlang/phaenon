/**
 * @template T of object
 */
abstract class BaseRepo
{
    /**
     * @param array<string, mixed> $d
     * @return T
     */
    protected function hydrate(array $d): object
    {
        throw new \LogicException('abstract in spirit');
    }
}

/**
 * @template T of object
 * @extends BaseRepo<T>
 */
abstract class EventRepo extends BaseRepo
{
    protected function hydrate(array $d): object
    {
        $e = parent::hydrate($d);

        return $e;
    }
}

final class Exported
{
    /** @var \ArrayObject<int, User> */
    private \ArrayObject $exported;

    public function __construct()
    {
        $this->exported = new \ArrayObject();
    }

    public function first(): ?User
    {
        foreach ($this->exported as $u) {
            return $u;
        }

        return null;
    }
}

