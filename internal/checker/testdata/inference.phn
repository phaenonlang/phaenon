/**
 * The closure sees its declared parameter type narrowed by what the caller passes.
 *
 * @param list<array{id: int, name: string}> $rows
 * @param list<class-string<User>> $classes
 */
function closureParams(array $rows, array $classes): void
{
    takesList(array_map(static fn (array $row): string => $row['name'], $rows));
    array_map(static fn (array $row): int => $row['id'] + 1, $rows);
    foreach (array_map(static fn (string $c): User => new $c('x'), $classes) as $u) {
        takesString($u->name);
    }
}

/**
 * A closure's body refines its declared return type.
 */
function closureReturns(): void
{
    $make = function (int $port) {
        $server = stream_socket_server('tcp://127.0.0.1:'.$port, $errno, $error);
        if (false === $server) {
            exit(1);
        }

        return $server;
    };
    $s = $make(0);
    fclose($s);
    $rows = array_map(static fn (int $n): array => ['n' => $n, 'label' => (string) $n], [1, 2]);
    takesInt($rows[0]['n']);
    takesString($rows[0]['label']);
}

function minMax(int $a, int $b, string $s, float $f): void
{
    takesInt(max(1, $a - $b));
    takesFloat(min(1.0, max(0.0, (float) $s)));
    takesNonNegative(max(0, \strlen($s) - 10));
    takesNonNegative(max(0, $a));
    takesFloat(max(0.0, $f));
}

function formats(string $s): void
{
    takesNonEmpty(sprintf('publish %s', $s));
    takesNonEmpty(sprintf('%s', $s)); // want P2103
}

