function byRefUse(): void
{
    $server = stream_socket_server('tcp://127.0.0.1:0', $errno, $error);
    if (false === $server) {
        return;
    }
    $drop = static function () use (&$server): void {
        if (null !== $server) {
            fclose($server);
            $server = null;
        }
    };
    $drop();
}

/**
 * @param list<array{command: Cmd<mixed>}> $pending
 * @param class-string<Cmd<mixed>> $class
 * @return list<array{command: Cmd<mixed>}>
 */
function instanceofVar(array $pending, string $class): array
{
    return array_values(array_filter($pending, static fn (array $d): bool => $d['command'] instanceof $class));
}

function staticPaths(string $audit): void
{
    Assert::assertTrue(null !== Holder::checker()->check($audit)?->nick);
    $check = Holder::checker()->check($audit);
    takesString($check->name);
}

