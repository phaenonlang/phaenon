final class Dispatcher
{
    /** @return list<callable> */
    public function listeners(): array
    {
        return [];
    }

    public function priority(callable $listener): int
    {
        return 0;
    }
}

function callableArrays(Dispatcher $d, User $u): int
{
    foreach ($d->listeners() as $listener) {
        if (\is_array($listener) && $listener[0] instanceof User) {
            return $d->priority($listener);
        }
    }

    return 0;
}

final class Locator
{
    public const EXCEPTION = 1;
    public const NULL_ON_INVALID = 2;

    /**
