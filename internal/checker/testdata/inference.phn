    takesObject($l->get('a'));
    takesObject($l->get('a', Locator::NULL_ON_INVALID)); // want P2103
}

/** @param \ReflectionClass<object> $r */
function reflects(\ReflectionClass $r): void
{
    if ($r->isSubclassOf(User::class)) {
        takesUserClass($r);
    }
}

