/**
 * @template T of Id
 */
abstract class Aggregate
{
    /**
     * @param T $id
     */
    final public function __construct(protected Id $id)
    {
    }

    final public static function make(Id $id): void
    {
        $self = new static($id);
        $self->touch();
    }

    /**
     * @param T $id
     */
    final public static function rebuild(Id $id): static
    {
        return new static($id);
    }

    public function touch(): void
    {
    }
}

/**
 * @template T of Aggregate<Id>
 */
abstract class Repo
{
    /**
     * @return class-string<T>
     */
    abstract protected static function aggregateClass(): string;

    /**
     * @return T
     */
    public function get(Id $id): Aggregate
    {
        $class = static::aggregateClass();

        return $class::rebuild($id);
    }
}

