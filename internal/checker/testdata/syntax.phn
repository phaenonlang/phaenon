namespace Gen;

class User
{
    public function __construct(public string $name = '')
    {
    }
}

final class Admin extends User
{
}

final class Order
{
}

function takesUser(User $u): void
{
}

function takesInt(int $i): void
{
}

function takesString(string $s): void
{
}

type UserList = list<User>;
type Pair<A, B = int> = map<A, B>;

final class Box<T>
{
    public function __construct(private T $value)
    {
    }

    public function get(): T
    {
        return $this->value;
    }

    public function map<U>(Closure(T): U $fn): Box<U>
    {
        return new Box($fn($this->value));
    }
}

interface Source<out T>
{
    public function next(): ?T;

    public function push(T $x): void; // want P3004
}

interface Sink<in T>
{
    public function put(T $x): void;

    public function last(): T; // want P3004
}

class Repository<reified T of User>
{
    public function get(int $id): T
    {
        $u = new User('x');
        if ($u is T) {
            return $u;
        }
        return new T('fresh');
    }

    public function name(): string
    {
        return T::class;
    }

    public function describe(): string
    {
        return T->name();
    }
}

final class UserRepository extends Repository<User>
{
}

final class BadRepository extends Repository<Order> // want P3002
{
}

final class UnboundRepository extends Repository // want P3005
{
}

interface Reified<reified T> // want P3006
{
}

final class Erased<T of User>
{
    public function make(): T
    {
        return new T(); // want P3003
    }

    public function test(mixed $x): bool
    {
        return $x is T; // want P3003
    }

    public static function create(T $x): void // want P3008
    {
    }
}

class Base<T>
{
    public function __construct(public T $value)
    {
    }
}

final class Child extends Base<int>
{
    public function __construct(public int $value) // want P3007
    {
        parent::__construct($value);
    }
}

function takeSource(Source<User> $s): void
{
}

function takeSink(Sink<Admin> $s): void
{
}

function mixedValue(): mixed
{
    return 1;
}

function first<T>(list<T> $items): ?T
{
    return $items[0] ?? null;
}

function nonGeneric(): User
{
    return new User();
}

function uses(Box<int> $ints, Box<User> $users, Source<Admin> $admins, Sink<User> $sink, UserList $list, Pair<string> $pair): void
{
    takesInt($ints->get());
    takesString($ints->get()); // want P2103
    takesUser($users->get());
    $names = $users->map(fn(User $u): string => $u->name);
    takesString($names->get());
    takesInt($names->get()); // want P2103

    takeSource($admins);
    takeSink($sink);
    takeSource($sink); // want P2103

    takesUser($list[0]);
    takesInt($pair['x']);
    takesString($pair['x']); // want P2103

    $b = new Box<int>(1);
    takesInt($b->get());
    $c = new Box<string>(1); // want P2103
    $r = new Repository<User>();
    takesUser($r->get(1));
    $x = new Repository<Order>(); // want P3002
    $e = new Repository(); // want P3005
    $w = new Box<int, int>(1); // want P3001

    $m = mixedValue();
    $v = $m;
    if ($v is int) {
        takesInt($v);
    }
    if ($m is list<int>) {
        takesInt($m[0]);
    }
    $s = $m as string;
    takesString($s);
    $n = $m as? User;
    takesUser($n); // want P2103
    $i = first<int>([1, 2]);
    takesInt($i ?? 0);
    first<int, string>([1]); // want P3001
    takesUser(nonGeneric<int>()); // want P3009
    takesString(first([1])); // want P2103
}
