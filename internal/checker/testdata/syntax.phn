namespace Gen;

class User
{
    public function __construct(public string $name = '')
    {
    }
}

final class Admin extends User
{
}

final class Order
{
}

function takesUser(User $u): void
{
}

function takesInt(int $i): void
{
}

function takesString(string $s): void
{
}

type UserList = list<User>;
type Pair<A, B = int> = map<A, B>;

final class Box<T>
{
    public function __construct(private T $value)
    {
    }

    public function get(): T
    {
        return $this->value;
    }

    public function map<U>(Closure(T): U $fn): Box<U>
    {
        return new Box($fn($this->value));
    }
}

interface Source<out T>
{
    public function next(): ?T;

    public function push(T $x): void; // want P3004
}

interface Sink<in T>
{
    public function put(T $x): void;

    public function last(): T; // want P3004
}

// A type parameter has no runtime value; a class<T> value does. This is
// how runtime generics are written (design/generics.md §11.2).
class Repository<T of User>
{
    public function __construct(private readonly class<T> $class)
    {
    }

    public function get(int $id): T
    {
        $u = new User('x');
        if ($u instanceof $this->class) {
            return $u;
        }
        return new $this->class('fresh');
    }

    public function name(): string
    {
        return $this->class;
    }

    public function same(class<T> $other): bool
    {
        return $other === $this->class;
    }
}

final class UserRepository extends Repository<User>
{
    public function __construct()
    {
        parent::__construct(User::class);
    }
}

final class BadRepository extends Repository<Order> // want P3002
{
}

final class UnboundRepository extends Repository
{
}

function repositories(): void
{
    $r = new Repository(User::class);
    takesUser($r->get(1));
    takesString($r->name());
    takesInt($r->name()); // want P2103
    $r->same(Order::class); // want P2103
}

final class Erased<T of User>
{
    public function make(): T
    {
        return new T(); // want P3003
    }

    public function test(mixed $x): bool
    {
        return $x instanceof T; // want P3003
    }

    public static ?T $shared = null; // want P3008
}

// Late static binding carries T into a static method: the class<T> getter
// idiom of design/generics.md §11.2.
abstract class Keyed<T of User>
{
    abstract public static function model(): class<T>;

    public function make(): T
    {
        $class = static::model();
        return new $class();
    }
}

final class AdminKeyed extends Keyed<Admin>
{
    public static function model(): class<Admin>
    {
        return Admin::class;
    }
}

function keyed(AdminKeyed $k): void
{
    takesUser($k->make());
    takesString(AdminKeyed::model());
    takesInt(AdminKeyed::model()); // want P2103
}

class Base<T>
{
    public function __construct(public T $value)
    {
    }
}

final class Child extends Base<int>
{
    public function __construct(public int $value) // want P3007
    {
        parent::__construct($value);
    }
}

function takeSource(Source<User> $s): void
{
}

function takeSink(Sink<Admin> $s): void
{
}

function mixedValue(): mixed
{
    return 1;
}

function first<T>(list<T> $items): ?T
{
    return $items[0] ?? null;
}

function nonGeneric(): User
{
    return new User();
}

function uses(Box<int> $ints, Box<User> $users, Source<Admin> $admins, Sink<User> $sink, UserList $list, Pair<string> $pair): void
{
    takesInt($ints->get());
    takesString($ints->get()); // want P2103
    takesUser($users->get());
    $names = $users->map(fn(User $u): string => $u->name);
    takesString($names->get());
    takesInt($names->get()); // want P2103

    takeSource($admins);
    takeSink($sink);
    takeSource($sink); // want P2103

    takesUser($list[0]);
    takesInt($pair['x']);
    takesString($pair['x']); // want P2103

    $b = new Box<int>(1);
    takesInt($b->get());
    $c = new Box<string>(1); // want P2103
    $r = new Repository<User>(User::class);
    takesUser($r->get(1));
    $x = new Repository<Order>(Order::class); // want P3002
    $e = new Repository(Order::class); // want P3002
    $w = new Box<int, int>(1); // want P3001

    $m = mixedValue();
    $v = $m;
    if (is_int($v)) {
        takesInt($v);
    }
    if ($m is list<int>) { // want P1001 "`list<int>` cannot be tested at runtime"
        takesInt($m[0]);
    }
    $o = mixedValue();
    $n = $o instanceof User ? $o : null;
    takesUser($n); // want P2103
    $s = is_string($m) ? $m : throw new \TypeError('expected string, got ' . get_debug_type($m));
    takesString($s);
    $i = first<int>([1, 2]);
    takesInt($i ?? 0);
    first<int, string>([1]); // want P3001
    takesUser(nonGeneric<int>()); // want P3009
    takesString(first([1])); // want P2103
}
