namespace Cert;

// What PHP declares behind a refined type (design/checker.md §9): a check
// is impossible only when the PHP types say so too; a `@var` narrows what
// PHP declares and never widens it; and what PHPStan knows of literals,
// constants, the enum interfaces, traits and anonymous classes.

function takesInt(int $i): void
{
}

function takesString(string $s): void
{
}

function parameter(mixed $v): array|bool|null
{
    return is_array($v) || is_bool($v) ? $v : null;
}

function service(mixed $v): ?object
{
    return is_object($v) ? $v : null;
}

function number(mixed $v): int
{
    return is_int($v) ? $v : 0;
}

/**
 * @template T of object
 */
abstract class Normalizer
{
    /**
     * @param T $value
     */
    abstract public function normalize(object $value): string;
}

/**
 * @extends Normalizer<\UnitEnum>
 */
final class EnumNormalizer extends Normalizer
{
    public function normalize(object $value): string
    {
        // Erasure lets any object in: the guard is not dead code, and the
        // inherited type still types what follows it.
        if (!$value instanceof \UnitEnum) {
            throw new \InvalidArgumentException('enum expected');
        }
        if ($value instanceof \BackedEnum) {
            return (string) $value->value;
        }

        return $value->name;
    }
}

final class Document
{
    public function __construct(public string $id)
    {
    }
}

function varTags(mixed $m): void
{
    /** @var list<string> $names */
    $names = parameter($m);
    takesString($names[0]);
    /** @var Document $doc */
    $doc = service($m);
    takesString($doc->id);
    /** @var array<string, int> $counts */
    $counts = [];
    $counts['a'] = 1;
    takesInt($counts['a']);
    /** @var int|string $wide */
    $wide = number($m); // want P2212
    /** @var string $wrong */
    $wrong = number($m); // want P2212
    /** @var list<int> $bad */
    $bad = ['a']; // want P2212
    /** @var int $m */
    takesInt($m);
    echo $wide, $wrong, count($bad);
}

function returned(mixed $m): array
{
    /** @var array<string, mixed> */
    return parameter($m);
}

function nullCheck(mixed $m): int
{
    /** @var array<string, mixed> $data */
    $data = parameter($m);
    if (null === $data) { // PHP may still hand back null: not always false
        return 0;
    }

    return count($data);
}

function tagged(?Document $d): string
{
    /** @var Document $d */
    if ($d instanceof Document) { // the PHP type stays ?Document: not always true
        return $d->id;
    }

    return '';
}

abstract class Shape
{
}

/**
 * @param class-string<Shape> $class
 * @param class-string<\Countable> $countable
 */
function factory(string $class, string $countable): Shape
{
    $c = new $countable(); // a class<T> names a concrete class, whatever T is
    takesInt(count($c));

    return new $class();
}

function enums(\UnitEnum $u, \BackedEnum $b): string
{
    return $u->name . $b->value;
}

enum Scalar: string
{
    case Str = 's';
    case Int = 'i';
}

final class Casts
{
    private const array BY_NAME = [Scalar::Str->value => 'strval', Scalar::Int->value => 'intval'];

    public function callback(): callable
    {
        return self::BY_NAME['s'];
    }

    public function apply(string $name): mixed
    {
        return call_user_func(self::BY_NAME[$name] ?? 'strval', 1);
    }
}

/**
 * @param array<string, int> $counts
 * @return array<string, int>
 */
function doubled(array $counts): array
{
    $out = [];
    foreach ($counts as $name => $n) {
        if ('total' === $name) {
            $out['total'] = 0;
            continue;
        }
        $out[$name] = $n * 2;
    }

    return $out;
}

function overlay(string $path): float
{
    $parts = explode('/', $path);
    takesString($parts[0]);
    $first = array_shift($parts);
    takesString($first);
    $two = microtime();
    takesString($two);

    return microtime(true);
}

/**
 * @param list<string> $parts
 */
function shifting(array $parts): void
{
    while (null !== ($part = array_shift($parts))) {
        takesString($part);
    }
}

function captured(): void
{
    $seen = [];
    $record = static function (string $s) use (&$seen): void {
        $seen[] = $s;
    };
    $record('a');
    foreach ($seen as $s) {
        takesString($s);
    }
}

interface Named
{
    public function name(): string;
}

function anonymous(string $name): Named
{
    return new class ($name) implements Named {
        public function __construct(private readonly string $name)
        {
        }

        public function name(): string
        {
            return $this->name;
        }
    };
}

/**
 * @param iterable<Document> $docs
 * @return list<Document>
 */
function materialize(iterable $docs): array
{
    return iterator_to_array($docs, false);
}

trait Assertions
{
    public function assertNamed(Document $d): void
    {
        $this->check('' !== $d->id); // a method of the class using the trait
    }
}

final class DocumentTest
{
    use Assertions;

    public function check(bool $ok): void
    {
    }
}

final class Spec
{
    public const string TTL = 'expireAfterSeconds';

    /**
     * @param array<string, mixed> $spec
     * @param non-empty-array<string, int> $weights
     */
    public function narrowing(array $spec, array $weights, mixed $row): string
    {
        if (!is_int($spec[self::TTL])) {
            return '';
        }
        $ttl = $spec[self::TTL] + 1;
        if (!is_array($row) || !is_string($row['_id'] ?? null)) {
            return '';
        }
        takesString($row['_id']);
        takesString(array_key_first($weights));

        return $ttl . $row['_id'];
    }

    /**
     * @param list<array<string, mixed>> $rows
     * @return array<string, array<string, array{spec: string}>>
     */
    public function nested(array $rows): array
    {
        $record = [];
        foreach ($rows as $row) {
            if (!is_array($row['_id'] ?? null) || !is_string($row['_id']['c'] ?? null) || !is_string($row['_id']['i'] ?? null) || !is_string($row['spec'] ?? null)) {
                continue;
            }
            $record[$row['_id']['c']][$row['_id']['i']] = ['spec' => $row['spec']];
        }

        return $record;
    }

    /**
     * @phpstan-assert-if-true array<string, mixed> $value
     */
    public static function isDocument(mixed $value): bool
    {
        return is_array($value) && !array_is_list($value);
    }

    public function documents(mixed $value, string $name): int
    {
        if (!self::isDocument($value)) {
            return 0;
        }
        $n = count($value);
        if (class_exists($name)) {
            takesClass($name);
        }

        return $n;
    }
}

/**
 * @param class-string $c
 */
function takesClass(string $c): void
{
}

final class Field
{
    public function __construct(public readonly string $name, public readonly ?Field $next)
    {
    }
}

final class Version
{
    public function __construct(public readonly Field $primary, public readonly ?Field $field)
    {
    }
}

function chains(?Version $v, Field $f): string
{
    $name = $v?->primary->name; // the chain short-circuits on $v: ?string
    $bad = $v?->field->name; // want P2105
    if (null !== $fieldName = $v?->field?->name) {
        takesString($fieldName);
        takesString($v->field->name); // both narrowed by the non-null result
    }

    return $name ?? $bad ?? $f->next?->next->name ?? '';
}

/**
 * @param array<string, string> $bindings
 */
function bound(string $alias, array $bindings, string $base): void
{
    $b = $bindings[$alias] ?? null;
    if (null === $b || !is_a($b, $base, true)) {
        return;
    }
    takesClass($b);
}

/**
 * @param array<string, mixed> $options
 * @return array<string, mixed>
 */
function withDefault(array $options): array
{
    return array_filter($options, fn (int|string $k): bool => 'x' !== strtolower((string) $k), ARRAY_FILTER_USE_KEY) + ['x' => 0];
}

/**
 * @param array<string, list<int>> $by
 * @param list<int> $more
 * @param list<array<string, mixed>> $stages
 */
function merged(array $by, array $more, array $stages, string $k): void
{
    $by[$k] = array_merge($by[$k] ?? [], $more);
    takesList($by[$k]);
    foreach ($stages as $i => $stage) {
        if (!is_array($stage) || 1 !== count($stage)) { // erasure lets anything in: not always true
            continue;
        }
        takesInt($i);
    }
}

/**
 * @param list<int> $l
 */
function takesList(array $l): void
{
}

class Figure
{
}

final class Circle extends Figure
{
    public function radius(): int
    {
        return 1;
    }
}

/**
 * @phpstan-assert-if-true =Figure $value
 */
function isFigure(mixed $value): bool
{
    return $value instanceof Figure;
}

/**
 * @phpstan-assert-if-true Figure $value
 */
function isAFigure(mixed $value): bool
{
    return $value instanceof Figure;
}

function exactAssert(?Circle $c, ?Circle $d): void
{
    if (isFigure($c)) {
        $c->radius(); // want P2006
    }
    if (isAFigure($d)) {
        $d->radius();
    }
}
