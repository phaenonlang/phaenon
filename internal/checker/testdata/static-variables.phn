declare(strict_types=1);

namespace App\StaticVariables;

// A static variable outlives the call: its initialiser is only where the
// first call starts. Without a `@var` (the one declaration PHP leaves it) it
// is mixed, as PHPStan types it; with one, it is the declared type.

function lengths(string $k): int
{
    static $cache = [];
    if (isset($cache[$k])) { // want P2302 "cannot access offset string on mixed"
        return $cache[$k]; // want P2202
    }
    $cache[$k] = \strlen($k); // want P2302

    return \strlen($k);
}

function declared(string $k): int
{
    /** @var array<string, int> $cache */
    static $cache = [];

    return $cache[$k] ??= \strlen($k);
}

function flag(): bool
{
    /** @var bool $done */
    static $done = false;
    $first = !$done;
    $done = true;

    return $first;
}

// The initialiser is code that runs, since PHP 8.3, when the declaration
// is first reached, and no constant expression: a closure in it may
// capture the scope and use $this, and an arrow function captures what it
// reads, where a constant expression allows neither (P2531).
final class Counter
{
    public int $p = 5;

    public function captured(int $y): int
    {
        /** @var \Closure(): int $s */
        static $s = function () use ($y): int {
            return $y + $this->p;
        };

        return $s();
    }

    public function arrow(int $y): int
    {
        /** @var \Closure(): int $s */
        static $s = fn (): int => $y + $this->p;

        return $s();
    }

    public function byReference(int $y): int
    {
        /** @var \Closure(): int $s */
        static $s = function () use (&$y): int {
            return ++$y;
        };

        return $s();
    }
}

function undefinedCapture(): int
{
    /** @var \Closure(): int $s */
    static $s = function () use ($missing): int { // want P2008 "undefined variable $missing"
        return 1;
    };

    return $s();
}
