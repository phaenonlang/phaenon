namespace App\IsAs;

// `is`, `as` and `as?` left the language (roadmap D26): each is P1001,
// with the PHP test it compiled to (design/generics.md §11.4), which phn
// fmt writes in its place, or with why there is none: a type PHP has no
// O(1) test for (P3011 until then), an operand the test would evaluate
// twice (P3012). The checker narrows on a withdrawn test as on its PHP,
// so that nothing else is reported about it.

interface Model
{
}

final class User implements Model
{
    public function __construct(public readonly int $id)
    {
    }
}

final class Admin implements Model
{
}

enum Suit
{
    case Hearts;
    case Spades;
}

class Repository<T of Model>
{
    /** @var list<T> */
    public array $items = [];

    public function first(): ?T
    {
        return $this->items[0] ?? null;
    }
}

type Key = int|string;
type Ids = list<int>;

function value(): mixed
{
    return null;
}

function takesInt(int $i): int
{
    return $i;
}

function takesString(string $s): string
{
    return $s;
}

function takesInts(list<int> $l): int
{
    return \count($l);
}

function takesList(list<mixed> $l): int
{
    return \count($l);
}

function takesArray(map<int|string, mixed> $a): int
{
    return \count($a);
}

function takesPair((int, string) $p): string
{
    return $p[1];
}

function takesModel(?Model $m): bool
{
    return $m !== null;
}

function takesUserClass(class<User> $c): string
{
    return $c;
}

function takesKey(Key $k): string
{
    return (string) $k;
}

// What PHP tests itself compiles to that test: no diagnostic.
function checkable(mixed $m, string $s, object $o): int
{
    $n = 0;
    if ($m is int || $m is float || $m is string || $m is bool || $m is null) { // want P1001 "is_int($m)", P1001 "is_float($m)", P1001 "is_string($m)", P1001 "is_bool($m)", P1001 "$m === null"
        $n++;
    }
    if ($m is array || $m is object || $m is callable || $m is iterable || $m is true || $m is false) { // want P1001 "is_array($m)", P1001 "is_object($m)", P1001 "is_callable($m)", P1001 "is_iterable($m)", P1001 "$m === true", P1001 "$m === false"
        $n++;
    }
    if ($m is scalar || $m is numeric || $m is number || $m is resource) { // want P1001 "is_scalar($m)", P1001 "is_numeric($m)", P1001 "is_int($m) || is_float($m)", P1001 "is_resource($m)"
        $n++;
    }
    if ($m is User || $m is Model || $m is Suit || $m is \Closure || $m is Closure) { // want P1001 "$m instanceof User", P1001 "$m instanceof Model", P1001 "$m instanceof Suit", P1001 "$m instanceof \Closure", P1001 "$m instanceof \Closure"
        $n++;
    }
    if ($m is ?User || $m is int|string || $o is \Countable&\Traversable) { // want P1001 "$m === null || $m instanceof User", P1001 "is_int($m) || is_string($m)", P1001 "($o instanceof \Countable && $o instanceof \Traversable)"
        $n++;
    }
    if ($m is class<User> || $s is class || $m is class<object>) { // want P1001 "(is_string($m) && is_a($m, User::class, true))", P1001 "class_exists($s) || interface_exists($s)", P1001 "(is_string($m) && (class_exists($m) || interface_exists($m)))"
        $n++;
    }
    if ($m is list || $m is map<mixed, mixed> || $m is map<int|string, mixed> || $m is array<mixed>) { // want P1001 "(is_array($m) && array_is_list($m))", P1001 "is_array($m)", P1001 "is_array($m)", P1001 "is_array($m)"
        $n++;
    }
    if ($m is (int, ?string) || $m is ?(int, (string, bool))) { // want P1001 "(is_array($m) && array_is_list($m) && count($m) === 2 && is_int($m[0])", P1001
        $n++;
    }
    if ($m is Key) { // want P1001 "is_int($m) || is_string($m)"
        $n++;
    }

    return $n;
}

// What PHP has no O(1) test for: P3011, the message naming the test that
// exists.
function uncheckable(mixed $m, ?Repository<User> $r): int
{
    $n = 0;
    if ($m is list<int>) { // want P1001 "`list<int>` cannot be tested at runtime in O(1): test is_array() and a"
        $n++;
    }
    if ($m is map<string, mixed>) { // want P1001 "`map<string, mixed>` cannot be tested at runtime in O(1): test is_arra"
        $n++;
    }
    if ($m is array<int>) { // want P1001 "`array<int>` cannot be tested at runtime in O(1): test is_array(), and"
        $n++;
    }
    if ($m is iterable<int>) { // want P1001 "`iterable<int>` cannot be tested at runtime in O(1): test is_iterable("
        $n++;
    }
    if ($m is Closure(int): string) { // want P1001 "`Closure(int): string` cannot be tested at runtime: test instanceof \C"
        $n++;
    }
    if ($m is bytes) { // want P1001 "`bytes` cannot be tested at runtime: PHP cannot tell bytes from string"
        $n++;
    }
    if ($m is (int, list<string>)) { // want P1001 "`list<string>` cannot be tested at runtime in O(1): test is_array() an"
        $n++;
    }
    if ($m is ?list<User>) { // want P1001 "`list<User>` cannot be tested at runtime in O(1): test is_array() and "
        $n++;
    }
    if ($m is int|map<string, int>) { // want P1001 "`map<string, int>` cannot be tested at runtime in O(1): test is_array("
        $n++;
    }
    if ($m is Ids) { // want P1001 "`Ids` (`list<int>`) cannot be tested at runtime in O(1): test is_array"
        $n++;
    }
    if ($m is Repository<User>) { // want P1001 "`Repository<User>` cannot be tested at runtime: instanceof does not se"
        $n++;
    }
    if ($m is class<Repository<User>>) { // want P1001 "`class<Repository<User>>` cannot be tested at runtime in O(1): test is"
        $n++;
    }
    if ($m is void) { // want P1001 "`void` cannot be tested at runtime: no value has this type"
        $n++;
    }
    $u = $m as list<User>; // want P1001 "`list<User>` cannot be tested at runtime in O(1): test is_array() and "
    $v = $m as? map<string, int>; // want P1001 "`map<string, int>` cannot be tested at runtime in O(1): test is_array("
    if ($r is Repository<User>) { // want P1001 "$r instanceof Repository"
        $n++; // the operand fixes the arguments: instanceof Repository decides
    }

    return $n + \count($u) + \count($v ?? []);
}

// A type without a test is the one finding, where the operand's type
// settles the test as well.
function settledUntestable(string $s): bool
{
    return $s is list<int> // want P1001 "`list<int>` cannot be tested at runtime in O(1): test is_array() and a"
        || $s is Closure(int): string; // want P1001 "`Closure(int): string` cannot be tested at runtime: test instanceof \C"
}

// The arguments a union's member fixes, and ones it does not: a Model may
// be a Repository<Admin> too.
function generic(Repository<User>|int $a, Repository<User>|Repository<Model> $b, Repository<Admin>|User $c, Repository<User>|Model $d): int
{
    $n = 0;
    if ($a is Repository<User>) { // want P1001 "$a instanceof Repository"
        $n += \count($a->items);
    }
    if ($b is Repository<User>) { // want P1001 "`Repository<User>` cannot be tested at runtime: instanceof does not se"
        $n++;
    }
    if ($c is Repository<Admin>) { // want P1001 "$c instanceof Repository"
        $n += \count($c->items);
    }
    if ($d is Repository<User>) { // want P1001 "`Repository<User>` cannot be tested at runtime: instanceof does not se"
        $n++;
    }

    return $n;
}

final class Box<T>
{
    public function __construct(private readonly T $value)
    {
    }

    public function same(mixed $other): bool
    {
        return $other is self; // no type parameter is read // want P1001 "$other instanceof self"
    }

    public function like(mixed $other): bool
    {
        return $other is static; // want P1001 "$other instanceof static"
    }

    public function holds(mixed $m): bool
    {
        return $m is ?T; // want P1001, P3003
    }

    public function names(mixed $m): bool
    {
        return $m is class<T>; // want P1001, P3003
    }

    public function pair(mixed $m): bool
    {
        return $m is (T, int); // want P1001, P3003
    }

    public function value(): T
    {
        return $this->value;
    }
}

final class Holder
{
    /** @var map<string, mixed> */
    public array $row = [];
    public mixed $item = null;
    public static mixed $cache = null;
    public ?Holder $next = null;

    public function read(): int
    {
        $id = $this->row['id'] as int; // want P1001
        $self = self::$cache as? Holder; // want P1001 "self::$cache instanceof Holder ? self::$cache : null"
        $item = $this->next->item as? User; // want P1001 "$this->next->item instanceof User ? $this->next->item : null", P2105
        $key = $this->row[\PHP_EOL] as? int; // want P1001 "is_int($this->row[\PHP_EOL]) ? $this->row[\PHP_EOL] : null"
        $deep = $this->next?->item as? int; // want P1001 "the operand would be evaluated twice; assign it to a variable first"
        $first = $this->next?->item is ?User; // want P1001 "the operand would be evaluated twice; assign it to a variable first"

        return $id + ($self === null ? 0 : 1) + ($item?->id ?? 0) + ($key ?? 0) + ($deep ?? 0) + ($first ? 1 : 0);
    }
}

// A compound test, an `as` and an `as?` write their operand more than once:
// P3012 for an operand a second reading would run again. A single-function
// test takes any expression.
function operands(mixed $m, int $i, map<int, mixed> $a): int
{
    $n = 0;
    if (value() is int || value() is User || value() is null) { // want P1001 "is_int(value())", P1001 "value() instanceof User", P1001 "value() === null"
        $n++;
    }
    if (value() is list) { // want P1001 "the operand would be evaluated twice; assign it to a variable first"
        $n++;
    }
    if (value() is ?int) { // want P1001 "the operand would be evaluated twice; assign it to a variable first"
        $n++;
    }
    $x = value() as int; // want P1001 "the operand would be evaluated twice; assign it to a variable first"
    $y = value() as? int; // want P1001 "the operand would be evaluated twice; assign it to a variable first"
    $z = ($m ?? $i) as int; // want P1001 "the operand would be evaluated twice; assign it to a variable first"
    $w = $a[$i] as ?int; // want P1001 "the operand would be evaluated twice; assign it to a variable first"
    $v = ($m = value()) as int; // want P1001 "the operand would be evaluated twice; assign it to a variable first"
    $u = $a[0] as int; // want P1001 "is_int($a[0]) ? $a[0] : throw new \TypeError('expected int, got ' . ge"
    if ($a is list) { // want P1001 "array_is_list($a)"
        $n++; // on an array, `is list` is \array_is_list($a) alone: any operand
    }

    return $n + $x + ($y ?? 0) + $z + ($w ?? 0) + $v + $u;
}

// Narrowing: as PHPStan narrows the native test on the output.
function narrowing(mixed $m, map<int|string, int> $ints, mixed $p, mixed $c): int
{
    $n = 0;
    if ($ints is list) { // want P1001 "array_is_list($ints)"
        $n += takesInts($ints); // list<int>
    }
    if ($m is list) { // want P1001 "is_array($m) && array_is_list($m)"
        $n += takesList($m);
        $n += takesInts($m); // want P2103
    }
    if ($m is array) { // want P1001 "is_array($m)"
        $n += takesArray($m);
        $n += takesList($m); // want P2103
    }
    if ($p is (int, string)) { // want P1001 "is_array($p) && array_is_list($p) && count($p) === 2 && is_int($p[0]) "
        $n += \strlen(takesPair($p));
    }
    if ($p is ?(int, string)) { // want P1001 "$p === null || (is_array($p) && array_is_list($p) && count($p) === 2 &"
        $n += \strlen(takesPair($p ?? [1, ''])); // want P2103 "list{mixed, mixed} given"
    }
    if ($c is class<User>) { // want P1001 "is_string($c) && is_a($c, User::class, true)"
        $n += \strlen(takesUserClass($c));
    }
    if ($m is Repository) { // want P1001 "$m instanceof Repository"
        $n += takesModel($m->first()) ? 1 : 0; // the parameter is its bound
    }
    if ($m is Key) { // want P1001 "is_int($m) || is_string($m)"
        $n += \strlen(takesKey($m));
    }
    $i = $m as int; // want P1001 "is_int($m) ? $m : throw new \TypeError('expected int, got ' . get_debu"
    $n += takesInt($m); // `as` threw unless $m is an int
    $s = $p as? string; // want P1001 "is_string($p) ? $p : null"
    $n += takesInt($p); // want P2103

    return $n + $i + \strlen($s ?? '');
}

// A test the types settle is P2306, for `as` and `as?` as for `is`. An
// operand read twice is P3012 all the same: `phn build --emit-on-error`
// writes the test.
function settled(int $i, string $s, mixed $m): int
{
    $a = $i as int; // want P1001 "is_int($i) ? $i : throw new \TypeError('expected int, got ' . get_debu"
    $b = $s as? int; // want P1001 "is_int($s) ? $s : null"
    if ($m is mixed) { // want P1001 "true"
        return 0;
    }
    if (value() is mixed) { // want P1001 "the types settle this test, and its PHP would not evaluate the operand"
        return 1;
    }
    $c = \strlen('a') as int; // want P1001 "the operand would be evaluated twice; assign it to a variable first"
    $d = value() as? mixed; // want P1001 "true ? value() : null"
    $e = value() as mixed; // want P1001 "the operand would be evaluated twice; assign it to a variable first"

    return $a + ($b ?? 0) + $c + (\is_int($d) ? $d : 0) + (\is_int($e) ? $e : 0);
}

// The else branch narrows as PHPStan narrows the emitted test: a false
// is_*() check, instanceof or === takes its type out, a false && narrows
// nothing.
function elseBranch((int, string)|int $t, list<int>|int $l, object|int $o, (int, string)|int|null $p, int|string $v, ?User $u): int
{
    $n = 0;
    if ($t is (int, string)) { // want P1001 "is_array($t) && array_is_list($t) && count($t) === 2 && is_int($t[0]) "
        $n++;
    } else {
        takesInt($t); // want P2103 "int|list{int, string} given"
    }
    if ($l is list) { // want P1001 "is_array($l) && array_is_list($l)"
        $n++;
    } else {
        takesInt($l); // want P2103
    }
    if ($o is \Countable&\Traversable) { // want P1001 "$o instanceof \Countable && $o instanceof \Traversable"
        $n++;
    } else {
        takesInt($o); // want P2103
    }
    if ($p is ?(int, string)) { // want P1001 "$p === null || (is_array($p) && array_is_list($p) && count($p) === 2 &"
        $n++;
    } else {
        takesInt($p); // want P2103 "int|list{int, string} given"
    }
    if ($v is int) { // want P1001 "is_int($v)"
        $n++;
    } else {
        $n += \strlen(takesString($v)); // a false is_int() leaves the string
    }
    if ($u is null) { // want P1001 "$u === null"
        return $n;
    }

    return $n + $u->id; // a false === null leaves the User
}

// A loop's body is checked on more than one pass; the type's own finding
// stays its one finding.
function looped(list<mixed> $xs): int
{
    $n = 0;
    $last = null;
    foreach ($xs as $x) {
        if ($x is Box<list>) { // want P1001, P3001
            $n++;
        }
        $last = $n;
    }

    return $n + ($last ?? 0);
}

// Only the names the operand is tested against may be a bare list: a type
// argument keeps list's arity (P3001), and a class name is a member of a
// tuple too.
function arity(mixed $m): bool
{
    return $m is Box<list> // want P1001, P3001
        || $m is class<list> // want P1001, P3001
        || $m is (list, class, int); // want P1001
}

// The inline @var check holds a tag to PHP's type of the value, and to the
// docblock's where PHP declares none.
/** @return int */
function docblockOnly()
{
    return 1;
}

final class DocblockOnly
{
    /** @return int */
    public static function make()
    {
        return 1;
    }
}

function varTags(): string
{
    /** @var string $s */
    $s = docblockOnly(); // want P2212 "@var string is not a subtype of the assigned int"
    /** @var string $t */
    $t = DocblockOnly::make(); // want P2212

    return $s . $t;
}

// A constant reads the same value twice: no P3012, only the P2306 its
// value's type settles.
class Limits
{
    public const N = 3;
    public const int|string KEY = 'a';
    public const mixed DEFAULT = null;

    public function read(): int
    {
        $d = static::DEFAULT as? int; // want P1001 "is_int(static::DEFAULT) ? static::DEFAULT : null"
        $e = self::DEFAULT is ?int; // want P1001 "self::DEFAULT === null || is_int(self::DEFAULT)"

        return ($d ?? 0) + ($e ? 1 : 0);
    }
}

function constants(): int
{
    $n = Limits::N as int; // want P1001 "is_int(Limits::N) ? Limits::N : throw new \TypeError('expected int, go"
    $m = \PHP_INT_MAX as? int; // want P1001 "is_int(\PHP_INT_MAX) ? \PHP_INT_MAX : null"
    $k = Limits::KEY as int|string; // want P1001 "is_string(Limits::KEY) ? Limits::KEY : throw new \TypeError('expected "

    return $n + ($m ?? 0) + \strlen((string) $k);
}

// A property with a get hook runs it on each read: a test that writes it
// twice runs it twice (P3012). A plain property reads the same twice.
final class Hooked
{
    public mixed $data = null;

    public ?Hooked $next = null;

    public mixed $raw {
        get => $this->data;
    }

    public ?Hooked $link {
        get => $this->next;
    }

    public function read(): int
    {
        $b = $this->raw is ?int; // want P1001 "the operand reads the hooked property App\IsAs\Hooked::$raw twice, and"
        $c = $this->raw is int; // one function call reads it once // want P1001 "is_int($this->raw)"
        $a = $this->raw as int; // want P1001 "the operand reads the hooked property App\IsAs\Hooked::$raw twice, and"
        $d = $this->data as int; // want P1001 "is_int($this->data) ? $this->data : throw new \TypeError('expected int"
        $e = $this->link->data as? int; // want P1001 "the operand reads the hooked property App\IsAs\Hooked::$link twice, an", P2105

        return $a + ($b ? 1 : 0) + ($c ? 1 : 0) + $d + ($e ?? 0);
    }
}

// The key of a read on the left of ?? is typed once: the `as` in it
// narrows $k after it, not before it.
function coalescedKey(mixed $k, map<int, string> $names): string
{
    return $names[$k as int] ?? ''; // want P1001 "is_int($k) ? $k : throw new \TypeError('expected int, got ' . get_debu"
}

// `as?` is the operator only when its `?` touches `as`: `$x as ?int` is
// `as` with the nullable type ?int, which throws on anything else, where
// `$x as? int` gives null on anything but an int.
function spellings(?int $n, null $z): int
{
    $a = $n as ?int; // want P1001 "$n === null || is_int($n) ? $n : throw new \TypeError('expected ?int, "
    $b = $n as? int; // want P1001 "is_int($n) ? $n : null"
    $c = $z as? int; // want P1001 "is_int($z) ? $z : null"
    $d = $z as ?int; // want P1001 "$z === null || is_int($z) ? $z : throw new \TypeError('expected ?int, "
    $e = value() as ?int; // want P1001 "the operand would be evaluated twice; assign it to a variable first"
    $f = value() as? int; // want P1001 "the operand would be evaluated twice; assign it to a variable first"

    return ($a ?? 0) + ($b ?? 0) + ($c ?? 0) + ($d ?? 0) + ($e ?? 0) + ($f ?? 0);
}
