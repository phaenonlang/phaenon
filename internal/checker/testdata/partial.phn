// target: 8.6
// Partial function application (PHP 8.6, design/php-versions.md §5.2).

function three(int $a, string $b, float $c): string { return "$a$b$c"; }
function opt(int $a, string $b = 'x', ?int $c = null): int { return $a; }
function vari(int $a, string ...$rest): int { return $a; }
function reff(array<mixed> &$xs, int $n): void { $xs[] = $n; }
function wantsInt(int $x): void {}

/**
 * @template T
 * @param list<T> $xs
 * @return T
 */
function first(array $xs, int $i): mixed { return $xs[$i]; }

final class Greeter {
    greet(string $name, string $greeting = 'Hello'): string { return "$greeting, $name"; }
    static shout(string $s, int $times): string { return str_repeat($s, $times); }
}

// The closure's parameters: placeholders in PHP's order, with their types.
$f = three(1, ?, ?);
wantsInt($f); // want P2103 "Closure(string $b, float $c): string"
$g = three(c: ?, a: ?, b: 'x');
wantsInt($g); // want P2103 "Closure(float $c, int $a): string"
$h = three(?, ...);
wantsInt($h); // want P2103 "Closure(int $a, string $b, float $c): string"

// `?` makes a parameter required; `...` keeps its optionality.
$o = opt(?, ?);
wantsInt($o); // want P2103 "Closure(int $a, string $b): int"
$p = opt(?, ...);
wantsInt($p); // want P2103 "Closure(int $a, string $b=, int|null $c=): int"
$q = opt(c: ?); // want P2101 "argument #1 ($a)"
$q2 = opt(1, c: ?);
wantsInt($q2); // want P2103 "Closure(int|null $c): int"

// A placeholder that binds into a variadic parameter; `...` keeps it variadic.
$v = vari(1, ?, ...);
wantsInt($v); // want P2103 "Closure(string $rest0, string... $rest=): int"

// By reference stays by reference.
$r = reff(?, 3);
$xs = [1];
$r($xs);

// Methods and static methods.
$greeter = new Greeter();
$m = $greeter->greet(?, 'Hi');
wantsInt($m); // want P2103 "Closure(string $name): string"
$s = Greeter::shout('a', ?);
wantsInt($s); // want P2103 "Closure(int $times): string"
echo $s('x'); // want P2103

// The bound arguments determine the type parameters; the result is not generic.
$names = ['ada', 'bob'];
$pick = first($names, ?);
wantsInt($pick); // want P2103 "Closure(int $i): 'ada'|'bob'"

// Bound arguments are checked when the closure is created.
$bad = three('one', ?, 1.0); // want P2103

// The placeholder count, as PHP checks it at creation.
$few = three(?); // want P2101 "expects exactly 3 arguments, 1 given"
$many = three(?, ?, ?, ?); // want P2102 "expects at most 3 arguments, 4 given"
$fewOpt = opt(); // want P2101
$out = three(1, c: ?); // want P2101 "argument #2 ($b)"
$name = opt(?, d: ?); // want P2010
$overwrite = opt(?, a: ?); // want P2010
$ok = three(?, ...);
$restFew = three(?, ?, ?, ?, ...); // want P2102

// A named argument or placeholder for a parameter an argument or a
// placeholder before it fills: PHP's Error when the closure is created,
// "Named parameter $a overwrites previous argument" (or "placeholder").
$overArg = opt(1, a: 2, ...); // want P2010 "named argument $a of opt() overwrites the argument before it"
$overTwice = opt(a: 1, a: 2, ...); // want P2010
$overBound = three(1, 'x', b: 'y', ...); // want P2010
$overQ = opt(?, a: 2); // want P2010 "named argument $a of opt() overwrites the placeholder before it"
$overQRest = opt(?, a: 2, ...); // want P2010
$overQs = opt(?, ?, a: 1); // want P2010
$overNamedQ = opt(?, b: ?, b: 'y'); // want P2010 "named argument $b of opt() overwrites the placeholder before it"
$overThenQ = opt(1, b: 'x', b: ?); // want P2010 "named placeholder $b of opt() overwrites the argument before it"
$overMethod = $greeter->greet('a', name: 'b', ...); // want P2010 "Greeter::greet()"
$overMethodQ = $greeter->greet(?, name: 'b'); // want P2010
$overStatic = Greeter::shout('a', s: 'b', ...); // want P2010 "Greeter::shout()"
$overStaticQ = Greeter::shout(?, 2, s: 'b'); // want P2010
$overClosure = $h(1, a: 2, ...); // want P2010
$overVari = vari(1, x: 'a', x: 'b', ...); // want P2010
$overPiped = 'z' |> opt(1, a: 2, ...); // want P2010
$unknownRest = opt(1, d: 2, ...); // want P2010 "unknown named argument $d"
$intoVari = vari(1, x: 'a', ...);
$namedOk = opt(?, b: 'y');

// What PHP's compiler rejects.
$twice = three(..., ...); // want P1003
$notLast = three(..., 'x'); // want P1003
$unpack = vari(...['x'], ...); // want P1003
$named = three(a: 1, ?); // want P2110
$new = new Greeter(...); // want P1003
$nullsafe = $greeter?->greet(?); // want P1003, P2307

// Constant expressions.
const UPPER = strtoupper(?);
function withDefault(Closure $f = str_repeat('-', ?)): mixed { return $f(3); }
