namespace App\Jobs;

// `concurrently` and `spawn` are ordinary names: the syntax that took them
// left the language (design/concurrency.md §17), and a function or a method
// of either name, and the calls of them, compile as the PHP they are.

fun spawn(string $job): int {
    return \strlen($job);
}

fun concurrently(Pool $pool, string ...$jobs): void {
    $pool->concurrently(...$jobs);
}

final class Pool
{
    /** @var list<int> */
    private array $started = [];

    public static fun spawn(string ...$jobs): self {
        $pool = new self();
        concurrently($pool, ...$jobs);
        return $pool;
    }

    public fun concurrently(string ...$jobs): void {
        foreach ($jobs as $job) {
            $this->started[] = spawn ($job);
        }
    }

    /** @return list<int> */
    public fun started(): array {
        return [...$this->started, ...\array_map(spawn(...), ['d', 'ef'])];
    }
}

fun sizes(): int {
    return \array_sum(Pool::spawn('a', 'bc')->started());
}
