// targets: 8.5, 8.6
// Pipelines as phn migrate writes them (design/tooling.md §8.1), compiled
// for PHP 8.5 (pipes.php: the partial applications lowered as
// design/php-versions.md §5.3 says) and for PHP 8.6 (pipes.8.6.php).

final class User {
    __construct(public ?string $email) {}
}

final class Log {
    /** @var list<string> */
    public array $lines = [];

    line(string $s): void {
        $this->lines[] = $s;
    }
}

function trace(string $label, string $value): string {
    echo "eval $label\n";
    return $value;
}

// Closures bound before and after the piped value.
function emails(list<User> $users): list<string> => $users
    |> array_map(fn (User $u): ?string => $u->email, ?)
    |> array_filter(?, fn (?string $e): bool => $e !== null)
    |> array_values(...);

// Literal bound arguments and first-class callables.
function encode(map<string, int> $parts): string => $parts
    |> json_encode(?, \JSON_THROW_ON_ERROR)
    |> base64_encode(...)
    |> strtr(?, '+/', '-_')
    |> rtrim(?, '=');

// A variable bound after the piped value, a method stage.
function report(Log $log, list<string> $rows, string $what): void {
    $rows
        |> count(...)
        |> sprintf('%d %s published.', ?, $what)
        |> $log->line(...);
}

// The head is the innermost call: it runs first, as it did nested.
function traced(): string => trace('head', ' x ') |> trim(...) |> strtoupper(...);

// An anonymous class bound in a stage whose closure needs a use clause: its
// constructor argument is a variable of the function, its property and its
// method's local, named like the closure's parameter, are not.
interface Weighted {
    weight(): int;
}

function weigh(list<int> $xs, Weighted $w): int => array_sum($xs) * $w->weight();

function weighted(list<int> $xs, int $factor): int => $xs
    |> weigh(?, new class ($factor) implements Weighted {
        public int $a = 1;

        __construct(private int $factor) {}

        weight(): int {
            $xs = [$this->a, $this->factor];
            return array_sum($xs);
        }
    });

// A bound argument the left side writes keeps the pipe: PHP 8.6 reads $n
// after bump() has run, the call would read it before.
function bump(int &$n): string {
    $n++;
    return "b$n";
}

function counted(): string {
    $n = 1;
    return bump($n) |> sprintf('%2$s/%1$d', $n, ?);
}

// A property is read after the left side: the stage stays a pipe's.
final class Report {
    __construct(private Log $log) {}

    add(list<string> $rows): void {
        $rows |> implode(', ', ?) |> $this->log->line(...);
    }
}

// A comment between the stages stays where it is, and so does the pipe.
function shout(string $s): string => $s
    |> trim(...) // the blanks around it
    |> strtoupper(...);

// A named placeholder, the head in parentheses.
function padded(?string $s): string => ($s ?? 'none') |> trim(...) |> str_pad(length: 8, string: ?);

// A closure over lines moves with its stage.
function names(list<User> $users): string {
    return $users
        |> array_map(function (User $u): string {
            return $u->email ?? '-';
        }, ?)
        |> implode(', ', ?);
}

echo implode(',', emails([new User('a@x'), new User(null), new User('b@x')])), "\n";
echo encode(['a' => 1, 'b' => 2]), "\n";
$log = new Log();
report($log, ['x', 'y'], 'anchors');
echo implode('|', $log->lines), "\n";
echo traced(), "\n";
echo weighted([1, 2], 3), "\n";
echo counted(), "\n";
$log = new Log();
(new Report($log))->add(['p', 'q']);
echo implode('|', $log->lines), "\n";
echo shout(' up '), "\n";
echo padded(null), '|', padded(' ab '), "\n";
echo names([new User('a@x'), new User(null)]), "\n";
