// targets: 8.5, 8.6
// A pipe's bound arguments and the scope they are computed in
// (design/php-versions.md §5.3). A stage that folds is written for PHP 8.5
// as the call PHP makes of it, its arguments where they stand, so that what
// they read or write of the function is the function's: an assignment, a
// variable passed by reference, its arguments, its name. A stage that does
// not fold computes them in a closure called at once, which reads the
// function's class, $this and, by value, its variables as the function
// does; what would read the closure's own scope there is refused (P1002).

function sep(): string => ',';

// Folded: the arguments after the placeholder run in the function.
function assigned(string $s): string {
    $r = $s |> str_replace(?, 'b', ($t = 'xa') . sep());
    return $r . '|' . $t;
}

function matched(string $s): string {
    $r = $s |> str_replace(?, 'b', (string) preg_match('/(a)/', $s, $m));
    return $r . '|' . json_encode($m);
}

function arguments(string $s, string $t): string => $s |> str_replace(?, 'b', json_encode(func_get_args()) ?: '');

function named(string $s): string => $s |> str_replace(?, 'b', __FUNCTION__ . sep());

// A comment or an attribute inside an argument moves with it.
function counted(string $s, string $t): string => $s |> str_replace(?, 'b', strval(/* how many */ func_num_args()));

function subject(string $s): string {
    $r = $s |> str_replace(?, 'b', (string) preg_match(/* subject */ '/(a)/', $s, $m));
    return $r . '|' . json_encode($m);
}

function keyed(string $s): string => $s |> str_replace(?, (fn(#[\SensitiveParameter] string $k): string => $k)('b'), __FUNCTION__);

// In a closure: what reads the function as the closure reads it.
function line(string $s): string => $s |> str_replace('a', __LINE__ . sep(), ?);

function captured(string $s): string {
    $count = 0;
    $r = $s |> str_replace('a', (string) (function () use ($count): int {
        $count++;
        return $count;
    })(), ?);
    return $r . '|' . $count;
}

function arrow(string $s): string {
    $n = 1;
    return $s |> str_replace('a', (string) (fn(): int => $n + 1)(), ?);
}

// A callable whose type gives its parameters takes by reference only what
// they say.
/** @param Closure(string): string $up */
function typed(string $s, Closure $up, string $v): string => $s |> str_replace('a', $up($v), ?);

function local(string $s, string $v): string {
    $up = strtoupper(...);
    return $s |> str_replace('a', $up($v), ?);
}

final class Scope {
    public string $tag = 'T';

    viaClass(string $s): string => $s |> str_replace('a', __CLASS__ . sep(), ?);

    viaThis(string $s): string => $s |> str_replace('a', $this->tag . sep(), ?);

    static viaStatic(string $s): string => $s |> str_replace('a', static::class . sep(), ?);

    method(string $s): string => $s |> str_replace(?, 'b', __METHOD__ . sep());
}

$scope = new Scope();
echo assigned('ab'), "\n", matched('ab'), "\n", arguments('ab', 'c'), "\n", named('ab'), "\n";
echo counted('ab', 'c'), "\n", subject('ab'), "\n", keyed('ab'), "\n";
echo line('a'), "\n", captured('a'), "\n", arrow('a'), "\n", typed('a', strtoupper(...), 'v'), "\n", local('a', 'v'), "\n";
echo $scope->viaClass('a'), "\n", $scope->viaThis('a'), "\n", Scope::viaStatic('a'), "\n", $scope->method('ab'), "\n";
