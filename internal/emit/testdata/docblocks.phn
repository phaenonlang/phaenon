namespace App\Docblocks;

// A docblock in a .phn speaks Phaenon (design/collections.md §4): its
// types reach PHPStan in PHPStan's vocabulary, the prose as written.

final class Config
{
    /**
     * The settings by section, with the pair each one was read from.
     *
     * @param array{
     *     by: map<string, int>,
     *     source: (string, int),
     *     reader: class<\Countable>,
     * } $settings the settings (as parsed, unchecked)
     */
    fun __construct(private array $settings) {}

    /** @return map<string, int> the counts by section */
    fun counts(): array => $this->settings['by'];

    /** @return (string, int) where the settings came from */
    fun source(): array => $this->settings['source'];

    /** @param Closure(string): (int, int) $parse how a line is read */
    fun parseWith(\Closure $parse): int => $parse('a')[0];

    /** @return class<\Countable> */
    fun reader(): string => $this->settings['reader'];
}
