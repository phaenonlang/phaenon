namespace Shop\Orders;

// The shapes of the namespace, in a file of their own: its output holds
// nothing, and every file that names one gets its expansion.

/** One line of an order: what was bought, and how many. */
type Line = array{sku: string, qty: int};

/**
 * An order as the shop keeps it.
 *
 * @see Customer for the buyer
 */
type Order = array{id: int, lines: list<Line>, buyer?: Customer};
type Page<T> = array{items: list<T>, total: int, next?: string};
