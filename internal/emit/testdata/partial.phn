// targets: 8.5, 8.6
// Partial function application (design/php-versions.md §5.3): lowered to
// arrow functions for PHP 8.5 (partial.php), written as such for 8.6
// (partial.8.6.php). Both print the same under PHP 8.6.

fun pair(string $a, string $b): string { return "[$a|$b]"; }
fun three(int $a, string $b = 'b', float $c = 1.5): string { return "$a-$b-$c"; }
fun vari(string $sep, string ...$parts): string { return implode($sep, $parts); }
/** @param list<int> $xs */
fun addTo(array &$xs, int $n): void { $xs[] = $n; }
/** @param list<int> $xs */
fun total(array $xs, int $n): int { return array_sum($xs) + $n; }
fun trace(string $label, string $v): string { echo "eval $label\n"; return $v; }

final class Greeter {
    public function __construct(private string $greeting) {}
    fun greet(string $name, string $punct = '!'): string { return "$this->greeting, $name$punct"; }
    static fun shout(string $s, int $times): string { return str_repeat(strtoupper($s), $times); }
}

final class Paths {
    const SEP = '/';
}

interface HasLabel {
    const LABEL = 'base';
}

final class Labelled implements HasLabel {
    #[\Override]
    const LABEL = 'own';
}

interface Sizes {
    const Small = 'small';
}

enum Size: string implements Sizes {
    #[\Override] case Small = 's';
}

// A bound variable is captured when the closure is created.
$sep = '-';
$f = pair($sep, ?);
echo $f('x'), "\n";
$sep = '+';
echo $f('y'), "\n";
$g = str_pad(?, 6, '*');
echo $g('abc'), "\n";
// `...` keeps the remaining parameters, defaults included.
$h = three(?, ...);
echo $h(1), ' ', $h(2, 'x'), ' ', $h(3, 'y', 2.5), "\n";
$named = three(c: ?, a: 7);
echo $named(9.5), "\n";
$v = vari(',', ?, ...);
echo $v('a', 'b', 'c'), "\n";
$xs = [1];
$add = addTo(?, 2);
$add($xs);
fun totals(): int {
    // A closure over lines: the call moves in with its block.
    $total = total(
        ?,
        3,
    );
    return $total([1, 2]);
}
echo totals(), "\n";
var_export($xs);
echo "\n";
$greeter = new Greeter('Hello');
$hi = $greeter->greet(?);
echo $hi('Ada'), "\n";
$shout = Greeter::shout(?, 2);
echo $shout('hey'), "\n";
echo (strlen(?))('four'), "\n";

// In a pipe, literal bound arguments make the call itself; others run
// after the left side, as PHP 8.6 runs them.
echo 'ns' |> sprintf('namespace %s', ?) |> strtoupper(...), "\n";
echo 'a b' |> str_replace(' ', Paths::SEP, ?), "\n";
echo trace('left', 'L') |> pair(trace('bound', 'B'), ?), "\n";
echo 'x' |> $greeter->greet(?, '?'), "\n";

// Constant expressions.
const UPPER = strtoupper(?);
echo (UPPER)('const'), "\n";
fun dashes(Closure $f = str_repeat('-', ?)): string { $r = $f(3); return is_string($r) ? $r : ''; }
echo dashes(), "\n";

echo Labelled::LABEL, Size::Small->value, "\n";
