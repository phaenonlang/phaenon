namespace App;

use Closure;

// Lists, maps and strings go through PHP's functions, chained left to
// right with pipes (roadmap D20): list<T> and map<K, V> erase to array with
// their types in docblocks, a tuple (A, B) to the shape array{A, B}, and
// the compiler imports \Phaenon\Type for `is` beside the file's own
// imports (design/collections.md §2, roadmap D11).

final class User
{
    public function __construct(public readonly string $name, public readonly int $age, public readonly bool $active)
    {
    }
}

function emails(list<User> $users): list<string>
{
    $active = array_values(array_filter($users, fn (User $u) => $u->active));

    return array_map(fn (User $u) => strtolower($u->name) . '@example.com', $active);
}

function byName(list<User> $users): map<string, User>
{
    $out = [];
    foreach ($users as $u) {
        $out[$u->name] = $u;
    }

    return $out;
}

function oldest(list<User> $users): ?User
{
    usort($users, fn (User $a, User $b) => $b->age <=> $a->age);

    return $users[0] ?? null;
}

function pairs(list<string> $names, list<int> $ages): list<(string, int)>
{
    $out = [];
    foreach ($names as $i => $name) {
        $out[] = [$name, $ages[$i] ?? 0];
    }

    return $out;
}

function describe(list<(string, int)> $pairs): string
{
    $lines = [];
    foreach ($pairs as [$name, $age]) {
        $lines[] = str_pad($name, 10) . $age;
    }

    return $lines === [] ? '-' : implode("\n", $lines);
}

function adults(map<string, User> $users): map<string, int>
{
    $ages = array_map(fn (User $u) => $u->age, $users);

    return array_filter($ages, fn (int $age) => $age >= 18);
}

function keys(map<string, int> $counts): string
{
    $keys = array_keys($counts);
    sort($keys);

    return implode(', ', $keys);
}

function slug(string $title): string
{
    return $title
        |> trim(...)
        |> strtolower(...)
        |> (fn (string $s) => str_replace(' ', '-', $s));
}

function initials(string $name): string
{
    $initial = fn (string $part) => strtoupper(substr($part, 0, 1));

    return implode('', array_map($initial, explode(' ', $name)));
}

function nullable(?string $s): int
{
    return $s === null ? 0 : mb_strlen($s);
}

function nullsafe(?string $s, ?User $u): string
{
    $n = $s === null ? null : mb_strlen($s);
    $name = $u?->name;

    return strtoupper($name ?? '-') . ($n ?? 0);
}

final class Id implements \Stringable
{
    public function __construct(private readonly string $value)
    {
    }

    public function __toString(): string
    {
        return $this->value;
    }
}

function prefixed(Id $id): bool
{
    return str_starts_with((string) $id, 'u-');
}

function firstPair(list<(string, int)> $pairs): ?(string, int)
{
    return $pairs[0] ?? null;
}

// json_decode() gives mixed: an offset is read once the value is known to be
// a map (P2302 before, PHPStan's offsetAccess.nonOffsetAccessible).
function port(string $json): int
{
    $config = \json_decode($json, true, 512, JSON_THROW_ON_ERROR);
    if ($config is map<string, mixed> && \is_int($config['port'] ?? null)) {
        return $config['port'];
    }

    return 80;
}

// A member of `object` is called once method_exists() proved it (P2006
// before, PHPStan's method.notFound); its result is mixed until checked.
function exported(object $value): map<string, mixed>
{
    if (\method_exists($value, 'toArray')) {
        $data = $value->toArray();

        return $data is map<string, mixed> ? $data : [];
    }

    return [];
}
