namespace App;

use Phaenon\Bytes;

// bytes erases to string: the (bytes) cast disappears, PHP's functions
// take bytes as they take strings, and \Phaenon\Bytes holds the checked
// conversions (design/strings.md §2, §5).

final class Token
{
    public function __construct(public readonly bytes $secret)
    {
    }

    public static function generate(): self
    {
        return new self(random_bytes(32));
    }

    public static function fromHex(string $hex): self
    {
        return new self(Bytes::fromHex($hex));
    }

    public function hex(): string
    {
        return Bytes::hex($this->secret);
    }

    public function matches(bytes $candidate): bool
    {
        return hash_equals($this->secret, $candidate);
    }

    public function fingerprint(): string
    {
        return hash('sha256', $this->secret, true)
            |> (fn (bytes $h) => substr($h, 0, 8))
            |> Bytes::hex(...);
    }
}

function fromBinary(string $raw): bytes
{
    return (bytes) $raw;
}

function toBinary(bytes $raw): string
{
    return (string) $raw;
}

function label(bytes $id): string
{
    return 'id-' . Bytes::hex($id) . ' (' . strlen($id) . ' bytes)';
}

function keys(list<bytes> $keys): list<string>
{
    return array_map(fn (bytes $k) => Bytes::base64($k, urlSafe: true), $keys);
}

// `as string` checks that bytes are UTF-8 text and throws a ValueError
// when they are not; `as?` gives null, `is string` is the test alone
// (strings.md §6). Where a type may fail too, the error says which.
function decode(bytes $payload): string
{
    return $payload as string;
}

function tryDecode(bytes $payload): ?string
{
    return $payload as? string;
}

function describe(bytes $payload): string
{
    if ($payload is string) {
        return "text: $payload";
    }

    return 'binary: ' . bin2hex($payload) . ', read as ' . mb_scrub($payload, 'UTF-8');
}

function maybeText(?bytes $payload): bool
{
    return $payload is ?string;
}

function maybeDecode(?bytes $payload): ?string
{
    return $payload as string|null;
}

function decodePresent(?bytes $payload): string
{
    return $payload as string;
}

// `.` joins binary to binary and erases unchanged (strings.md §2).
function frame(bytes $header, list<bytes> $chunks): bytes
{
    $out = (bytes) '';
    foreach ($chunks as $chunk) {
        $out .= $chunk;
    }

    return $header . $out;
}

// Written tags erase as the generated ones do (strings.md §5): with
// `use Phaenon\Bytes;` above, a `bytes` left in a tag would be that class.
final class Archive
{
    /** @var list<bytes> */
    private array $entries = [];

    /**
     * @param list<bytes> $parts the bytes of each entry
     */
    public function addAll(array $parts): void
    {
        foreach ($parts as $part) {
            $this->entries[] = $part;
        }
    }

    /** @return bytes the archive's bytes */
    public function bytes(): bytes
    {
        /** @var bytes $out */
        $out = (bytes) implode('', $this->entries);

        return $out;
    }

    /**
     * @param bytes $entry
     * @return array{bytes: int, data: bytes}
     */
    public function measure(bytes $entry): array
    {
        return ['bytes' => strlen($entry), 'data' => $entry];
    }

    /** @return bytes the first entry, or none */
    public function first(list<bytes> $from): bytes
    {
        return $from[0] ?? (bytes) '';
    }
}
