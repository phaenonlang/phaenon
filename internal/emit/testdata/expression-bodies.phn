namespace App;

use LogicException;

// An expression body compiles to the PSR-12 block it stands for: `=> expr;`
// is `{`, `return expr;` and `}` on lines of their own, without `return`
// under void and never; a body wrapped after the arrow keeps its line as the
// statement's, and a multi-line expression moves in with the block
// (design/functions.md §3, line-map.md §2).

interface Named
{
    name(): string;
}

final class User implements Named, \Stringable {
    private int $calls = 0;

    __construct(private string $name) {}

    name(): string => $this->name;

    log(string $message): void => $this->record($message);

    private record(string $message): void {
        $this->calls += \strlen($message);
    }

    fail(string $why): never => throw new LogicException($why);

    calls(): int => $this->calls;

    static of(string $name): self
        => new self(\trim($name));

    greeting(string $salutation, string $punctuation, bool $shout = false): string
        => $shout ? \strtoupper($salutation . ', ' . $this->name . $punctuation) : $salutation . ', ' . $this->name . $punctuation;

    described(string $prefix, string $suffix): string
        => \sprintf(
            '%s %s %s',
            $prefix,
            $this->name,
            $suffix,
        );

    logged(string $message, string $context): void
        => $this->record($message . ' (' . $context . ')');

    counter(): \Closure => fn (): int => $this->calls;

    #[\Override]
    __toString(): string => $this->name;

    /** @return list<string> the parts of the name */
    parts(): array => \explode(' ', $this->name);

    /** @return array{name: string, calls: int} */
    tags(): array => [
        'name' => $this->name,
        'calls' => $this->calls,
    ];

    &reference(): int => $this->calls;
}

function double(int $x): int => $x * 2;

function untouched(int $x): int
{
    return $x;
}

function plain(): string => 'plain';

/** @return list<int> */
function ids(int ...$ids): array => \array_values($ids);

function show(): void => print User::of(' Ada ')->greeting('Hello', '!') . double(2) . plain() . untouched(1) . \count(ids(1, 2));
