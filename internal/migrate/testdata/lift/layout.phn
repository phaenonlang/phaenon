namespace App;

use Closure;

/** A greeting. */
interface Greets
{
    greet(string $name): string;
}

trait Counts
{
    private int $count = 0;

    count(): int => $this->count;
}

enum Level: int
{
    case Low = 1;

    label(): string => match ($this) {
        self::Low => 'low',
    };
}

final class Greeter implements
    Greets,
    \Countable
{
    use Counts;

    /** The salutation. */
    private string $salutation = 'Hello';

    /**
     * Two lines
     * of prose stay a block.
     */
    private string $punctuation = '!';

    /**
     * A docblock whose only line of content is long enough that collapsing it onto one line would pass the column limit.
     */
    private string $long = '';

    __construct(private readonly string $suffix = '') {}

    greet(string $name): string => $this->salutation . ', ' . $name . $this->punctuation . $this->suffix;

    log(string $message): void => $this->count += \strlen($message);

    fail(string $why): never => throw new \LogicException($why);

    noType() {
        $this->count++;
    }

    twoStatements(): int {
        $this->count++;
        return $this->count;
    }

    commented(): int {
        // the count so far
        return $this->count;
    }

    documented(): int {
        /** @var int $count */
        $count = $this->count;
        return $count;
    }

    inlineVar(): int {
        /** @var int */
        return $this->count;
    }

    tags(): array<mixed> => [
        'salutation' => $this->salutation,
        'punctuation' => $this->punctuation,
    ];

    chained(string $name): string => \trim(
        $this->greet($name),
    );

    longLine(string $firstName, string $lastName, string $title): string
        => $this->greet($title . ' ' . $firstName . ' ' . $lastName) . $this->salutation . $this->punctuation;

    heredoc(string $name): string
        => <<<TEXT
            Dear {$name},
            TEXT;

    generator(): \Generator {
        return yield $this->count;
    }

    &reference(): int => $this->count;

    oneLine(): int => $this->count;

    factory(): Closure => function (string $name): string {
        return $this->greet($name);
    };

    anonymous(): \Countable => new class () implements \Countable {
        public function count(): int => 0;
    };

    braceComment(): int // a comment before the brace
    {
        return $this->count;
    }

    __destruct() {
        $this->log('bye');
    }
}

function helper(int $x): int => $x * 2;

function noBody(): void {}
