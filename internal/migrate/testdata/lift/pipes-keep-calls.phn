// --keep-calls: no chain becomes a pipeline, and none is reported.

function listed(list<int> $xs): string
    => sprintf('[%s]', implode(',', array_map(fn (int $x): string => (string) ($x * 2), $xs)));

function banner(): string => strtoupper(trim(str_repeat(' ab', 2)));

echo listed([1, 2]), "\n";
echo banner(), "\n";
