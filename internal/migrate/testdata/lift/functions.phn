namespace App;

final class Account
{
    const int LIMIT = 10;

    final const string NAME = 'account';

    private const string SECRET = 's';

    private(set) int $balance = 0;

    protected(set) static ?string $owner = null;

    __construct(private(set) string $id, protected string $note = '') {}

    id(): string => $this->id;

    final static open(string $id): self => new self($id);

    protected touch(): void {}

    private static hidden(): void {}

    public
    split(): void {}

    public function static(): string => static::class;

    list(): array<mixed> {
        function inner(): int => 1;

        return [inner()];
    }

    &cached(): array<mixed> {
        static $c = [];

        return $c;
    }
}

function helper(): void {}
