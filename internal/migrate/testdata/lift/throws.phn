namespace App;

use InvalidArgumentException;

final class NotFound extends \RuntimeException {}

interface Store
{
    get(int $id): string throws NotFound;

    /** Removes the entry. */
    remove(int $id): void throws NotFound|\RuntimeException|\LogicException;
}

final class MemoryStore<T of object> implements Store
{
    private map<int, string> $items = [];

    get(int $id): string throws NotFound => $this->items[$id] ?? throw new NotFound((string) $id);

    /** Removes the entry. */
    remove(int $id): void throws NotFound|\RuntimeException|\LogicException {
        unset($this->items[$id]);
    }

    /**
     * Stores a value.
     *
     * @throws InvalidArgumentException when the value is empty
     */
    put(int $id, string $value) throws \LengthException {
        $this->items[$id] = $value;
    }

    /** @throws void */
    count(): int => \count($this->items);

    rethrow(T $item): void throws T {}

    raise<E of \Throwable>(E $e): never throws E => throw $e;

    twice(int $id): string throws NotFound => $this->get($id);

    prefixed(int $id): string throws NotFound => $this->get($id);
}

function load(Store $store, int $id): string throws NotFound => $store->get($id);

function untyped($x) throws \LogicException {
    throw new \LogicException((string) $x);
}
