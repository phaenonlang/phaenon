namespace Tabs;

// Phaenon's whitespace is spaces (design/functions.md §5.5): a tab-indented
// file comes out indented with four spaces per tab stop.
final class Shouter
{
    /**
     * The text,	shouted.
     */
    shout(string $s): string
    {
        return $s
            |> str_repeat(?, 2)
            |> trim(...)
            |> strtoupper(...);
    }

    table(): string
    {
        $cell = "a	b";
        return <<<EOT
            $cell
            	indented	text
            EOT;
    }
}
