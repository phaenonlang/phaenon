namespace Lift\OverrideNearest;

/**
 * A method is held to the declaration in its parent's method table, the
 * nearest one up the parent chain however far it is, and to the
 * interfaces its class implements itself. Leaf::take() overrides
 * Base::take(mixed), not the Takes::take(int) its parent implements, so
 * `@param int $x` over `mixed $x` is lifted: the rule compiles it back to
 * mixed.
 */
class Base<T>
{
    take(T $x): void {}
}

class Mid extends Base<int> {}

interface Takes
{
    take(int $x): void;
}

abstract class Impl extends Mid implements Takes {}

class Leaf extends Impl
{
    take(int $x): void {}
}

final class Name implements \Stringable
{
    __toString(): string => 'name';
}

class Labels<T of \Stringable>
{
    add(T $label): void {}
}

interface Counts
{
    add(int|Name $label): void;
}

/**
 * The parent demands a Stringable and the interface an int or a Name: the
 * rule compiles `@param int|Name` to int|Stringable, the type declared.
 */
final class NameCounts extends Labels<Name> implements Counts
{
    add(int|Name $label): void {}
}

/**
 * A constructor is held to the nearest abstract one, through the concrete
 * constructor that implements it: LoudGreet's compiles to mixed as
 * Greet's does.
 */
abstract class Command<T>
{
    abstract __construct(T $input);
}

class Greet extends Command<string>
{
    __construct(string $input) {}
}

final class LoudGreet extends Greet
{
    __construct(string $input) {
        parent::__construct($input);
    }
}

/**
 * The parent's table holds what the farthest class brought in:
 * Wide::take(mixed), which Narrow::take(int) was checked against. The tag
 * is lifted, compiling back to mixed.
 */
interface Wide<T>
{
    take(T $x): void;
}

interface Narrow
{
    take(int $x): void;
}

abstract class ImplementsWide implements Wide<int> {}

abstract class ImplementsNarrow extends ImplementsWide implements Narrow {}

final class BelowWideAndNarrow extends ImplementsNarrow
{
    take(int $x): void {}
}

/**
 * A trait's abstract method beside an inherited one is checked against it
 * and dropped: the table keeps Base::take(mixed).
 */
trait NeedsTake
{
    abstract take(int $x): void;
}

abstract class MidNeedsTake extends Mid
{
    use NeedsTake;
}

final class BelowNeedsTake extends MidNeedsTake
{
    take(int $x): void {}
}
