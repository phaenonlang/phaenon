namespace App\ListTypes;

use ArrayObject as Bag;

#[\Attribute(\Attribute::TARGET_PROPERTY)]
final class Mapped {}

final class User
{
    fun __construct(public string $name) {}
}

interface Source
{
    fun all(): list<string>;
}

final class Registry implements Source
{
    private list<string> $names = [];

    private map<string, User> $byName = [];

    private map<string, int> $lengths = ['root' => 4];

    private map<int, int> $removed = [];

    private array<mixed> $sorted = [];

    private list<int|string> $pairs = [];

    private array<mixed> $nothing = [];

    private ?list<int> $cache = null;

    private list<Bag<int|string, mixed>> $bags = [];

    #[Mapped]
    private array<mixed> $mapped = [];

    fun add(User $user): void {
        $this->names[] = $user->name;
        $this->byName[$user->name] = $user;
        $this->lengths[$user->name] = strlen($user->name);
        $this->removed[] = 1;
        unset($this->removed[0]);
        $this->sorted[] = 3;
        sort($this->sorted);
        $this->pairs = [1, 'one'];
        $this->cache = [1, 2];
        $this->bags[] = new Bag();
        $this->mapped[] = $user;
    }

    // A final class: its methods are final. This one returns a property
    // the codemod types first.
    fun names(): list<string> => $this->names;

    // The interface's @return stands for this one.
    fun all(): array => $this->names;

    private static fun keys(): list<string> => array_keys(['a' => 1, 'b' => 2]);

    private fun total(list<int> $xs): int => array_sum($xs) + count($this->nothing);

    private fun label(array<mixed> $parts): string => implode(',', $parts);

    // A pair whose positions differ is a tuple.
    private fun entry(User $user): (string, int) => [$user->name, strlen($user->name)];

    // A document of more than three types reads as map<string, mixed>.
    private fun document(): map<string, mixed> => ['id' => 1, 'name' => 'a', 'active' => true, 'score' => 1.5];

    fun report(): string {
        $sum = $this->total([1, 2, 3]) + $this->total([4]);
        $labels = array_map([$this, 'label'], [['a'], ['b']]);

        return $sum . implode(';', $labels) . implode(',', self::keys()) . count($this->byName)
            . count($this->lengths) . count($this->removed) . count($this->pairs) . count($this->cache ?? [])
            . count($this->bags) . count($this->mapped) . $this->entry(new User('a'))[1] . count($this->document());
    }
}
