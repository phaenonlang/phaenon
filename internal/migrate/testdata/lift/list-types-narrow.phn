namespace App\ListTypesNarrow;

final class Settings
{
    private map<string, mixed> $values = [];

    fun set(string $name, mixed $value): void => $this->values[$name] = $value;

    // array_keys() of the property while it is a bare array is a
    // list<int|string>: once the property is typed, a later round narrows
    // it to the list<string> it is.
    fun names(): list<string> => array_keys($this->values);
}

final class Walk
{
    // A recursion spread into array_push(): the mixed of its own bare
    // array is not written, the self round finds list<string>.
    private static fun files(string $dir): list<string> {
        $files = [];
        foreach (scandir($dir) ?: [] as $name) {
            if (is_dir($dir . '/' . $name)) {
                array_push($files, ...self::files($dir . '/' . $name));
            } else {
                $files[] = $name;
            }
        }

        return $files;
    }

    static fun count(string $dir): int => count(self::files($dir));
}

final class Trees
{
    private map<string, map<string, \SplFileInfo>> $trees = [];

    // What the method writes back it read of the property through a
    // local: its own values, which the self round reads.
    fun put(string $sha, string $base, string $path, \SplFileInfo $file): void {
        $files = $this->trees[$base] ?? [];
        $files[$path] = $file;
        ksort($files);
        $this->trees[$sha] = $files;
    }
}

final class Templates
{
    private map<string, (string, string)> $template = [];

    private map<string, list<string>> $words = [];

    fun __construct() {
        $this->template = ['a' => [str_repeat('a', 4), "body\n"], 'b' => ['', '']];
        $this->words = ['a' => ['x', 'y']];
    }

    // The template's pairs are taken apart: (string, string). The words
    // are iterated: a list.
    fun body(string $name): string {
        [$commit, $body] = $this->template[$name];
        foreach ($this->words[$name] as $word) {
            $body .= $word;
        }

        return $commit . $body;
    }
}

final class Routes
{
    // An answer is a map or a list of records, spelled apart; the records
    // in a row are a list, whatever their fields.
    private fun routes(): map<string, (int, map<string, string>|list<map<string, string|true>>)> => [
        'user' => [200, ['login' => 'acme']],
        'repos' => [200, [['name' => 'a'], ['name' => 'b', 'private' => true]]],
        'missing' => [404, []],
    ];

    fun status(string $key): int {
        [$status] = $this->routes()[$key];

        return $status;
    }
}

final class Chain
{
    // $object::class names some class: class.
    private static fun chainOf(object $client): list<class> => [$client::class];

    static fun depth(object $client): int => count(self::chainOf($client));
}
