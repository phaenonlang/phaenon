namespace App;

use App\Model\Row;

/**
 * A cache of reflections, keyed by class name.
 */
final class CachedReflector<ClassType of object, out EnumType of \UnitEnum> implements \Countable, ReflectorInterface<ClassType, EnumType>
{
    private map<class<ClassType>, \ReflectionClass<ClassType>> $cache = [];

    private list<string> $names = [];

    /** @var array<string, int> the hit counts, by name */
    private map<string, int> $hits = [];

    /** @var int|string */
    private $untyped = 0;

    /**
     * @var array{id: int}
     */
    private array $shape = ['id' => 1];

    /**
     * @param $attributeType FQN of an attribute class
     * @param $className FQN of a class we look for attributes in
     */
    public function allOfType<T of object>(class<T> $attributeType, class $className): array<T>
    {
        return [];
    }

    /**
     * Finds the first one.
     *
     * @throws \ReflectionException
     */
    public function first<T of object>(class<T> $attributeType): ?T
    {
        return null;
    }

    /**
     * @return T the mapped object
     */
    public function map<T of object>(object $source, T|class<T> $target): T
    {
        return $source;
    }

    /**
     * @param callable(int): string $g
     * @param int<0, max> $n
     * @param array{id: int} $row
     * @param non-empty-string ...$names
     */
    public function closures(?Closure(object, object): object $mapping, Closure(int): string $f, callable $g, int $n, array $row, string ...$names, ?string $maybe = null): void
    {
    }

    /**
     * @return list<int>
     */
    public function widened(list<int> $xs): iterable
    {
        return $xs;
    }

    public function qualified(\App\Model\Row $row, Row $other): void
    {
    }

    /**
     * @param int $n
     * @return iterable<string>
     */
    public function untypedParts($n)
    {
    }

    public function __construct<ClassType of object>(private ReflectorInterface<ClassType, \UnitEnum> $reflector, string $name = '')
    {
    }

    public function fluent(): static
    {
        return $this;
    }

    /** @phpstan-param positive-int $n */
    public function prefixed(int $n): void
    {
    }

    public function count(): int
    {
        return 0;
    }
}

abstract class Repo<T> extends Base<T>
{
}

function firstOf<T of object>(list<T> $items): ?T
{
    return $items[0] ?? null;
}

/**
 * @param non-empty-array<string, \stdClass> $objects
 * @param \Closure(int, int=): int $withOptional
 */
function keyed(map<int, string> $map, array $objects, \Closure $withOptional): void
{
}
