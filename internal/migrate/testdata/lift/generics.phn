namespace App;

use App\Model\Row;

/** A cache of reflections, keyed by class name. */
final class CachedReflector<ClassType of object, out EnumType of \UnitEnum> implements \Countable, ReflectorInterface<ClassType, EnumType>
{
    private map<class<ClassType>, \ReflectionClass<ClassType>> $cache = [];

    private list<string> $names = [];

    /** the hit counts, by name */
    private map<string, int> $hits = [];

    /** @var int|string */
    private $untyped = 0;

    /** @var array{id: int} */
    private array $shape = ['id' => 1];

    /**
     * @param $attributeType - FQN of an attribute class
     * @param $className - FQN of a class we look for attributes in
     */
    fun allOfType<T of object>(class<T> $attributeType, class $className): array<T> => [];

    /** Finds the first one. */
    fun first<T of object>(class<T> $attributeType): ?T throws \ReflectionException => null;

    /** @return T the mapped object */
    fun map<T of object>(object $source, T|class<T> $target): T => $source;

    /**
     * @param callable(int): string $g
     * @param int<0, max> $n
     * @param array{id: int} $row
     * @param non-empty-string ...$names
     */
    fun closures(?Closure(object, object): object $mapping, Closure(int): string $f, callable $g, int $n, array $row, string ...$names, ?string $maybe = null): void {
    }

    /** @return list<int> */
    fun widened(list<int> $xs): iterable => $xs;

    fun qualified(\App\Model\Row $row, Row $other): void {
    }

    /**
     * @param int $n
     * @return iterable<string>
     */
    fun untypedParts($n) {
    }

    fun __construct<ClassType of object>(private ReflectorInterface<ClassType, \UnitEnum> $reflector, string $name = '') {
    }

    fun fluent(): static => $this;

    /** @phpstan-param positive-int $n */
    fun prefixed(int $n): void {
    }

    fun count(): int => 0;
}

abstract class Repo<T> extends Base<T>
{
}

fun firstOf<T of object>(list<T> $items): ?T => $items[0] ?? null;

/**
 * @param array{name: string, age: int} $named
 * @param array{string} $single
 */
fun tuples((string, int) $pair, list<(string, int)> $pairs, array $named, array $single): (int, string)
    => [$pair[1], $pair[0]];

/** @param non-empty-array<string, \stdClass> $objects */
fun keyed(map<int, string> $map, array $objects, Closure(int, int=): int $withOptional): void {
}

/**
 * A cluster reached over kubectl. PHPStan's `T...` and `T=` markers are
 * Phaenon's too; a parameter's name is dropped; a by-reference parameter
 * keeps its docblock.
 */
final class KubeAccess
{
    private Closure(string...): (int, string) $kubectl;
    private Closure(string, string...): (int, string) $kubectlStdin;
    /** @var \Closure(int &$n): void */
    private \Closure $byRef;

    fun __construct(Closure(string...): (int, string) $kubectl, ?Closure(string, int=): void $log = null) {
        $this->kubectl = $kubectl;
        $this->kubectlStdin = static fn (string $stdin, string ...$args) => [0, $stdin];
        $this->byRef = static function (int &$n): void {
            $n++;
        };
    }
}
