root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab
tab_width = 4

[*.{phn,php}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Golden files are compared byte for byte with generated output and change only by regeneration;
# stdlib/php-src holds upstream copies. Editors must not touch their whitespace.
[{**/testdata/**,stdlib/php-src/**}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
indent_style = unset
indent_size = unset
