namespace Phaenon\Debug;

/**
 * The line map of a file `phn build` compiled (design/line-map.md §3): the
 * comment on its last line that says which line of the .phn source each
 * line of the output came from,
 *
 *     // phaenon-map v1 ../src/Domain/Foo.phn 1-6=1 7:1 15-17=9 18:9
 *
 * a run `O:S` says output line O is source line S and the lines after it
 * follow one for one; a hold `O-P=S` says output lines O to P all stand for
 * source line S (lines the compiler wrote). A map is read once per file and
 * process, and only when a position is asked for: on error paths, never on
 * a request that throws nothing. A file without a valid map — hand-written
 * PHP, or a map of a version this reader does not know — has none, and its
 * positions stay as they are.
 */
final class LineMap
{
    /** A map line starts so, after the `<?php ` of a file that ends in inline HTML (§3.1). */
    private const PREFIX = '// phaenon-map ';

    private const VERSION = 'v1';

    /** The emitter's marker on a compiled file's first lines (emit.Marker). */
    private const MARKER = '@generated by phaenon';

    /** How much of a file's end is read first; a longer last line is read in doubling steps. */
    private const TAIL = 4096;

    /** A last line longer than this is not a map: no compiled file needs one. */
    private const MAX_LINE = 1048576;

    /** The maps read in this process, by compiled file; null for a file without one. */
    private static map<string, ?LineMap> $read = [];

    /**
     * $outputs holds each entry's first output line, ascending; $holdEnds a
     * hold's last output line, 0 for a run; $sources the source line.
     */
    private fun __construct(
        private readonly string $compiledFile,
        private readonly string $sourcePath,
        private readonly string $sourceFile,
        private readonly list<int> $outputs,
        private readonly list<int> $holdEnds,
        private readonly list<int> $sources,
    ) {
    }

    /**
     * The map of a compiled file, read from its last line (or from the line
     * before its `__halt_compiler()`) on first use and kept for the rest of
     * the process; null when the file has no valid map or cannot be read.
     */
    static fun forFile(string $compiledFile): ?LineMap
    {
        if (!array_key_exists($compiledFile, self::$read)) {
            self::$read[$compiledFile] = self::read($compiledFile);
        }

        return self::$read[$compiledFile];
    }

    /**
     * The source position of a line of a compiled file — the .phn path,
     * resolved against the compiled file's directory, and the line — or null
     * when the file has no map.
     */
    static fun locate(string $compiledFile, int $line): ?(string, int)
    {
        $map = self::forFile($compiledFile);

        return $map === null ? null : [$map->sourceFile, $map->sourceLine($line)];
    }

    /**
     * Parses a map line, `// phaenon-map v1 …` or `<?php // phaenon-map v1
     * …`, of the file at $compiledFile, which the source path is resolved
     * against. Null for anything else: a malformed map, a version this reader
     * does not know.
     */
    static fun parse(string $line, string $compiledFile): ?LineMap
    {
        if (str_starts_with($line, '<?php ')) {
            $line = substr($line, 6);
        }
        $tokens = explode(' ', $line);
        if (count($tokens) < 5 || $tokens[0] !== '//' || $tokens[1] !== 'phaenon-map' || $tokens[2] !== self::VERSION) {
            return null;
        }
        $sourcePath = self::decodePath($tokens[3]);
        if ($sourcePath === null) {
            return null;
        }
        $outputs = [];
        $holdEnds = [];
        $sources = [];
        // The first entry starts at line 1, the entry after a hold right
        // after it, the entry after a run anywhere below the run's start.
        $next = 1;
        $exact = true;
        foreach (array_slice($tokens, 4) as $token) {
            if (preg_match('/^([1-9][0-9]{0,17})(?:-([1-9][0-9]{0,17})=|:)([1-9][0-9]{0,17})$/', $token, $m) !== 1) {
                return null;
            }
            $output = (int) $m[1];
            $holdEnd = $m[2] === '' ? 0 : (int) $m[2];
            if ($exact ? $output !== $next : $output < $next) {
                return null;
            }
            if ($holdEnd !== 0 && $holdEnd < $output) {
                return null;
            }
            $outputs[] = $output;
            $holdEnds[] = $holdEnd;
            $sources[] = (int) $m[3];
            $exact = $holdEnd !== 0;
            $next = $exact ? $holdEnd + 1 : $output + 1;
        }

        return new self($compiledFile, $sourcePath, self::resolve($compiledFile, $sourcePath), $outputs, $holdEnds, $sources);
    }

    /** The compiled file this map belongs to, as it was given. */
    fun compiledFile(): string => $this->compiledFile;

    /** The source path as the map writes it: relative to the compiled file's directory, decoded. */
    fun sourcePath(): string => $this->sourcePath;

    /**
     * The source path resolved against the compiled file's directory,
     * lexically: the file system is never asked, so the path holds in a
     * container whose root differs from the build machine's, whether the
     * .phn is deployed or not.
     */
    fun sourceFile(): string => $this->sourceFile;

    /**
     * The forward lookup (§3.2): the source line a line of the compiled file
     * stands for. The entry with the largest first line not above $line
     * decides; a run adds the distance, a hold does not. A line below 1 is
     * in no file and comes back as it is.
     */
    fun sourceLine(int $compiledLine): int
    {
        if ($compiledLine < 1) {
            return $compiledLine;
        }
        $low = 0;
        $high = count($this->outputs) - 1;
        while ($low < $high) {
            $mid = intdiv($low + $high + 1, 2);
            if ($this->outputs[$mid] <= $compiledLine) {
                $low = $mid;
            } else {
                $high = $mid - 1;
            }
        }

        return $this->holdEnds[$low] === 0 ? $this->sources[$low] + ($compiledLine - $this->outputs[$low]) : $this->sources[$low];
    }

    /**
     * The reverse lookup (§3.2): the first compiled line of a run that
     * covers the source line, so that a breakpoint never lands on a line the
     * compiler wrote. A source line no run covers takes the next source line
     * that has a target; null when none has.
     */
    fun compiledLine(int $sourceLine): ?int
    {
        $count = count($this->outputs);
        $target = null;
        $covered = PHP_INT_MAX;
        for ($i = 0; $i < $count; ++$i) {
            if ($this->holdEnds[$i] !== 0) {
                continue;
            }
            $first = $this->sources[$i];
            $last = $i + 1 < $count ? $first + ($this->outputs[$i + 1] - $this->outputs[$i]) - 1 : PHP_INT_MAX;
            $line = max($first, $sourceLine);
            if ($line <= $last && $line < $covered) {
                $covered = $line;
                $target = $this->outputs[$i] + ($line - $first);
            }
        }

        return $target;
    }

    /**
     * A closure's name as PHP 8.4 and later write it, for a closure declared
     * in this map's compiled file — `{closure:/app/.src/Foo.php:12}` at the
     * top level, `{closure:App\Foo::bar():12}` in a function, after `Class::`
     * in a frame that names the class, nested as `{closure:{closure:…:3}:5}`
     * — with its lines translated, and the compiled path, where the name
     * holds it as $compiledShown, replaced by $sourceShown. Other names come
     * back as they are.
     */
    fun closureName(string $function, string $compiledShown, string $sourceShown): string
    {
        if (!str_contains($function, '{closure:')) {
            return $function;
        }
        $name = str_replace('{closure:' . $compiledShown . ':', '{closure:' . $sourceShown . ':', $function);

        return preg_replace_callback('/:([1-9][0-9]{0,17})\}/', fn (array $m): string => ':' . $this->sourceLine((int) $m[1]) . '}', $name) ?? $name;
    }

    // ---------------------------------------------------------------- reading

    private static fun read(string $file): ?LineMap
    {
        if (str_contains($file, "\0")) {
            return null; // no file has such a name, and the file functions would throw
        }
        $size = @filesize($file);
        if ($size === false || !@is_file($file)) {
            return null;
        }
        $last = self::lastLine($file, $size);
        if ($last !== null && self::isMapLine($last)) {
            return self::parse($last, $file);
        }
        // A file that uses __halt_compiler() ends in its data and carries
        // the map on the line before the statement (§3.1). Only a compiled
        // file can, so a hand-written one costs its first bytes, not a
        // full read.
        $head = @file_get_contents($file, false, null, 0, 512);
        if ($head === false || !str_contains($head, self::MARKER)) {
            return null;
        }
        $line = self::lineBeforeHaltCompiler($file);

        return $line === null ? null : self::parse($line, $file);
    }

    /** The file's last line without its line break; null when unreadable or too long to be a map. */
    private static fun lastLine(string $file, int $size): ?string
    {
        $length = self::TAIL;
        while (true) {
            $start = max(0, $size - $length);
            $tail = @file_get_contents($file, false, null, $start);
            if ($tail === false) {
                return null;
            }
            if (str_ends_with($tail, "\n")) {
                $tail = substr($tail, 0, -1);
            }
            if (str_ends_with($tail, "\r")) {
                $tail = substr($tail, 0, -1);
            }
            $break = strrpos($tail, "\n");
            if ($break !== false) {
                return substr($tail, $break + 1);
            }
            if ($start === 0) {
                return $tail;
            }
            if ($length >= self::MAX_LINE) {
                return null;
            }
            $length *= 2;
        }
    }

    /** The first map line found right before a line holding `__halt_compiler` (any case, as PHP reads it). */
    private static fun lineBeforeHaltCompiler(string $file): ?string
    {
        $code = @file_get_contents($file);
        if ($code === false) {
            return null;
        }
        $offset = 0;
        while (($at = stripos($code, '__halt_compiler', $offset)) !== false) {
            $lineStart = strrpos(substr($code, 0, $at), "\n");
            if ($lineStart !== false) {
                $before = substr($code, 0, $lineStart);
                $previousBreak = strrpos($before, "\n");
                $line = rtrim($previousBreak === false ? $before : substr($before, $previousBreak + 1), "\r");
                if (self::isMapLine($line)) {
                    return $line;
                }
            }
            $offset = $at + 1;
        }

        return null;
    }

    private static fun isMapLine(string $line): bool
    {
        return str_starts_with($line, self::PREFIX) || str_starts_with($line, '<?php ' . self::PREFIX);
    }

    /** `%20` and `%25` are a space and a percent sign; any other `%` makes the map malformed. */
    private static fun decodePath(string $encoded): ?string
    {
        if (preg_match('/%(?!20|25)/', $encoded) !== 0) {
            return null;
        }

        return strtr($encoded, ['%20' => ' ', '%25' => '%']);
    }

    /**
     * $path joined to the directory of $compiledFile with `.` and `..`
     * folded, lexically and the same on every system. The root — `/`, a
     * drive (`C:/`), a stream wrapper (`phar://`) — stays; a `..` above it
     * stays at it.
     */
    private static fun resolve(string $compiledFile, string $path): string
    {
        if (preg_match('~^[A-Za-z]:\\\\~', $compiledFile) === 1) {
            $compiledFile = str_replace('\\', '/', $compiledFile); // a Windows path: the map's separator is /
        }
        $slash = strrpos($compiledFile, '/');
        $directory = $slash === false ? '.' : substr($compiledFile, 0, $slash);
        $joined = str_starts_with($path, '/') ? $path : $directory . '/' . $path;
        $root = '';
        if (preg_match('~^(?:[A-Za-z][A-Za-z0-9+.-]+://|[A-Za-z]:/|/)~', $joined, $m) === 1) {
            $root = $m[0];
            $joined = substr($joined, strlen($root));
            if (str_ends_with($root, '://') && str_starts_with($joined, '/')) {
                $root .= '/';
            }
        }
        $segments = [];
        foreach (explode('/', $joined) as $segment) {
            if ($segment === '' || $segment === '.') {
                continue;
            }
            if ($segment !== '..') {
                $segments[] = $segment;
            } elseif ($segments !== [] && $segments[count($segments) - 1] !== '..') {
                array_pop($segments);
            } elseif ($root === '') {
                $segments[] = '..';
            }
        }

        return $root . implode('/', $segments);
    }
}
