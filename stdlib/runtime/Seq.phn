namespace Phaenon;

use Closure;

/**
 * The list functions of the Phaenon stdlib (design/collections.md §3). A
 * `list<T>` is a PHP array with keys 0..n-1; every function here takes the
 * list first and returns a new array, PHP's value semantics throughout. In
 * Phaenon source these are the methods of a list: `$xs->map($f)` compiles
 * to `Seq::map($xs, $f)`.
 */
final class Seq
{
    private fun __construct()
    {
    }

    static fun map<T, U>(list<T> $xs, Closure(T): U $f): list<U>
    {
        return array_map($f, $xs);
    }

    static fun filter<T>(list<T> $xs, Closure(T): bool $keep): list<T>
    {
        return array_values(array_filter($xs, $keep));
    }

    static fun reduce<T, A>(list<T> $xs, A $initial, Closure(A, T): A $f): A
    {
        $acc = $initial;
        foreach ($xs as $x) {
            $acc = $f($acc, $x);
        }

        return $acc;
    }

    static fun each<T>(list<T> $xs, Closure(T): void $f): void
    {
        foreach ($xs as $x) {
            $f($x);
        }
    }

    static fun first<T>(list<T> $xs): ?T
    {
        return [] === $xs ? null : $xs[0];
    }

    static fun last<T>(list<T> $xs): ?T
    {
        return [] === $xs ? null : $xs[count($xs) - 1];
    }

    static fun contains<T>(list<T> $xs, T $needle): bool
    {
        return in_array($needle, $xs, true);
    }

    static fun indexOf<T>(list<T> $xs, T $needle): ?int
    {
        $i = array_search($needle, $xs, true);

        return is_int($i) ? $i : null;
    }

    static fun slice<T>(list<T> $xs, int $offset, ?int $length = null): list<T>
    {
        return array_slice($xs, $offset, $length);
    }

    static fun concat<T>(list<T> ...$lists): list<T>
    {
        return self::flatten(array_values($lists));
    }

    static fun reverse<T>(list<T> $xs): list<T>
    {
        return array_reverse($xs);
    }

    static fun sort<T>(list<T> $xs, ?Closure(T, T): int $cmp = null): list<T>
    {
        if (null === $cmp) {
            sort($xs);
        } else {
            usort($xs, $cmp);
        }

        return $xs;
    }

    static fun sortBy<T, K of int|string>(list<T> $xs, Closure(T): K $key): list<T>
    {
        usort($xs, fn ($a, $b): int => $key($a) <=> $key($b));

        return $xs;
    }

    static fun unique<T of int|string>(list<T> $xs): list<T>
    {
        // Strict: 1 and '1' are two values (array_unique() and array keys
        // would merge them). The first occurrence keeps its place.
        $seen = [];
        $out = [];
        foreach ($xs as $x) {
            $key = (is_int($x) ? 'i' : 's') . $x;
            if (isset($seen[$key])) {
                continue;
            }
            $seen[$key] = true;
            $out[] = $x;
        }

        return $out;
    }

    static fun flatten<T>(list<list<T>> $xs): list<T>
    {
        $out = [];
        foreach ($xs as $inner) {
            foreach ($inner as $x) {
                $out[] = $x;
            }
        }

        return $out;
    }

    /**
     * @throws \ValueError when $size is not positive
     */
    static fun chunk<T>(list<T> $xs, int $size): list<list<T>>
    {
        if ($size < 1) {
            throw new \ValueError('Seq::chunk(): the size must be at least 1');
        }

        return array_chunk($xs, $size);
    }

    static fun zip<A, B>(list<A> $as, list<B> $bs): list<(A, B)>
    {
        $out = [];
        $n = min(count($as), count($bs));
        for ($i = 0; $i < $n; ++$i) {
            $out[] = [$as[$i], $bs[$i]];
        }

        return $out;
    }

    static fun keyBy<T, K of int|string>(list<T> $xs, Closure(T): K $key): map<K, T>
    {
        $out = [];
        foreach ($xs as $x) {
            $out[$key($x)] = $x;
        }

        return $out;
    }

    static fun groupBy<T, K of int|string>(list<T> $xs, Closure(T): K $key): map<K, list<T>>
    {
        $out = [];
        foreach ($xs as $x) {
            $out[$key($x)][] = $x;
        }

        return $out;
    }

    static fun join(list<string|\Stringable> $xs, string $separator): string
    {
        return implode($separator, $xs);
    }

    static fun isEmpty(list<mixed> $xs): bool
    {
        return [] === $xs;
    }

    static fun count(list<mixed> $xs): int
    {
        return count($xs);
    }
}
