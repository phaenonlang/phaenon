namespace Phaenon;

use Closure;

/**
 * The map functions of the Phaenon stdlib (design/collections.md §3). A
 * `map<K, V>` is a PHP array keyed by int|string; every function here takes
 * the map first and returns a new array. In Phaenon source these are the
 * methods of a map: `$m->keys()` compiles to `Map::keys($m)`.
 */
final class Map
{
    private function __construct()
    {
    }

    public static function get<K of int|string, V>(map<K, V> $m, K $key): ?V
    {
        return $m[$key] ?? null;
    }

    public static function has<K of int|string>(map<K, mixed> $m, K $key): bool
    {
        return array_key_exists($key, $m);
    }

    public static function keys<K of int|string>(map<K, mixed> $m): list<K>
    {
        return array_keys($m);
    }

    public static function values<V>(map<int|string, V> $m): list<V>
    {
        return array_values($m);
    }

    public static function map<K of int|string, V, U>(map<K, V> $m, Closure(V, K): U $f): map<K, U>
    {
        $out = [];
        foreach ($m as $k => $v) {
            $out[$k] = $f($v, $k);
        }

        return $out;
    }

    public static function filter<K of int|string, V>(map<K, V> $m, Closure(V, K): bool $keep): map<K, V>
    {
        $out = [];
        foreach ($m as $k => $v) {
            if ($keep($v, $k)) {
                $out[$k] = $v;
            }
        }

        return $out;
    }

    public static function each<K of int|string, V>(map<K, V> $m, Closure(V, K): void $f): void
    {
        foreach ($m as $k => $v) {
            $f($v, $k);
        }
    }

    /**
     * Later maps win, key by key, as array_replace() does; integer keys keep their value.
     */
    public static function merge<K of int|string, V>(map<K, V> ...$maps): map<K, V>
    {
        $out = [];
        foreach ($maps as $m) {
            foreach ($m as $k => $v) {
                $out[$k] = $v;
            }
        }

        return $out;
    }

    public static function with<K of int|string, V>(map<K, V> $m, K $key, V $value): map<K, V>
    {
        $m[$key] = $value;

        return $m;
    }

    public static function without<K of int|string, V>(map<K, V> $m, K ...$keys): map<K, V>
    {
        foreach ($keys as $key) {
            unset($m[$key]);
        }

        return $m;
    }

    public static function toList<K of int|string, V>(map<K, V> $m): list<(K, V)>
    {
        $out = [];
        foreach ($m as $k => $v) {
            $out[] = [$k, $v];
        }

        return $out;
    }

    public static function fromList<K of int|string, V>(list<(K, V)> $pairs): map<K, V>
    {
        $out = [];
        foreach ($pairs as [$k, $v]) {
            $out[$k] = $v;
        }

        return $out;
    }

    public static function isEmpty(map<int|string, mixed> $m): bool
    {
        return [] === $m;
    }

    public static function count(map<int|string, mixed> $m): int
    {
        return count($m);
    }
}
