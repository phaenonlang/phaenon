{
  "mcpServers": {
    "serena": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "exec \"${SERENA_BIN:-$HOME/.local/bin/serena}\" start-mcp-server --context claude-code --project-from-cwd --language-backend \"${SERENA_LANGUAGE_BACKEND:-JetBrains}\""
      ]
    }
  }
}
