# Serena per-machine state (the two lines Serena writes itself when this file is missing)
/cache
/project.local.yml

# memories/ is committed: it is the project's Obsidian vault.
# Obsidian keeps shared settings in memories/.obsidian/ (committed); per-session state is not.
/memories/.obsidian/workspace.json
/memories/.obsidian/workspace-mobile.json
/memories/.obsidian/cache
/memories/.obsidian/plugins/*/data.json
/memories/.trash/
